# Local development only. Copy to .env (which git ignores) if you would rather
# keep the key in the project than in your machine's environment variables.
#
# The editor reads this ONLY while running `npm run dev`, to prefill the
# assistant. It is never read during `npm run build`, never bundled, and never
# deployed — `npm run check` scans dist/ and fails if any credential appears
# there. Do not put this key in GitHub Secrets for the site: the editor runs in
# the browser, so a build-time secret would be published to every visitor.

OPENAI_KEY=sk-your-key-here
