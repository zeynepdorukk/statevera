# The publication's one small API. Copy this to .env (which git ignores) for
# local work; the dev server reads it at request time and never bundles it.
#
# In production these are Cloudflare Worker secrets:
#   npx wrangler secret put GOVINFO_API_KEY
#
# The desk needs nothing here. Its GitHub token and assistant key belong to the
# writer and live in her browser.

# Optional official-source API keys. Each adapter falls back to a public key,
# so search works without them — just with tighter rate limits.
GOVINFO_API_KEY=
CONGRESS_API_KEY=
OSCE_SEARCH_API_KEY=

# Where the deployed Worker answers. Left empty, primary-source search and read
# counts say they are not configured instead of calling a host that is not there.
# Set the same value as a repository variable so the Pages build picks it up.
PUBLIC_DESK_URL=
