# The desk's server half. Copy this to .env (which git ignores) for local work.
#
# In production these are set in the Cloudflare Pages dashboard as encrypted
# variables. Nothing here is ever bundled or deployed with the site: the browser
# only ever talks to /api, which is the sole holder of these values.
# `npm run check` scans dist/ and fails the build if any credential appears there.

# Who signs in at /editor.
EDITOR_USER=zeynepdoruk

# The password she types. Choose a long one.
EDITOR_PASSWORD=

# Any long random string; it signs the session cookie. Changing it signs everyone out.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Optional. Without it the desk still works, but the assistant is switched off.
OPENAI_KEY=

# Fine-grained token with Contents: Read and Write on the repository below.
GITHUB_TOKEN=
GITHUB_REPO=zeynepdorukk/statevera

# Optional official-source API keys. They are read only by the server function;
# the GitHub Pages frontend receives normalized results, never these values.
GOVINFO_API_KEY=
CONGRESS_API_KEY=
OSCE_SEARCH_API_KEY=

