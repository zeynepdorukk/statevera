---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories, newsSections, type CategorySlug } from "../../site";
import { getByCategory, getByType, getAllBriefings, heroImageOf, formatDate, formatTime, readingTime, root } from "../../utils/collection";
import StoryCard from "../../components/StoryCard.astro";
import HeadlineItem from "../../components/HeadlineItem.astro";

export async function getStaticPaths() {
  return newsSections.map((slug) => ({ params: { section: slug } }));
}

const { section } = Astro.params;
const meta = categories[section as CategorySlug];
if (!meta || !newsSections.includes(section as (typeof newsSections)[number])) {
  return Astro.redirect(root("/404"));
}

let lead: Awaited<ReturnType<typeof getByCategory>>[0] | undefined;
let items: Awaited<ReturnType<typeof getByCategory>> = [];
let briefings: Awaited<ReturnType<typeof getAllBriefings>> = [];

if (section === "opinion") {
  const [byType, byCat, b] = await Promise.all([
    getByType("opinion"),
    getByCategory("Opinion"),
    getAllBriefings(),
  ]);
  const merged = [...byType, ...byCat.filter((a) => !byType.some((t) => t.id === a.id))];
  lead = merged[0];
  items = merged;
  briefings = b;
} else {
  const [articles, b] = await Promise.all([
    getByCategory(meta.name),
    getAllBriefings(),
  ]);
  lead = articles[0];
  items = articles;
  briefings = b;
}

const displayItems = items.slice(1, 19);
const briefingsShown = briefings.filter((b) => b.data.category === meta.name).slice(0, 4);
const leadHref = lead ? root(`/articles/${lead.id.replace(/\.mdx?$/, "")}`) : "";
---

<BaseLayout
  title={meta.name}
  description={meta.description}
  path={meta.url}
>
  <div class="mx-auto max-w-[1400px] px-4 pt-8 md:px-8 md:pt-10">
    <!-- Section header -->
    <header class="border-b-2 border-ink pb-5">
      <h1 class="t-headline-lg">{meta.name}</h1>
      <p class="mt-1 font-sans text-[0.72rem] font-semibold tracking-[0.18em] uppercase text-accent">
        {meta.tagline}
      </p>
      <p class="mt-3 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-ink-soft">
        {meta.description}
      </p>
    </header>

    <div class="grid gap-10 py-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12">
      <div class="min-w-0 space-y-10">
        {lead ? (
          <>
            <article class="group">
              <a href={leadHref} class="img-zoom block overflow-hidden border border-line/60 bg-paper-soft" tabindex="-1" aria-hidden="true">
                <img src={heroImageOf(lead.data.heroImage)} alt="" width="1600" height="1000" loading="eager" class="aspect-[16/9] w-full object-cover" />
              </a>
              <p class="kicker mt-4">{lead.data.category} · {lead.data.region}</p>
              <h2 class="t-headline mt-2">
                <a href={leadHref} class="editorial-link">{lead.data.title}</a>
              </h2>
              <p class="mt-2.5 max-w-2xl font-serif text-[1.02rem] leading-relaxed text-muted">
                {lead.data.description}
              </p>
              <p class="meta mt-3">
                By <span class="meta-strong">{lead.data.author}</span> · {formatDate(lead.data.date)} · {readingTime(lead)} min read
              </p>
            </article>
          </>
        ) : (
          <p class="border border-line bg-paper-soft p-6 font-serif text-[1rem] text-muted">
            No articles in this section yet. The first piece is on the editor's desk — check back soon.
          </p>
        )}

        {displayItems.length > 0 && (
          <div>
            <div class="section-head">
              <h2 class="title">Latest</h2>
              <span class="rule" aria-hidden="true"></span>
            </div>
            <div class="divide-y divide-line border-t border-line">
              {displayItems.map((item) => (
                <HeadlineItem article={item} />
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
        <div>
          <div class="section-head">
            <h2 class="title">Briefings</h2>
            <span class="rule" aria-hidden="true"></span>
          </div>
          <ul class="border-t border-line">
            {briefingsShown.map((b) => (
              <li class="border-b border-line py-3">
                <p class="flex items-baseline gap-2">
                  <time class="font-sans text-[0.7rem] font-semibold text-accent" datetime={b.data.timestamp.toISOString()}>
                    {formatTime(b.data.timestamp)}
                  </time>
                  <span class="meta-strong">{b.data.location}</span>
                </p>
                <p class="mt-1 font-serif text-[0.92rem] leading-snug text-ink-soft">{b.body.trim()}</p>
              </li>
            ))}
            {briefingsShown.length === 0 && (
              <li class="border-b border-line py-3 font-serif text-[0.92rem] text-muted">No briefings in this section yet.</li>
            )}
          </ul>
          <p class="mt-3"><a href={root("/briefings")} class="kicker-ink transition-colors duration-200 hover:text-accent">All briefings →</a></p>
        </div>

        <div>
          <div class="section-head">
            <h2 class="title">More news</h2>
            <span class="rule" aria-hidden="true"></span>
          </div>
          <ul class="space-y-2">
            {newsSections.filter((k) => k !== section).map((k) => (
              <li>
                <a href={root(categories[k].url)} class="editorial-link font-sans text-[0.85rem] font-medium text-ink-soft">
                  {categories[k].name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
