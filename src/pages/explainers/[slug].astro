---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";
import {
  getAllExplainers,
  getExplainerBySlug,
  explainerHref,
  formatDate,
  heroImageOf,
  readingTime,
  root,
  slugOf,
} from "../../utils/collection";
import { creditFor } from "../../data/imageCredits";
import ArticleSources from "../../components/article/ArticleSources.astro";
import ArticleShare from "../../components/article/ArticleShare.astro";
import JournalCard from "../../components/JournalCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import KeyTakeaways from "../../components/mdx/KeyTakeaways.astro";
import WhyItMatters from "../../components/mdx/WhyItMatters.astro";
import TheBigPicture from "../../components/mdx/TheBigPicture.astro";
import AnalysisSection from "../../components/mdx/AnalysisSection.astro";

export async function getStaticPaths() {
  const explainers = await getAllExplainers();
  return explainers.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const explainer = entry ?? (await getExplainerBySlug(Astro.params.slug ?? ""));
if (!explainer) return Astro.redirect(root("/404"));

const { Content } = await render(explainer);
const { data } = explainer;
const href = explainerHref(explainer);
const canonical = new URL(href, site.siteUrl).toString();
const minutes = readingTime(explainer);
const credit = creditFor(data.heroImage);
const others = (await getAllExplainers()).filter((e) => e.id !== explainer.id).slice(0, 3);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    ...(data.updated ? { dateModified: data.updated.toISOString() } : {}),
    author: { "@type": "Person", name: site.authorName },
    publisher: {
      "@type": "Organization",
      name: site.publicationName,
      logo: {
        "@type": "ImageObject",
        url: new URL(root("/images/branding/logo-512.png"), site.siteUrl).toString(),
      },
    },
    image: [new URL(heroImageOf(data.heroImage), site.siteUrl).toString()],
    articleSection: "Explainers",
    isAccessibleForFree: true,
    mainEntityOfPage: canonical,
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={heroImageOf(data.heroImage)}
  type="article"
  tone="journal"
  path={href}
  noindex={data.draft}
  jsonLd={jsonLd}
>
  <article class="shell max-w-[900px] pt-8 md:pt-12" data-tone="journal">
    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class="flex items-center gap-2 font-sans text-[0.68rem] font-bold tracking-[0.12em] uppercase">
        <li><a href={root("/journal")} class="text-muted transition-colors hover:text-tone">The Journal</a></li>
        <li aria-hidden="true" class="text-line-strong">/</li>
        <li><a href={root("/explainers")} class="text-tone">Explainers</a></li>
      </ol>
    </nav>

    {data.draft && (
      <p class="mb-4 inline-flex items-center gap-2 border border-line-strong bg-paper-soft px-2.5 py-1 font-sans text-[0.64rem] font-bold tracking-[0.14em] uppercase text-muted">
        Draft — not published
      </p>
    )}

    <h1 class="t-display">{data.title}</h1>
    <p class="mt-4 max-w-[46rem] font-serif text-[1.22rem] leading-relaxed text-ink-soft">
      {data.description}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-line py-3.5">
      <p class="font-sans text-[0.8rem] font-semibold text-ink">By {site.authorName}</p>
      <time class="meta" datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      {data.updated && <span class="meta">Updated {formatDate(data.updated)}</span>}
      <span class="meta">{minutes} min read</span>
      <span class="kicker ml-auto">Reference</span>
    </div>

    <figure class="mt-7">
      <img
        src={heroImageOf(data.heroImage)}
        alt={data.heroImageAlt}
        width="1600"
        height="1000"
        fetchpriority="high"
        decoding="async"
        class="img-frame border border-line/70"
      />
      {(credit || data.imageCredit) && (
        <figcaption class="mt-1.5 border-b border-line pb-2.5 font-sans text-[0.73rem] text-muted">
          {credit ? `${credit.label}. ${credit.credit}, ${credit.license}.` : data.imageCredit}
        </figcaption>
      )}
    </figure>

    <div class="article-body mt-8">
      <Content components={{ KeyTakeaways, WhyItMatters, TheBigPicture, AnalysisSection }} />
    </div>

    <ArticleSources sources={data.sources} />

    {data.tags.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="kicker-ink">Filed under</span>
        {data.tags.map((tag) => (
          <span class="border border-line px-2 py-0.5 font-sans text-[0.72rem] text-ink-soft">{tag}</span>
        ))}
      </div>
    )}

    <div class="mt-6 no-print">
      <ArticleShare title={data.title} url={canonical} layout="row" />
    </div>

    {others.length > 0 && (
      <section class="mt-12 pb-6" aria-label="More explainers">
        <SectionHead title="More explainers" tone="journal" href="/explainers" moreLabel="All" />
        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-3">
          {others.map((other) => (
            <JournalCard item={{ kind: "explainer", entry: other }} variant="text" />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
