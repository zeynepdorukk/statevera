---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";
import { getExplainerBySlug, heroImageOf, readingTime, getAllExplainers } from "../../utils/collection";
import { creditFor } from "../../data/imageCredits";
import KeyTakeaways from "../../components/mdx/KeyTakeaways.astro";
import WhyItMatters from "../../components/mdx/WhyItMatters.astro";
import TheBigPicture from "../../components/mdx/TheBigPicture.astro";
import AnalysisSection from "../../components/mdx/AnalysisSection.astro";
import { formatDate } from "../../utils/collection";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const explainers = await getCollection("explainers");
  return explainers.map((e) => ({
    params: { slug: e.id.replace(/\.mdx?$/, "") },
  }));
}

const { slug } = Astro.params;
const explainer = await getExplainerBySlug(slug ?? "");
if (!explainer) return Astro.redirect("/404");

const { Content } = await render(explainer);

const { data } = explainer;
const rt = readingTime(explainer);
const href = `/explainers/${explainer.id.replace(/\.mdx?$/, "")}`;
const credit = creditFor(data.heroImage);
const all = await getAllExplainers();
const others = all.filter((e) => e.id !== explainer.id).slice(0, 3);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    ...(data.updated ? { dateModified: data.updated.toISOString() } : {}),
    author: { "@type": "Person", name: "The Dispatch Desk" },
    publisher: {
      "@type": "Organization",
      name: site.publicationName,
      logo: { "@type": "ImageObject", url: new URL("/images/branding/favicon-64.png", site.siteUrl).toString() },
    },
    image: [new URL(heroImageOf(data.heroImage), site.siteUrl).toString()],
    articleSection: "Explainers",
    mainEntityOfPage: new URL(href, site.siteUrl).toString(),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={heroImageOf(data.heroImage)}
  type="article"
  path={href}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[880px] px-4 pt-8 md:px-8 md:pt-12">
    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class="flex items-center gap-2 font-sans text-[0.72rem] font-semibold tracking-[0.1em] uppercase">
        <li><a href="/explainers" class="kicker transition-colors duration-200 hover:text-ink">Explainers</a></li>
        <li aria-hidden="true" class="text-muted">/</li>
        <li class="kicker-ink">Reference</li>
      </ol>
    </nav>

    <h1 class="t-display">{data.title}</h1>
    <p class="mt-4 max-w-[46rem] font-serif text-[1.2rem] leading-relaxed text-ink-soft">
      {data.description}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-line py-3.5">
      <p class="font-sans text-[0.8rem] font-semibold text-ink">The Dispatch Reference Desk</p>
      <time class="meta" datetime={data.date.toISOString()}>
        Published {formatDate(data.date)}
      </time>
      <span class="meta">{rt} min read</span>
      {data.sample && (
        <span class="ml-auto inline-flex items-center gap-1.5 border border-line-strong px-2 py-1 font-sans text-[0.62rem] font-bold tracking-[0.14em] uppercase text-muted">
          Demo content
        </span>
      )}
    </div>

    <figure class="mt-7">
      <img
        src={heroImageOf(data.heroImage)}
        alt={data.heroImageAlt}
        width="1600"
        height="1000"
        fetchpriority="high"
        class="w-full border border-line/60 object-cover"
      />
      {credit && (
        <figcaption class="mt-1.5 border-b border-line pb-2.5 font-sans text-[0.72rem] text-muted">
          {credit.label}. {credit.credit}, {credit.license}.
        </figcaption>
      )}
    </figure>

    <div class="article-body mt-8 pb-10">
      <Content
        components={{
          KeyTakeaways,
          WhyItMatters,
          TheBigPicture,
          AnalysisSection,
        }}
      />
    </div>

    {data.sources.length > 0 && (
      <aside class="border-t border-line-strong pb-10 pt-5" aria-label="Sources">
        <p class="kicker-ink mb-3">Sources &amp; Attribution</p>
        <ul class="columns-1 gap-8 sm:columns-2">
          {data.sources.map((s) => (
            <li class="mb-2 break-inside-avoid">
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="link-accent">
                {s.name} <span aria-hidden="true">↗</span>
              </a>
              <span class="sr-only">(opens an external site)</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <aside class="border-t border-line-strong pb-16 pt-6" aria-label="More explainers">
      <div class="section-head">
        <h2 class="title">More Explainers</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <ul class="grid gap-x-8 gap-y-5 md:grid-cols-3">
        {others.map((e) => (
          <li>
            <p class="kicker">Reference</p>
            <h2 class="t-headline-xs mt-1">
              <a href={`/explainers/${e.id.replace(/\.mdx?$/, "")}`} class="editorial-link">
                {e.data.title}
              </a>
            </h2>
            <p class="meta mt-1.5">{readingTime(e)} min read</p>
          </li>
        ))}
      </ul>
    </aside>
  </article>
</BaseLayout>
