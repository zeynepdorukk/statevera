---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, regions } from "../site";
import { absoluteUrl, root } from "../utils/collection";

const profiles = [site.socialLinks.x, site.socialLinks.linkedin].filter(Boolean);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.publicationName,
    url: site.siteUrl,
    foundingDate: site.founded,
    description: site.publicationDescription,
    founder: { "@type": "Person", name: site.authorName },
    logo: absoluteUrl("/images/branding/logo-mark-light.svg"),
    ...(profiles.length ? { sameAs: profiles } : {}),
  },
];
---

<BaseLayout
  title="About"
  description={`About ${site.publicationNameDisplay}: how News, Journal and the risk tool fit together, and who writes it.`}
  path="/about"
  jsonLd={jsonLd}
>
  <div class="shell max-w-[1180px] pt-0" data-tone="journal">
    <header class="border-b-2 border-ink py-10 md:py-14">
      <p class="kicker-ink">About Statevera</p>
      <h1 class="t-lead mt-1.5">International affairs, made readable.</h1>
      <p class="mt-3 max-w-2xl font-serif text-[1.08rem] leading-relaxed text-ink-soft">
        Statevera is an independent publication about power, politics and the forces shaping
        the international system.
      </p>
    </header>

    <section class="grid gap-x-8 gap-y-9 border-b border-line py-9 sm:grid-cols-2 xl:grid-cols-4" aria-label="What Statevera includes">
      <a href={root("/wire")} class="block border-t-2 border-tone pt-3 transition-colors hover:text-tone" data-tone="wire">
        <p class="kicker">News</p>
        <h2 class="t-headline-sm mt-2">Reporting as it happens.</h2>
        <p class="mt-2 font-serif text-[0.96rem] leading-relaxed text-ink-soft">
          News from public sources, refreshed every 15 minutes and organized across five international-affairs categories.
        </p>
      </a>

      <a href={root("/journal")} class="block border-t-2 border-tone pt-3 transition-colors hover:text-tone" data-tone="journal">
        <p class="kicker">Journal</p>
        <h2 class="t-headline-sm mt-2">Zeynep Doruk's writing.</h2>
        <p class="mt-2 font-serif text-[0.96rem] leading-relaxed text-ink-soft">
          Original analysis, essays and theory about strategy, power and the international system.
        </p>
      </a>

      <a href={root("/risk")} class="block border-t-2 border-tone pt-3 transition-colors hover:text-tone" data-tone="risk">
        <p class="kicker">GLORISK</p>
        <h2 class="t-headline-sm mt-2">A geopolitical risk platform.</h2>
        <p class="mt-2 font-serif text-[0.96rem] leading-relaxed text-ink-soft">
          A practical way to explore country and regional risk through scores, categories and scenarios.
        </p>
      </a>

      <div class="border-t-2 border-ink pt-3">
        <p class="kicker-ink">Regions</p>
        <h2 class="t-headline-sm mt-2">The world, by place.</h2>
        <p class="mt-2 font-serif text-[0.96rem] leading-relaxed text-ink-soft">
          Browse coverage by region, from Europe and the Middle East to Asia-Pacific, Africa and the Americas.
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
          {Object.entries(regions).map(([slug, region]) => (
            <li><a href={root(`/regions/${slug}`)} class="link-tone text-[0.78rem]">{region.short}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-b border-line py-10 md:py-12" aria-label="Founder and editor">
      <div class="max-w-4xl">
        <p class="kicker-ink">Founder &amp; editor</p>
        <h2 class="t-headline mt-1.5">{site.authorName}</h2>
        <p class="mt-3 max-w-3xl font-serif text-[1.08rem] leading-relaxed text-ink-soft">
          Zeynep Doruk is the founder, editor and sole writer of Statevera. Her work connects
          international reporting with primary-source research, data-driven tools and original
          analysis on security, diplomacy, political economy and the changing international order.
        </p>
        <p class="mt-3 max-w-3xl font-serif text-[1rem] leading-relaxed text-ink-soft">
          Through The Journal, World News, Primary Sources and GLORISK, Statevera brings together
          what is happening, what it means and what the underlying data shows.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
          {profiles.map((profile) => (
            <a href={profile} target="_blank" rel="noopener" class="kicker-ink hover:text-tone">
              {profile === site.socialLinks.x ? "X" : "LinkedIn"}
            </a>
          ))}
          <a href={root(site.socialLinks.rss)} class="kicker-ink hover:text-tone">RSS feed</a>
        </div>
      </div>
    </section>

    <p class="meta py-5">
      News headlines and summaries link to their original publishers. The Journal and GLORISK are original Statevera projects.
    </p>
  </div>
</BaseLayout>
