---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { journalSections } from "../../site";
import { getByCategory, getAllExplainers, root } from "../../utils/collection";
import JournalCard from "../../components/JournalCard.astro";
import SectionHead from "../../components/SectionHead.astro";

const meta = journalSections.theory;
const articles = await getByCategory("Theory");
const [lead, ...rest] = articles;
const explainers = (await getAllExplainers()).slice(0, 5);
---

<BaseLayout title={meta.name} description={meta.description} path={meta.url} tone="journal">
  <div class="shell pt-7 md:pt-9" data-tone="journal">
    <header class="border-b-2 border-ink pb-5">
      <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="flex items-center gap-2 font-sans text-[0.68rem] font-bold tracking-[0.12em] uppercase">
          <li><a href={root("/journal")} class="text-muted transition-colors hover:text-tone">The Journal</a></li>
          <li aria-hidden="true" class="text-line-strong">/</li>
          <li class="text-tone">{meta.name}</li>
        </ol>
      </nav>
      <h1 class="t-lead">{meta.name}</h1>
      <p class="mt-1.5 font-sans text-[0.72rem] font-bold tracking-[0.16em] uppercase text-tone">
        {meta.tagline}
      </p>
      <p class="mt-3 max-w-3xl font-serif text-[1.06rem] leading-relaxed text-ink-soft">
        {meta.description}
      </p>
    </header>

    {articles.length === 0 ? (
      <p class="py-16 text-center font-serif text-[1.05rem] text-muted">Nothing here yet.</p>
    ) : (
      <section class="grid gap-x-9 gap-y-10 py-9 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)]">
        <div>
          {lead && <JournalCard item={{ kind: "article", entry: lead }} variant="lead" priority headingLevel="h2" />}
          {rest.length > 0 && (
            <div class="mt-9 grid gap-x-8 gap-y-9 border-t border-line pt-8 sm:grid-cols-2">
              {rest.map((entry) => (
                <JournalCard item={{ kind: "article", entry }} variant="feature" />
              ))}
            </div>
          )}
        </div>

        <aside class="lg:border-l lg:border-line lg:pl-8">
          <SectionHead title="Explainers" tone="journal" href="/explainers" moreLabel="All" />
          <div class="rule-list">
            {explainers.map((entry) => (
              <JournalCard item={{ kind: "explainer", entry }} variant="text" showDek={false} />
            ))}
          </div>
          <p class="mt-6 border-t border-line pt-4 font-serif text-[0.95rem] leading-relaxed text-ink-soft">
            Theory essays explain why states behave as they do. Explainers cover the
            institutions and chokepoints those theories keep running into.
          </p>
        </aside>
      </section>
    )}
  </div>
</BaseLayout>
