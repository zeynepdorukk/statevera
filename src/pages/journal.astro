---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pillars } from "../site";
import {
  getFeaturedArticle,
  getJournalStream,
} from "../utils/collection";
import JournalCard from "../components/JournalCard.astro";
import SectionHead from "../components/SectionHead.astro";

const featured = await getFeaturedArticle();
const stream = await getJournalStream();

const rest = stream.filter((item) => item.entry.id !== featured?.id);
---

<BaseLayout
  title={pillars.journal.name}
  description={pillars.journal.description}
  path="/journal"
  tone="journal"
>
  <div class="shell pt-0" data-tone="journal">
    {stream.length === 0 ? (
      <p class="py-16 text-center font-serif text-[1.05rem] text-muted">
        Nothing published yet.
      </p>
    ) : (
      <>
        <!-- Featured -->
        <section class="grid gap-x-9 gap-y-9 py-9 lg:grid-cols-[minmax(0,6fr)_minmax(0,4fr)]" aria-label="Featured">
          {featured && <JournalCard item={{ kind: "article", entry: featured }} variant="lead" priority headingLevel="h2" />}
          <div class="lg:border-l lg:border-line lg:pl-8">
            <SectionHead title="Latest" tone="journal" />
            <div class="rule-list">
              {rest.slice(0, 6).map((item) =>
                item.kind === "article" ? (
                  <JournalCard item={{ kind: "article", entry: item.entry }} variant="text" />
                ) : (
                  <JournalCard item={{ kind: "explainer", entry: item.entry }} variant="text" />
                )
              )}
            </div>
          </div>
        </section>

        <!-- Archive -->
        <section class="border-t-2 border-ink pt-7" aria-label="Archive">
          <SectionHead title="Archive" tone="journal" />
          <div class="grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((item) =>
              item.kind === "article" ? (
                <JournalCard item={{ kind: "article", entry: item.entry }} variant="feature" />
              ) : (
                <JournalCard item={{ kind: "explainer", entry: item.entry }} variant="feature" />
              )
            )}
          </div>
        </section>

      </>
    )}
  </div>
</BaseLayout>
