---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, newsSections, type CategorySlug } from "../site";
import { getAllArticles, getAllBriefings, heroImageOf, formatDate, formatTime, readingTime, root } from "../utils/collection";
import StoryCard from "../components/StoryCard.astro";
import HeadlineItem from "../components/HeadlineItem.astro";

const meta = categories.news;

const [articles, briefings] = await Promise.all([getAllArticles(), getAllBriefings()]);
const newsArticles = articles.filter((a) => newsSections.includes(a.data.category.toLowerCase() as (typeof newsSections)[number]));
const lead = newsArticles[0];
const rest = newsArticles.slice(1);
const briefingsShown = briefings.slice(0, 5);
const leadHref = lead ? root(`/articles/${lead.id.replace(/\.mdx?$/, "")}`) : "";
---

<BaseLayout title={meta.name} description={meta.description} path={meta.url}>
  <div class="mx-auto max-w-[1400px] px-4 pt-8 md:px-8 md:pt-10">
    <header class="border-b-2 border-ink pb-5">
      <h1 class="t-headline-lg">{meta.name}</h1>
      <p class="mt-1 font-sans text-[0.72rem] font-semibold tracking-[0.18em] uppercase text-accent">{meta.tagline}</p>
      <p class="mt-3 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-ink-soft">{meta.description}</p>
    </header>

    <div class="grid gap-10 py-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12">
      <div class="min-w-0">
        {lead && (
          <article class="group border-b border-line pb-8">
            <a href={leadHref} class="img-zoom block overflow-hidden border border-line/60 bg-paper-soft" tabindex="-1" aria-hidden="true">
              <img src={heroImageOf(lead.data.heroImage)} alt="" width="1600" height="1000" loading="eager" class="aspect-[16/9] w-full object-cover" />
            </a>
            <p class="kicker mt-4">{lead.data.category} · {lead.data.region}</p>
            <h2 class="t-headline mt-2">
              <a href={leadHref} class="editorial-link">{lead.data.title}</a>
            </h2>
            <p class="mt-2.5 max-w-2xl font-serif text-[1.02rem] leading-relaxed text-muted">{lead.data.description}</p>
            <p class="meta mt-3">
              By <span class="meta-strong">{lead.data.author}</span> · {formatDate(lead.data.date)} · {readingTime(lead)} min read
            </p>
          </article>
        )}

        {rest.length > 0 && (
          <div class="grid gap-x-8 gap-y-8 pt-8 sm:grid-cols-2">
            {rest.map((a) => (
              <StoryCard article={a} />
            ))}
          </div>
        )}
      </div>

      <aside class="space-y-8 lg:border-l lg:border-line lg:pl-8">
        <div>
          <div class="section-head">
            <h2 class="title">Sections</h2>
            <span class="rule" aria-hidden="true"></span>
          </div>
          <ul class="space-y-2 border-t border-line pt-3">
            {newsSections.map((k) => (
              <li>
                <a href={root(categories[k as CategorySlug].url)} class="editorial-link font-sans text-[0.85rem] font-medium text-ink-soft">
                  {categories[k as CategorySlug].name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="section-head">
            <h2 class="title">Latest briefings</h2>
            <span class="rule" aria-hidden="true"></span>
          </div>
          <ul class="border-t border-line">
            {briefingsShown.map((b) => (
              <li class="border-b border-line py-3">
                <p class="flex items-baseline gap-2">
                  <time class="font-sans text-[0.7rem] font-semibold text-accent" datetime={b.data.timestamp.toISOString()}>
                    {formatTime(b.data.timestamp)}
                  </time>
                  <span class="meta-strong">{b.data.location}</span>
                </p>
                <p class="mt-1 font-serif text-[0.92rem] leading-snug text-ink-soft">{b.body.trim()}</p>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
