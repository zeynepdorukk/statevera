---
import BaseLayout from "../layouts/BaseLayout.astro";
import { deskList } from "../site";
import { wireItems, leadStories } from "../data/wire";
import { root } from "../utils/collection";
import WireCard from "../components/WireCard.astro";
import SectionHead from "../components/SectionHead.astro";
import MarketTicker from "../components/MarketTicker.astro";

const leads = leadStories(3);
const leadIds = new Set(leads.map((i) => i.id));
const stream = wireItems.filter((i) => !leadIds.has(i.id));
const rail = stream.slice(45, 60);

const deskCounts = deskList
  .map((desk) => ({ desk, count: wireItems.filter((i) => i.category === desk.name).length }))
  .filter((d) => d.count > 0);

---

<BaseLayout
  title="News"
  description="Live international affairs reporting from established newsrooms and institutions."
  path="/wire"
  tone="wire"
>
  <div class="shell pt-0" data-tone="wire">
    <!-- Desk filter -->
    <div class="news-toolbar">
      <nav aria-label="Desks" class="flex flex-wrap gap-x-1 gap-y-1 border-b border-line py-3">
        <span class="desk-pill is-on">All</span>
        {deskCounts.map(({ desk }) => (
          <a href={root(`/wire/${desk.slug}`)} class="desk-pill">
            {desk.name}
          </a>
        ))}
      </nav>
      <MarketTicker />
    </div>

    <div class="grid gap-x-8 gap-y-8 py-8 lg:grid-cols-[minmax(0,6fr)_minmax(0,4fr)]">
      <div class="contents lg:block">
        <section class="order-1" aria-label="Leading stories">
          {leads[0] && <WireCard item={leads[0]} variant="lead" priority headingLevel="h2" />}
        </section>

        <section class="order-3 border-t-2 border-ink pt-7 pb-6 lg:order-none lg:mt-8" aria-label="All reporting">
          <SectionHead title="Every story" tone="wire" />
          <div class="grid gap-x-7 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
            {stream.slice(0, 45).map((item, i) => (
              <WireCard item={item} variant={item.image && i < 12 ? "feature" : "compact"} showDek={i < 12} />
            ))}
          </div>
        </section>
      </div>

      <aside class="order-2 lg:order-none lg:border-l lg:border-line lg:pl-8" aria-label="More news">
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-1">
          {leads.slice(1).map((item) => (
            <WireCard item={item} variant="feature" priority />
          ))}
        </div>

        {rail.length > 0 && (
          <div class="mt-10 border-t-2 border-ink pt-7">
            <SectionHead title="More news" tone="wire" href="/wire" moreLabel="All" />
            <div class="rule-list">
              {rail.map((item) => (
                <WireCard item={item} variant="compact" />
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .desk-pill {
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.35rem 0.75rem;
    border: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .desk-pill:hover {
    color: var(--tone);
    border-color: var(--line);
  }
  .desk-pill.is-on {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--paper-soft);
  }
</style>
