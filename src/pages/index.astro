---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import LeadStory from "../components/LeadStory.astro";
import LatestRail from "../components/LatestRail.astro";
import BriefingRail from "../components/BriefingRail.astro";
import TopStories from "../components/TopStories.astro";
import WorldToday from "../components/WorldToday.astro";
import LatestAnalysis from "../components/LatestAnalysis.astro";
import CategorySection from "../components/CategorySection.astro";
import RegionTabs from "../components/RegionTabs.astro";
import ExplainersBlock from "../components/ExplainersBlock.astro";
import FromTheEditor from "../components/FromTheEditor.astro";
import NewsletterBlock from "../components/NewsletterBlock.astro";
---

<BaseLayout
  title=""
  description={site.publicationTagline}
  path="/"
>
  <!-- Lead area: latest / lead story / today's briefing -->
  <h1 class="sr-only">Statevera — {site.publicationTagline}</h1>
  <div class="mx-auto max-w-[1400px] px-4 pt-5 md:px-8 md:pt-7">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-[minmax(0,2.1fr)_minmax(0,5.4fr)_minmax(0,2.5fr)] lg:gap-y-0">
      <div class="order-3 lg:order-1 lg:border-r lg:border-line lg:pr-8">
        <LatestRail />
      </div>
      <div class="order-1 lg:order-2 lg:pr-8 xl:pr-0">
        <LeadStory />
      </div>
      <div class="order-2 lg:order-3 lg:border-l lg:border-line lg:pl-8">
        <BriefingRail />
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1400px] space-y-12 px-4 pt-12 md:px-8">
    <TopStories />
    <WorldToday />
    <LatestAnalysis />
    <CategorySection number="05" title="Geopolitics" category="Geopolitics" url="/news/geopolitics" layout="split" />
    <CategorySection number="06" title="Security" category="Security" url="/news/security" layout="feature" />
    <CategorySection number="07" title="Economy" category="Economy" url="/news/economy" layout="grid" />
    <CategorySection number="08" title="Diplomacy" category="Diplomacy" url="/news/diplomacy" layout="split" />
    <RegionTabs />
    <ExplainersBlock />
    <div class="grid gap-6 pt-2 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <FromTheEditor />
    </div>
  </div>

  <div class="mt-12">
    <NewsletterBlock />
  </div>
</BaseLayout>
