---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, pillars, deskList } from "../site";
import { leadStories, byCategory, latest } from "../data/wire";
import { getJournalStream, getFeaturedArticle, getAllExplainers, root } from "../utils/collection";
import WireCard from "../components/WireCard.astro";
import JournalCard from "../components/JournalCard.astro";
import SectionHead from "../components/SectionHead.astro";

const leads = leadStories(5);
const leadIds = new Set(leads.map((i) => i.id));
const [lead, ...secondary] = leads;

const stream = latest(30).filter((i) => !leadIds.has(i.id));
const briefColumn = stream.slice(0, 9);
const rest = stream.slice(9);

const journal = await getJournalStream(6);
const featured = await getFeaturedArticle();
const explainers = (await getAllExplainers()).slice(0, 4);

const deskBlocks = deskList
  .map((desk) => ({ desk, items: byCategory(desk.name, 4) }))
  .filter((block) => block.items.length >= 3)
  .slice(0, 3);
---

<BaseLayout title="" description={site.publicationDescription} path="/">
  <h1 class="sr-only">{site.publicationName} — {site.publicationTagline}</h1>

  <!-- ============ LEAD ============ -->
  <section class="shell pt-6 md:pt-8" aria-label="Top stories" data-tone="wire">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-[minmax(0,7.4fr)_minmax(0,2.6fr)]">
      <div>
        {lead && <WireCard item={lead} variant="lead" priority headingLevel="h2" />}

        {secondary.length > 0 && (
          <div class="mt-8 grid gap-x-7 gap-y-8 border-t border-line pt-7 sm:grid-cols-2 lg:grid-cols-4">
            {secondary.map((item) => (
              <WireCard item={item} variant="feature" showDek={false} priority />
            ))}
          </div>
        )}
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-8" aria-label="Latest reporting">
        <SectionHead title="Latest" tone="wire" href="/wire" moreLabel="News" />
        <div class="rule-list">
          {briefColumn.map((item) => (
            <WireCard item={item} variant="text" />
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ JOURNAL ============ -->
  <section class="shell mt-14" aria-label="Journal" data-tone="journal">
    <div class="border-t-2 border-ink pt-1">
      <div class="flex flex-wrap items-end justify-between gap-4 py-5">
        <div>
          <p class="kicker">Journal</p>
          <h2 class="t-headline mt-1">{pillars.journal.tagline}</h2>
        </div>
        <p class="max-w-md font-serif text-[0.98rem] leading-relaxed text-ink-soft">
          Original analysis written for Statevera by{" "}
          <a href={root("/about")} class="link-tone">{site.authorName}</a>.
          <a href={root("/journal")} class="link-tone ml-1">Read the archive &rarr;</a>
        </p>
      </div>

      <div class="grid gap-x-8 gap-y-9 border-t border-line pt-7 lg:grid-cols-[minmax(0,5fr)_minmax(0,5fr)]">
        {featured && <JournalCard item={{ kind: "article", entry: featured }} variant="lead" priority headingLevel="h3" />}

        <div class="grid gap-7 sm:grid-cols-2 lg:border-l lg:border-line lg:pl-8">
          {journal
            .filter((item) => item.entry.id !== featured?.id)
            .slice(0, 4)
            .map((item) =>
              item.kind === "article" ? (
                <JournalCard item={{ kind: "article", entry: item.entry }} variant="text" />
              ) : (
                <JournalCard item={{ kind: "explainer", entry: item.entry }} variant="text" />
              )
            )}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DESKS ============ -->
  <section class="shell mt-14" aria-label="Desks" data-tone="wire">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-3">
      {deskBlocks.map(({ desk, items }) => (
        <div>
          <SectionHead title={desk.name} tone="wire" href={`/wire/${desk.slug}`} moreLabel="More" />
          <WireCard item={items[0]} variant="feature" />
          <div class="rule-list mt-4 border-t border-line pt-1">
            {items.slice(1).map((item) => (
              <WireCard item={item} variant="compact" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ RISK ============ -->
  <section class="mt-14 border-y-2 border-ink bg-paper-soft" aria-label="Risk analysis" data-tone="risk">
    <div class="shell py-9">
      <div>
        <p class="kicker-ink">Risk</p>
        <h2 class="t-headline mt-1.5">{pillars.risk.tagline}</h2>
        <p class="mt-3 max-w-xl font-serif text-[1.03rem] leading-relaxed text-ink-soft">
          {pillars.risk.description}
        </p>
        <a href={root("/risk")} class="btn mt-5">
          Open Glorisk
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ MORE FROM NEWS + EXPLAINERS ============ -->
  <section class="shell mt-14 pb-6" aria-label="More reporting">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)]">
      <div data-tone="wire">
        <SectionHead title="More from News" tone="wire" href="/wire" moreLabel="All news" />
        <div class="grid gap-x-7 gap-y-7 sm:grid-cols-2">
          {rest.slice(0, 10).map((item) => (
            <WireCard item={item} variant="compact" />
          ))}
        </div>
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-8" data-tone="journal" aria-label="Explainers">
        <SectionHead title="Explainers" tone="journal" href="/explainers" moreLabel="All" />
        <div class="rule-list">
          {explainers.map((entry) => (
            <JournalCard item={{ kind: "explainer", entry }} variant="text" showDek={false} />
          ))}
        </div>
        <p class="mt-5 border-t border-line pt-4 font-serif text-[0.95rem] leading-relaxed text-ink-soft">
          Evergreen reference on the institutions, doctrines and chokepoints that keep
          returning to the news.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
