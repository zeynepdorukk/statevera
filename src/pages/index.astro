---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, pillars, deskList } from "../site";
import { leadStories, byCategory, spread, wireItems } from "../data/wire";
import { getJournalStream, getFeaturedArticle, root } from "../utils/collection";
import WireCard from "../components/WireCard.astro";
import JournalCard from "../components/JournalCard.astro";
import SectionHead from "../components/SectionHead.astro";

// NEWS — the lead slots never repeat anywhere below
const leads = leadStories(5);
const leadIds = new Set(leads.map((i) => i.id));
const [lead, ...secondary] = leads;

// NEWS — compact feed under the hero, deduped against the leads
const usedIds = new Set(leadIds);
const feed = spread(wireItems.filter((i) => !usedIds.has(i.id)), 30, 2).slice(0, 8);
for (const item of feed) usedIds.add(item.id);

// JOURNAL — signed analysis. The rail next to the hero shows the most
// recent pieces, the band below shows the featured one plus the rest.
const journal = await getJournalStream(7);
const featured = await getFeaturedArticle();
const featuredId = featured?.id;
const asideJournal = journal.filter((i) => i.entry.id !== featuredId).slice(0, 3);
const asideIds = new Set(asideJournal.map((i) => i.entry.id));
const mainJournal = journal
  .filter((i) => i.entry.id !== featuredId && !asideIds.has(i.entry.id))
  .slice(0, 4);

// DESKS — Security, Diplomacy, Economy without repeating the feed above
const deskBlocks = deskList
  .map((desk) => ({
    desk,
    items: byCategory(desk.name, 8)
      .filter((i) => !usedIds.has(i.id))
      .slice(0, 4),
  }))
  .filter((block) => block.items.length >= 3)
  .slice(0, 3);
for (const block of deskBlocks) for (const item of block.items) usedIds.add(item.id);

// NEWS — the long tail, everything above is off the table
const rest = spread(wireItems.filter((i) => !usedIds.has(i.id)), 12, 2).slice(0, 12);
---

<BaseLayout title="" description={site.publicationDescription} path="/">
  <h1 class="sr-only">{site.publicationName} — {site.publicationTagline}</h1>

  <!-- ============ LEAD ============ -->
  <section class="shell pt-6 md:pt-8" aria-label="Top stories" data-tone="wire">
    <div class="grid gap-x-8 gap-y-8 lg:grid-cols-[minmax(0,7.4fr)_minmax(0,2.6fr)]">
      <div>
        {lead && <WireCard item={lead} variant="lead" priority headingLevel="h2" />}

        {secondary.length > 0 && (
          <div class="mt-8 grid gap-x-7 gap-y-8 border-t border-line pt-7 sm:grid-cols-2 lg:grid-cols-4">
            {secondary.map((item) => (
              <WireCard item={item} variant="feature" showDek={false} priority />
            ))}
          </div>
        )}
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-8" aria-label="From the Journal" data-tone="journal">
        <SectionHead title="From the Journal" tone="journal" href="/journal" moreLabel="Archive" />
        {asideJournal.length > 0 ? (
          <div class="rule-list">
            {asideJournal.map((item) => (
              <JournalCard item={{ kind: "article", entry: item.entry }} variant="text" />
            ))}
          </div>
        ) : (
          <div class="border-t border-line pt-4">
            <p class="font-serif text-[0.97rem] leading-relaxed text-ink-soft">
              Original analysis written for Statevera by{" "}
              <a href={root("/about")} class="link-tone">{site.authorName}</a>.
            </p>
            <p class="mt-3 font-serif text-[0.97rem] leading-relaxed text-ink-soft">
              <a href={root("/journal")} class="link-tone">Read the archive &rarr;</a>
            </p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- ============ NEWS FEED ============ -->
  <section class="shell mt-14" aria-label="News" data-tone="wire">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b-2 border-ink pb-5">
      <div>
        <p class="kicker">News</p>
        <h2 class="t-headline mt-1">{pillars.wire.tagline}</h2>
        <p class="mt-1 font-serif text-[0.98rem] italic text-muted">What is happening.</p>
      </div>
      <a href={root("/wire")} class="link-tone mb-1 font-sans text-[0.68rem] font-bold tracking-[0.11em] uppercase">
        All news <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="mt-1 grid gap-x-9 gap-y-4 sm:grid-cols-2">
      {feed.map((item) => (
        <div class="border-t border-line pt-4">
          <WireCard item={item} variant="text" />
        </div>
      ))}
    </div>
  </section>

  <!-- ============ JOURNAL ============ -->
  <section
    class="mt-14 border-y-2 border-t-journal border-ink bg-paper-soft"
    aria-label="Journal"
    data-tone="journal"
  >
    <div class="shell py-9">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        <div>
          <p class="kicker">Journal</p>
          <h2 class="t-headline mt-1">{pillars.journal.tagline}</h2>
          <p class="mt-1 font-serif text-[0.98rem] italic text-muted">What does it mean.</p>
        </div>
        <p class="max-w-md pb-1 font-serif text-[0.98rem] leading-relaxed text-ink-soft">
          Original analysis written for Statevera by{" "}
          <a href={root("/about")} class="link-tone">{site.authorName}</a>.
          <a href={root("/journal")} class="link-tone ml-1">Read the archive &rarr;</a>
        </p>
      </div>

      {journal.length === 0 ? (
        <p class="border-t border-line py-14 text-center font-serif text-[1.05rem] text-muted">
          Nothing published yet.
        </p>
      ) : (
        <div class="grid gap-x-8 gap-y-9 border-t border-line pt-7 lg:grid-cols-[minmax(0,5fr)_minmax(0,5fr)]">
          {featured && (
            <JournalCard item={{ kind: "article", entry: featured }} variant="lead" priority headingLevel="h3" />
          )}

          {mainJournal.length > 0 && (
            <div class="grid gap-7 sm:grid-cols-2 lg:border-l lg:border-line lg:pl-8">
              {mainJournal.map((item) => (
                <JournalCard item={{ kind: "article", entry: item.entry }} variant="text" />
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- ============ DESKS ============ -->
  <section class="shell mt-14" aria-label="Desks" data-tone="wire">
    <div class="grid gap-x-8 gap-y-10 lg:grid-cols-3">
      {deskBlocks.map(({ desk, items }) => (
        <div>
          <SectionHead title={desk.name} tone="wire" href={`/wire/${desk.slug}`} moreLabel="More" />
          <WireCard item={items[0]} variant="feature" />
          <div class="rule-list mt-4 border-t border-line pt-1">
            {items.slice(1).map((item) => (
              <WireCard item={item} variant="compact" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ GLORISK ============ -->
  <section class="mt-14 border-y-2 border-ink bg-paper-soft" aria-label="GLORISK" data-tone="risk">
    <div class="shell py-9">
      <div>
        <p class="kicker-ink">GLORISK</p>
        <h2 class="t-headline mt-1.5">{pillars.risk.tagline}</h2>
        <p class="mt-2 font-serif text-[1.02rem] italic text-muted">What does the data show.</p>
        <p class="mt-3 max-w-xl font-serif text-[1.03rem] leading-relaxed text-ink-soft">
          {pillars.risk.description}
        </p>
        <a href={root("/risk")} class="btn mt-5">
          Open Glorisk
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ MORE FROM NEWS ============ -->
  <section class="shell mt-14 pb-6" aria-label="More reporting" data-tone="wire">
    <SectionHead title="More from News" tone="wire" href="/wire" moreLabel="All news" />
    <div class="grid gap-x-7 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
      {rest.map((item) => (
        <WireCard item={item} variant="compact" />
      ))}
    </div>
  </section>
</BaseLayout>
