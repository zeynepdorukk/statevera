---
import BaseLayout from "../layouts/BaseLayout.astro";

const GLORISK_URL = "https://zeynepdorukk.github.io/Glorisk/";
---

<BaseLayout
  title="GLORISK"
  description="Interactive geopolitical risk analysis."
  path="/risk"
  tone="risk"
  hideTicker
  hideFooter
>
  <div class="w-full bg-paper">
    <iframe
      src={GLORISK_URL}
      title="GLORISK"
      class="block h-[calc(100dvh-7rem)] min-h-[560px] w-full border-0 bg-white"
      loading="eager"
      allow="fullscreen"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</BaseLayout>
