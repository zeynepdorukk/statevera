---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { getLatestArticles, getLatestBriefings, formatTime } from "../utils/collection";

const [articles, briefings] = await Promise.all([getLatestArticles(4), getLatestBriefings(4)]);
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." path="/404" noindex={true}>
  <div class="mx-auto max-w-[820px] px-4 pt-16 text-center md:px-8 md:pt-24">
    <p class="font-serif text-[5rem] font-semibold leading-none tracking-tight text-line-strong">404</p>
    <h1 class="t-headline mt-2">This page has left the building</h1>
    <p class="mx-auto mt-3 max-w-md font-serif text-[1.05rem] leading-relaxed text-muted">
      The address you followed does not exist on {site.publicationNameDisplay}. The international
      system moves quickly — perhaps this story moved with it.
    </p>
    <p class="mt-6">
      <a href="/" class="border border-accent bg-accent px-5 py-2.5 font-sans text-[0.75rem] font-bold tracking-[0.1em] text-white uppercase transition-colors duration-200 hover:bg-accent-ink">
        Return to the front page
      </a>
    </p>

    <div class="mt-14 grid gap-8 border-t border-line pt-8 text-left sm:grid-cols-2">
      <div>
        <div class="section-head">
          <h2 class="title">Latest</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <ul class="border-t border-line">
          {articles.map((a) => (
            <li class="border-b border-line py-3">
              <h3 class="font-serif text-[1rem] font-medium leading-snug">
                <a href={`/articles/${a.id.replace(/\.mdx?$/, "")}`} class="editorial-link">
                  {a.data.title}
                </a>
              </h3>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="section-head">
          <h2 class="title">Briefing</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <ul class="border-t border-line">
          {briefings.map((b) => (
            <li class="border-b border-line py-3">
              <p class="flex items-baseline gap-2">
                <time class="font-sans text-[0.7rem] font-semibold text-accent" datetime={b.data.timestamp.toISOString()}>
                  {formatTime(b.data.timestamp)}
                </time>
                <span class="meta-strong">{b.data.location}</span>
              </p>
              <p class="mt-1 font-serif text-[0.9rem] leading-snug text-ink-soft">{b.body.trim()}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
