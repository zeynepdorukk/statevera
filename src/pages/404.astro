---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pillarList } from "../site";
import { latest } from "../data/wire";
import { getLatestArticles, root } from "../utils/collection";
import WireCard from "../components/WireCard.astro";
import JournalCard from "../components/JournalCard.astro";
import SectionHead from "../components/SectionHead.astro";

const wire = latest(5);
const journal = await getLatestArticles(3);
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404"
  noindex
>
  <div class="shell max-w-[1100px] py-14">
    <p class="kicker-ink">Error 404</p>
    <h1 class="t-display mt-2">This page is not on file.</h1>
    <p class="mt-4 max-w-2xl font-serif text-[1.14rem] leading-relaxed text-ink-soft">
      The address may have changed, or the page may never have existed. The three
      sections of the publication are all still here.
    </p>

    <div class="mt-8 grid gap-px border border-line-strong bg-line-strong sm:grid-cols-3">
      {pillarList.map((pillar) => (
        <a href={root(pillar.url)} class="group bg-paper p-5 transition-colors hover:bg-paper-soft" data-tone={pillar.tone}>
          <p class="kicker flex items-center gap-2">
            <span class="inline-block h-2 w-2 bg-tone" aria-hidden="true"></span>
            {pillar.name}
          </p>
          <p class="mt-1.5 font-serif text-[1.05rem] leading-snug text-ink">{pillar.tagline}</p>
        </a>
      ))}
    </div>

    <div class="mt-12 grid gap-x-9 gap-y-10 lg:grid-cols-2">
      <div data-tone="wire">
        <SectionHead title="Latest on the wire" tone="wire" href="/wire" moreLabel="The Wire" />
        <div class="rule-list">
          {wire.map((item) => <WireCard item={item} variant="text" />)}
        </div>
      </div>
      <div data-tone="journal">
        <SectionHead title="From the journal" tone="journal" href="/journal" moreLabel="The Journal" />
        <div class="rule-list">
          {journal.map((entry) => (
            <JournalCard item={{ kind: "article", entry }} variant="compact" />
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
