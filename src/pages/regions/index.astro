---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { regions, regionSlugOf, type RegionSlug } from "../../site";
import { activeRegions, wireItems } from "../../data/wire";
import { getAllArticles } from "../../utils/collection";
import WorldMap from "../../components/WorldMap.astro";

const articles = await getAllArticles();
const rows = (Object.entries(regions) as [RegionSlug, (typeof regions)[RegionSlug]][]).map(
  ([slug, region]) => ({
    slug,
    region,
    wire: wireItems.filter((item) => item.region === region.name),
    journal: articles.filter((article) => article.data.region === region.name),
  })
);

const busiest = activeRegions().find((entry) => entry.region !== "Global") ?? activeRegions()[0];
const initialSlug = rows.some((row) => row.slug === "global")
  ? "global"
  : busiest
    ? regionSlugOf(busiest.region)
    : rows[0]?.slug ?? "europe";
---

<BaseLayout
  title="Regions"
  description="Explore international affairs by region through live News, Journal analysis and GLORISK context."
  path="/regions"
>
  <div class="shell pt-0" data-tone="wire">
    <WorldMap rows={rows} initialSlug={initialSlug} />
  </div>
</BaseLayout>
