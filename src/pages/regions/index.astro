---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { regions, type RegionSlug } from "../../site";
import { wireItems, activeRegions } from "../../data/wire";
import { getAllArticles, root } from "../../utils/collection";
import WireCard from "../../components/WireCard.astro";
import JournalCard from "../../components/JournalCard.astro";
import SectionHead from "../../components/SectionHead.astro";

const articles = await getAllArticles();

const rows = (Object.entries(regions) as [RegionSlug, (typeof regions)[RegionSlug]][]).map(
  ([slug, region]) => ({
    slug,
    region,
    wire: wireItems.filter((i) => i.region === region.name),
    journal: articles.filter((a) => a.data.region === region.name),
  })
);

const busiest = activeRegions()[0];
---

<BaseLayout
  title="Regions"
  description="International affairs by region: live reporting from the dispatch and signed analysis from the journal, side by side."
  path="/regions"
>
  <div class="shell pt-7 md:pt-9">
    <header class="border-b-2 border-ink pb-5">
      <p class="kicker-ink">Regions</p>
      <h1 class="t-lead mt-1.5">The world, desk by desk</h1>
      <p class="mt-3 max-w-3xl font-serif text-[1.06rem] leading-relaxed text-ink-soft">
        Every region page puts live reporting from
        <a href={root("/wire")} class="link-tone">the Dispatch</a> next to signed analysis from
        <a href={root("/journal")} class="link-tone">the Journal</a>.
      </p>
      {busiest && (
        <p class="meta mt-3">
          Busiest desk right now: <span class="meta-strong">{busiest.region}</span>,
          {" "}{busiest.count} stories.
        </p>
      )}
    </header>

    <div class="grid gap-x-8 gap-y-10 py-9 md:grid-cols-2 xl:grid-cols-4">
      {rows.map(({ slug, region, wire, journal }) => (
        <section aria-label={region.name}>
          <SectionHead title={region.short} href={`/regions/${slug}`} moreLabel="Open" />
          <p class="font-serif text-[0.95rem] leading-relaxed text-ink-soft">
            {region.description}
          </p>
          <p class="meta mt-2.5 flex flex-wrap gap-x-3">
            <span data-tone="wire" class="inline-flex items-center gap-1.5">
              <span class="inline-block h-1.5 w-1.5 bg-tone" aria-hidden="true"></span>
              {wire.length} in the dispatch
            </span>
            <span data-tone="journal" class="inline-flex items-center gap-1.5">
              <span class="inline-block h-1.5 w-1.5 bg-tone" aria-hidden="true"></span>
              {journal.length} in the journal
            </span>
          </p>

          {wire.length > 0 && (
            <div class="rule-list mt-3.5 border-t border-line pt-1" data-tone="wire">
              {wire.slice(0, 3).map((item) => (
                <WireCard item={item} variant="text" />
              ))}
            </div>
          )}

          {journal.length > 0 && (
            <div class="mt-4 border-t border-line pt-3.5" data-tone="journal">
              <JournalCard item={{ kind: "article", entry: journal[0] }} variant="text" showDek={false} />
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
