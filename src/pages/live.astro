---
import BaseLayout from "../layouts/BaseLayout.astro";
import { liveChannels, liveEmbedUrl } from "../data/live";
import { spread, wireItems } from "../data/wire";
import { relativeTime, wireDate } from "../data/wire";
import { root } from "../utils/collection";
import { getLanguage, localizePath } from "../i18n";

const language = getLanguage(Astro.currentLocale);
const hrefFor = (path: string) => root(localizePath(path, language));
const copy = language === "tr"
  ? {
      description: "Uluslararası haber kanallarını izleyin ve son Statevera Haberleri başlıklarını takip edin.",
      heading: "CANLI — uluslararası haber kanalları",
      player: "Canlı yayın oynatıcısı",
      stream: "canlı yayını",
      watching: "Şimdi izleniyor",
      latest: "Son Haberler",
      channels: "Kanallar",
      liveChannels: "Canlı kanallar",
      allNews: "Tüm haberler",
      fallback: "Canlı kanal",
      watch: "Canlı izle",
      consent: "Oynatıcı YouTube'dan yüklenir.",
    }
  : {
      description: "Watch international news channels and follow the latest Statevera News headlines.",
      heading: "LIVE — international news channels",
      player: "Live player",
      stream: "live stream",
      watching: "Now watching",
      latest: "Latest News",
      channels: "Channels",
      liveChannels: "Live channels",
      allNews: "All news",
      fallback: "Live channel",
      watch: "Watch live",
      consent: "The player loads from YouTube.",
    };
const selectedChannel = liveChannels[0];
const stories = spread(wireItems, 4, 1);
---

<BaseLayout
  title="LIVE"
  description={copy.description}
  path="/live"
  noindex
  hideTicker
>
  <div class="live-page shell pt-0" data-tone="wire" data-live-fallback={copy.fallback} data-live-stream-label={copy.stream} data-live-watch={copy.watch}>
    <h1 class="sr-only">{copy.heading}</h1>
    <div class="live-grid">
      <section class="live-player-column" aria-label={copy.player}>
        <div class="live-player-frame">
          {/* A facade until the reader asks for video: the YouTube player is ~1 MB of
              script and a dozen third-party requests, and most visitors come for the
              headlines beside it. Choosing a channel or pressing play loads it. */}
          <button type="button" class="live-facade" data-live-facade>
            <img
              data-live-facade-logo
              src={root(selectedChannel.logo)}
              alt=""
              width="160"
              height="54"
              class="live-facade-logo"
            />
            <span class="live-facade-play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
            </span>
            <span class="live-facade-label">
              <span data-live-facade-name>{copy.watch} · {selectedChannel.name}</span>
              <span class="live-facade-note">{copy.consent}</span>
            </span>
          </button>
          <iframe
            data-live-player
            hidden
            data-src={liveEmbedUrl(selectedChannel.channelId, true)}
            title={`${selectedChannel.name} ${copy.stream}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <div class="live-player-caption">
          <div>
            <p class="kicker-ink">{copy.watching}</p>
            <div class="live-now-title">
              <img
                data-live-channel-logo
                src={root(selectedChannel.logo)}
                alt=""
                width="96"
                height="32"
                class="live-now-logo"
                aria-hidden="true"
              />
              <h2 data-live-channel-title>{selectedChannel.name}</h2>
            </div>
          </div>
        </div>
      </section>

      <aside class="live-news-column" aria-label={copy.latest}>
        <p class="kicker-ink live-channels-heading">{copy.channels}</p>
        <div class="live-channel-switcher" role="tablist" aria-label={copy.liveChannels}>
          {liveChannels.map((channel, index) => (
            <button
              type="button"
              class:list={["live-channel-tab", index === 0 && "is-selected"]}
              data-channel-id={channel.id}
              data-embed-url={liveEmbedUrl(channel.channelId, true)}
              data-channel-name={channel.name}
              data-channel-logo={root(channel.logo)}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
            >
              <img src={root(channel.logo)} alt="" width="64" height="22" class="live-channel-logo" aria-hidden="true" />
              {channel.shortName}
            </button>
          ))}
        </div>
        <div class="live-news-heading">
          <p class="kicker">{copy.latest}</p>
          <a href={hrefFor("/wire")} class="kicker-ink">{copy.allNews} &rarr;</a>
        </div>
        <ul class="live-story-list">
          {stories.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer nofollow">{item.title}</a>
              <span>{item.publisher} &middot; {relativeTime(wireDate(item), new Date(), language)}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const player = document.querySelector<HTMLIFrameElement>("[data-live-player]");
  const facade = document.querySelector<HTMLButtonElement>("[data-live-facade]");
  const facadeLogo = document.querySelector<HTMLImageElement>("[data-live-facade-logo]");
  const facadeName = document.querySelector<HTMLElement>("[data-live-facade-name]");
  const liveRoot = document.querySelector<HTMLElement>("[data-live-fallback]");
  const fallback = liveRoot?.dataset.liveFallback ?? "Live channel";
  const streamLabel = liveRoot?.dataset.liveStreamLabel ?? "live stream";
  const watchLabel = liveRoot?.dataset.liveWatch ?? "Watch live";
  const title = document.querySelector<HTMLElement>("[data-live-channel-title]");
  const logo = document.querySelector<HTMLImageElement>("[data-live-channel-logo]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-channel-id]")];

  const play = (url: string | undefined) => {
    if (!player || !url) return;
    player.src = url;
    player.hidden = false;
    facade?.remove();
  };

  facade?.addEventListener("click", () => play(player?.dataset.src));

  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.classList.toggle("is-selected", selected);
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
    });
    if (focus) tab.focus();
    const name = tab.dataset.channelName ?? fallback;
    if (player) {
      player.title = `${name} ${streamLabel}`;
      player.dataset.src = tab.dataset.embedUrl ?? "";
    }
    if (title) title.textContent = name;
    if (logo && tab.dataset.channelLogo) logo.src = tab.dataset.channelLogo;
    // Switching channel is asking for video; before that, only the facade updates.
    if (player && !player.hidden) play(tab.dataset.embedUrl);
    else {
      if (facadeLogo && tab.dataset.channelLogo) facadeLogo.src = tab.dataset.channelLogo;
      if (facadeName) facadeName.textContent = `${watchLabel} · ${name}`;
    }
  };

  tabs.forEach((tab, index) => {
    tab.tabIndex = tab.classList.contains("is-selected") ? 0 : -1;
    tab.addEventListener("click", () => select(tab));
    // Tabs move with the arrow keys, as the ARIA tab pattern expects.
    tab.addEventListener("keydown", (event) => {
      const step = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
      if (event.key === "Home") return (event.preventDefault(), select(tabs[0], true));
      if (event.key === "End") return (event.preventDefault(), select(tabs[tabs.length - 1], true));
      if (!step) return;
      event.preventDefault();
      select(tabs[(index + step + tabs.length) % tabs.length], true);
    });
  });
</script>

<style>
  .live-channel-switcher {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .live-channels-heading {
    margin-bottom: 0.7rem;
  }

  .live-channel-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-content: flex-start;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .live-channel-tab:hover,
  .live-channel-tab:focus-visible {
    color: var(--ink);
    border-color: var(--line-strong);
    outline: none;
  }

  .live-channel-tab.is-selected {
    color: var(--ink);
    border-color: var(--wire);
    background: var(--wire-wash);
  }

  .live-channel-logo {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    object-fit: contain;
    opacity: 0.78;
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .live-channel-tab.is-selected .live-channel-logo {
    opacity: 1;
    transform: scale(1.08);
  }

  .live-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.65fr);
    gap: 2rem;
    padding: 2rem 0 3rem;
  }

  .live-player-frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .live-facade {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    align-content: center;
    gap: 1.1rem;
    border: 0;
    cursor: pointer;
    color: #fff;
    background:
      radial-gradient(circle at 50% 42%, rgba(222, 116, 119, 0.18), transparent 60%),
      #0b0d0e;
  }

  .live-facade-logo {
    max-height: 3.2rem;
    width: auto;
    opacity: 0.9;
  }

  .live-facade-play {
    display: grid;
    width: 4.2rem;
    height: 4.2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--wire);
    color: var(--paper);
    transition: transform 0.15s ease;
  }

  .live-facade:hover .live-facade-play,
  .live-facade:focus-visible .live-facade-play {
    transform: scale(1.06);
  }

  .live-facade-label {
    display: grid;
    gap: 0.3rem;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .live-facade-note {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: rgba(255, 255, 255, 0.6);
  }

  .live-player-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .live-player-caption {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.65rem;
  }

  .live-player-caption h2 {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .live-now-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .live-now-title h2 {
    margin: 0;
  }

  .live-now-logo {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
  }

  .live-player-caption a {
    flex: 0 0 auto;
    color: var(--tone);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live-news-column {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }

  .live-news-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink);
  }

  .live-story-list {
    border-top: 0;
  }

  .live-story-list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }

  .live-story-list a {
    display: block;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.25;
  }

  .live-story-list a:hover {
    color: var(--tone);
  }

  .live-story-list span {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .live-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .live-news-column {
      border-top: 1px solid var(--line);
      border-left: 0;
      padding: 1.5rem 0 0;
    }

    .live-channel-switcher {
      margin-bottom: 1.25rem;
    }
  }
</style>
