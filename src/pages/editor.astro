    padding: 0.55rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    border-radius: 0;
    outline: none;
  }
  .ed-input:focus {
    border-color: var(--accent);
  }
  .ed-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
