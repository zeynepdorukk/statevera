---
import EditorLayout from "../layouts/EditorLayout.astro";
import { site } from "../site";
import { root } from "../utils/collection";

// The static publication build has no desk server; local dev does.
const hasServer = import.meta.env.DEV || Boolean(process.env.NETLIFY);
---

<EditorLayout title="Desk">
  <div data-editor-root data-desk={String(hasServer)} data-desk-url={site.deskUrl}>
    <div class="ed-boot">
      <img src={root("/images/branding/logo-mark-light.svg")} alt="" width="34" height="34" />
      <span>Opening the desk</span>
    </div>
  </div>
</EditorLayout>

<style is:global>
  /* ============================================================
     THE DESK — a writing surface, not a form
     ============================================================ */

  .ed-boot {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ed-boot img {
    width: 2.1rem;
    height: 2.1rem;
    animation: ed-breathe 1.7s ease-in-out infinite;
  }
  @keyframes ed-breathe {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ed-boot img {
      animation: none;
    }
  }

  /* ---------- top bar ---------- */
  .ed-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1.1rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .ed-bar-left,
  .ed-bar-right {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .ed-bar-right {
    margin-left: auto;
  }
  .ed-bar-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ed-bar-meta[data-state="error"] {
    color: var(--wire-deep);
  }
  .ed-bar-meta[data-state="ok"] {
    color: var(--journal-deep);
  }

  .ed-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.42rem 0.8rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.13s ease;
    white-space: nowrap;
  }
  .ed-btn:hover:not(:disabled) {
    border-color: var(--ink);
    color: var(--ink);
  }
  .ed-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .ed-btn-primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  .ed-btn-primary:hover:not(:disabled) {
    opacity: 0.86;
    color: var(--paper);
  }
  .ed-btn-quiet {
    border-color: transparent;
    color: var(--muted);
  }

  /* ---------- the page ---------- */
  .ed-page {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 40vh;
  }

  .ed-cover {
    position: relative;
    margin-bottom: 2rem;
    border: 1px dashed var(--line-strong);
    background: var(--paper-soft);
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
  }
  .ed-cover:hover {
    border-color: var(--journal);
  }
  .ed-cover.has-image {
    border-style: solid;
    border-color: var(--line);
    min-height: 0;
    display: block;
  }
  .ed-cover img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ed-cover-hint {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ed-cover-swap {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .ed-cover:hover .ed-cover-swap {
    opacity: 1;
  }

  /* Title and standfirst read exactly as they will on the site. */
  .ed-title,
  .ed-standfirst,
  .ed-body {
    outline: none;
  }
  .ed-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.1rem, 4vw + 0.6rem, 3.1rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }
  .ed-standfirst {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.8rem;
  }

  [data-placeholder]:empty::before,
  .ed-title:empty::before,
  .ed-standfirst:empty::before {
    content: attr(data-placeholder);
    color: var(--muted);
    opacity: 0.55;
    pointer-events: none;
  }

  /* The body inherits the published article typography. */
  .ed-body {
    font-family: var(--font-serif);
    font-size: 1.19rem;
    line-height: 1.72;
    color: var(--ink);
    min-height: 40vh;
  }
  .ed-body > * {
    position: relative;
  }
  .ed-body p {
    margin: 0 0 1.35rem;
  }
  .ed-body h2 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.62rem;
    line-height: 1.2;
    margin: 2.4rem 0 0.85rem;
    letter-spacing: -0.013em;
  }
  .ed-body h3 {
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.25;
    margin: 1.9rem 0 0.75rem;
  }
  .ed-body ul,
  .ed-body ol {
    margin: 0 0 1.35rem;
    padding-left: 1.35rem;
  }
  .ed-body li {
    margin-bottom: 0.45rem;
  }
  .ed-body ul li {
    list-style: disc;
  }
  .ed-body ol li {
    list-style: decimal;
  }
  .ed-body li::marker {
    color: var(--journal);
  }
  .ed-body blockquote {
    margin: 1.7rem 0;
    padding-left: 1.3rem;
    border-left: 3px solid var(--journal);
    font-style: italic;
    font-size: 1.24rem;
    color: var(--ink-soft);
  }
  .ed-body blockquote p {
    margin: 0;
  }
  .ed-body hr {
    border: 0;
    border-top: 1px solid var(--line-strong);
    margin: 2.2rem auto;
    width: 5rem;
  }
  .ed-body a {
    color: var(--journal-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ed-body strong {
    font-weight: 700;
  }
  .ed-body em {
    font-style: italic;
  }
  .ed-body .ed-figure {
    margin: 2rem 0;
  }
  .ed-body .ed-figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .ed-body .ed-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted);
    outline: none;
  }

  .ed-callout {
    margin: 2rem 0;
    border-top: 2px solid var(--journal);
    background: var(--journal-wash);
    padding: 1rem 1.2rem;
  }
  .ed-callout-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--journal-deep);
    margin-bottom: 0.45rem;
    user-select: none;
  }
  .ed-callout-body {
    font-size: 1.03rem;
    line-height: 1.62;
    outline: none;
  }
  .ed-callout-body > *:last-child {
    margin-bottom: 0;
  }

  /* ---------- the inline suggestion ---------- */
  .ed-ghost-text {
    color: var(--muted);
    opacity: 0.62;
    font-style: italic;
  }

  /* ---------- selection toolbar ---------- */
  .ed-float {
    position: absolute;
    z-index: 60;
    display: none;
    align-items: center;
    gap: 1px;
    padding: 3px;
    background: var(--ink);
    border-radius: 3px;
    box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.55);
  }
  .ed-float.is-open {
    display: flex;
  }
  .ed-float button {
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.34rem 0.55rem;
    cursor: pointer;
    border-radius: 2px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .ed-float button:hover,
  .ed-float button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--paper) 16%, transparent);
    color: var(--paper);
  }
  .ed-float .sep {
    width: 1px;
    height: 1.1rem;
    background: color-mix(in srgb, var(--paper) 22%, transparent);
    margin: 0 3px;
  }
  .ed-float input {
    background: color-mix(in srgb, var(--paper) 12%, transparent);
    border: 0;
    outline: none;
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    padding: 0.3rem 0.5rem;
    width: 15rem;
    border-radius: 2px;
  }
  .ed-float input::placeholder {
    color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  /* ---------- insert menu ---------- */
  .ed-add {
    position: absolute;
    left: -2.6rem;
    top: 0;
    width: 1.9rem;
    height: 1.9rem;
    display: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--muted);
    border-radius: 999px;
    cursor: pointer;
    z-index: 30;
  }
  .ed-add.is-open {
    display: flex;
  }
  .ed-add:hover {
    border-color: var(--journal);
    color: var(--journal-deep);
  }

  .ed-menu {
    position: absolute;
    z-index: 70;
    display: none;
    width: 17rem;
    max-height: 20rem;
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    box-shadow: 0 18px 44px -18px rgba(0, 0, 0, 0.45);
  }
  .ed-menu.is-open {
    display: block;
  }
  .ed-menu-head {
    padding: 0.45rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .ed-menu button {
    display: flex;
    width: 100%;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-sans);
  }
  .ed-menu button:hover,
  .ed-menu button.is-active {
    background: var(--paper-soft);
  }
  .ed-menu button .name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }
  .ed-menu button .hint {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .ed-menu button.ed-pick {
    align-items: center;
  }

  /* ---------- say what you want ---------- */
  .ed-menu.is-ask {
    width: min(28rem, calc(100vw - 1.5rem));
    max-height: none;
    overflow: visible;
    border-radius: 10px;
    border-color: color-mix(in srgb, var(--journal) 35%, var(--line-strong));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--journal) 12%, transparent),
      0 22px 50px -20px rgba(0, 0, 0, 0.55);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--journal) 7%, var(--paper)) 0%,
        var(--paper) 3.2rem,
        var(--paper) 100%
      );
  }
  .ed-menu.is-ask .ed-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem 0.55rem;
    border-bottom: 0;
    color: var(--journal-deep);
    letter-spacing: 0.12em;
  }
  .ed-ask-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ed-ask-kicker svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .ed-ask-scope {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.18rem 0.45rem;
  }
  .ed-ask {
    display: block;
    padding: 0 0.85rem 0.85rem;
  }
  .ed-ask-field {
    position: relative;
  }
  .ed-ask textarea {
    display: block;
    width: 100%;
    min-height: 4.4rem;
    max-height: 9rem;
    resize: vertical;
    padding: 0.7rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  .ed-ask textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--journal) 70%, transparent);
    outline-offset: 1px;
    border-color: color-mix(in srgb, var(--journal) 55%, transparent);
  }
  .ed-ask-target {
    margin: 0.65rem 0 0;
    padding: 0.55rem 0.65rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--muted);
  }
  .ed-ask-target strong {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--muted) 85%, var(--journal));
  }
  .ed-ask-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }
  .ed-ask-row .ed-btn-primary {
    background: linear-gradient(180deg, var(--journal-deep), var(--journal));
    border-color: var(--journal);
    color: #1b1e21;
    font-weight: 700;
  }
  .ed-ask-row .ed-btn-primary:hover:not(:disabled) {
    filter: brightness(1.05);
  }
  .ed-ask-hint {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .ed-ask-hint kbd {
    font: inherit;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .ed-ask-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 0.7rem;
  }
  .ed-ask-mode {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 0.28rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ed-ask-mode:hover {
    color: var(--ink-soft);
    border-color: var(--line-strong);
  }
  .ed-ask-mode.is-on {
    color: #1b1e21;
    border-color: var(--journal);
    background: linear-gradient(180deg, var(--journal-deep), var(--journal));
  }
  .ed-ask-answer {
    margin-top: 0.75rem;
    max-height: 16rem;
    overflow-y: auto;
    padding: 0.7rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 3.5%, var(--paper-soft));
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    white-space: pre-wrap;
  }
  .ed-ask-answer p {
    margin: 0 0 0.55rem;
  }
  .ed-ask-answer p:last-child {
    margin-bottom: 0;
  }
  .ed-ask-answer ul {
    margin: 0.35rem 0 0.55rem;
    padding-left: 1.1rem;
  }
  .ed-ask-sources {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }
  .ed-ask-source {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    gap: 0.45rem;
    align-items: start;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper-soft);
  }
  .ed-ask-source input {
    margin-top: 0.2rem;
  }
  .ed-ask-source .name {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--ink);
    line-height: 1.3;
  }
  .ed-ask-source .why {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .ed-ask-source a {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    color: var(--journal-deep);
    text-decoration: none;
    white-space: nowrap;
  }
  .ed-ask-source a:hover {
    text-decoration: underline;
  }
  .ed-ask-busy {
    margin-top: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--journal-deep);
    letter-spacing: 0.04em;
  }
  .ed-float-ai {
    color: var(--journal-deep);
    font-weight: 700;
  }
  .ed-float-ai:hover {
    color: var(--journal);
  }
  .ed-float[data-scope="line"] .block-only {
    display: none;
  }

  /* ---------- the assistant at work, on the words themselves ---------- */
  @keyframes ed-shimmer {
    from { background-position: 180% 0; }
    to { background-position: -80% 0; }
  }
  .ed-working {
    background-image: linear-gradient(
      100deg,
      var(--ink) 0%,
      var(--ink) 38%,
      var(--tone) 50%,
      var(--ink) 62%,
      var(--ink) 100%
    );
    background-size: 260% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: ed-shimmer 1.5s linear infinite;
  }
  @keyframes ed-arrive {
    from {
      background-color: color-mix(in srgb, var(--tone) 30%, transparent);
      filter: blur(1.5px);
      opacity: 0.35;
    }
    40% {
      filter: blur(0);
      opacity: 1;
    }
    to {
      background-color: transparent;
    }
  }
  .ed-arrived {
    animation: ed-arrive 1.05s ease-out;
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ed-working {
      animation: none;
      color: var(--muted);
      -webkit-text-fill-color: var(--muted);
    }
    .ed-arrived {
      animation: none;
    }
  }
  .ed-pick img {
    width: 3.5rem;
    height: 2.6rem;
    object-fit: cover;
    border: 1px solid var(--line);
    background: var(--paper-soft);
    flex: none;
  }
  .ed-pick .name {
    white-space: normal;
    line-height: 1.3;
    word-break: break-word;
  }

  /* ---------- slide-over ---------- */
  .ed-scrim {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    display: none;
  }
  .ed-scrim.is-open {
    display: block;
  }
  .ed-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    width: min(27rem, 100%);
    background: var(--paper);
    border-left: 1px solid var(--line-strong);
    transform: translateX(100%);
    transition: transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
    display: flex;
    flex-direction: column;
  }
  .ed-drawer.is-open {
    transform: translateX(0);
  }
  .ed-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .ed-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.2rem;
  }
  .ed-drawer-foot {
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ed-field + .ed-field {
    margin-top: 1rem;
  }
  .ed-field label,
  .ed-legend {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }
  .ed-field .note {
    margin-top: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.71rem;
    color: var(--muted);
  }
  .ed-input,
  .ed-select {
    width: 100%;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
    padding: 0.5rem 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    border-radius: 2px;
    outline: none;
  }
  .ed-input:focus,
  .ed-select:focus {
    border-color: var(--journal);
  }
  .ed-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  .ed-switch {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    background: var(--paper-soft);
    cursor: pointer;
  }
  .ed-switch input {
    margin-top: 0.15rem;
  }
  .ed-switch .t {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
  }
  .ed-switch .d {
    display: block;
    font-weight: 400;
    font-size: 0.74rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  .ed-warn {
    border: 1px solid var(--wire);
    background: var(--wire-wash);
    color: var(--wire-deep);
    padding: 0.55rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }
  .ed-note {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .ed-note[data-state="error"] {
    color: var(--wire-deep);
  }
  .ed-note[data-state="ok"] {
    color: var(--journal-deep);
  }

  /* ---------- stories ---------- */
  .ed-bar-mark {
    width: 1.35rem;
    height: 1.35rem;
  }
  .ed-stories {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.75rem 1.5rem 6rem;
  }
  .ed-stories-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.9rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .ed-stories-head h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
  }

  .ed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
    gap: 1rem;
  }
  .ed-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 5rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: 4px;
  }
  .ed-empty img {
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.55;
  }
  .ed-empty p {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--muted);
  }
  .ed-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 12.5rem;
    padding: 1rem 1.05rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-soft);
    transition:
      border-color 0.14s ease,
      transform 0.14s ease,
      box-shadow 0.14s ease;
  }
  .ed-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -26px rgb(0 0 0 / 0.9);
  }
  .ed-card:focus-within {
    border-color: var(--journal);
  }
  .ed-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }
  .ed-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    padding: 0.2rem 0.42rem;
    border-radius: 2px;
    border: 1px solid;
  }
  .ed-pill[data-kind="live"] {
    color: var(--journal-deep);
    border-color: color-mix(in srgb, var(--journal) 45%, transparent);
    background: var(--journal-wash);
  }
  .ed-pill[data-kind="draft"] {
    color: var(--muted);
    border-color: var(--line-strong);
    background: transparent;
  }
  .ed-pill[data-kind="edit"] {
    color: var(--wire-deep);
    border-color: color-mix(in srgb, var(--wire) 45%, transparent);
    background: var(--wire-wash);
  }
  .ed-card-desk {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ed-card-title {
    margin: 0;
  }
  .ed-card-open {
    border: 0;
    background: transparent;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.28;
    color: var(--ink);
  }
  /* The whole card opens the piece; Delete sits above it. */
  .ed-card-open::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }
  .ed-card-open:hover {
    color: var(--journal-deep);
  }
  .ed-card-desc {
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ed-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.85rem;
  }
  .ed-card-meta {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ed-card-kill {
    position: relative;
    z-index: 1;
    border: 0;
    background: transparent;
    padding: 0.2rem 0.3rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: transparent;
    transition: color 0.14s ease;
  }
  .ed-card:hover .ed-card-kill,
  .ed-card-kill:focus-visible {
    color: var(--muted);
  }
  .ed-card-kill:hover {
    color: var(--wire-deep);
  }

  .ed-card-ask {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.8rem;
    padding: 1rem 1.05rem;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--wire) 40%, transparent);
    background: var(--paper-tint);
  }
  .ed-card-ask p {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .ed-card-ask-row {
    display: flex;
    gap: 0.5rem;
  }
  .ed-btn-danger {
    border-color: var(--wire);
    background: var(--wire-wash);
    color: var(--wire-deep);
  }
  .ed-btn-danger:hover:not(:disabled) {
    border-color: var(--wire-deep);
    color: var(--wire-deep);
  }

  /* ---------- forms a piece can take ---------- */
  .ed-forms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18.5rem, 1fr));
    gap: 1rem;
  }
  .ed-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-height: 100%;
    height: 100%;
    padding: 1.1rem 1.15rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--paper-soft);
    text-align: left;
    transition:
      border-color 0.14s ease,
      transform 0.14s ease;
  }
  .ed-form:hover {
    border-color: var(--journal);
    transform: translateY(-2px);
  }
  .ed-form-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .ed-form-name {
    font-family: var(--font-serif);
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink);
  }
  /* The name is the whole card: anywhere but Preview starts the piece. */
  .ed-form-use {
    border: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .ed-form-use::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }
  .ed-form:hover .ed-form-use {
    color: var(--journal-deep);
  }
  .ed-form-blurb {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .ed-form-shape {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.35rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }
  .ed-form-shape span {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.16rem 0.36rem;
  }
  .ed-form-peek {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: auto;
    border: 1px solid color-mix(in srgb, var(--journal) 55%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--journal) 22%, transparent),
        color-mix(in srgb, var(--journal) 10%, transparent)
      );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--journal) 35%, transparent),
      0 0 0 0 color-mix(in srgb, var(--journal) 0%, transparent);
    padding: 0.38rem 0.85rem 0.38rem 0.72rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--journal-deep);
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease,
      transform 0.16s ease;
  }
  .ed-form-peek svg {
    width: 0.85rem;
    height: 0.85rem;
    flex: none;
    opacity: 0.95;
  }
  .ed-form-peek:hover {
    color: #1b1e21;
    border-color: var(--journal);
    background: linear-gradient(180deg, var(--journal-deep), var(--journal));
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--journal) 22%, transparent),
      0 8px 18px color-mix(in srgb, var(--journal) 18%, transparent);
    transform: translateY(-1px);
  }
  .ed-form-peek:active {
    transform: translateY(0);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--journal) 18%, transparent),
      0 3px 8px color-mix(in srgb, var(--journal) 14%, transparent);
  }
  .ed-form-peek:focus-visible {
    outline: 2px solid var(--journal);
    outline-offset: 3px;
  }
  .ed-form:hover .ed-form-peek {
    border-color: color-mix(in srgb, var(--journal) 75%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--journal) 40%, transparent),
      0 0 0 3px color-mix(in srgb, var(--journal) 12%, transparent);
  }

  /* ---------- what a form looks like written out ---------- */
  .ed-peek-box {
    width: min(46rem, 100%);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
  }
  .ed-peek-scroll {
    overflow-y: auto;
    background: var(--paper);
  }
  .ed-peek {
    max-width: 34rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
  }
  .ed-peek-lead {
    position: relative;
    margin: 0 0 1.5rem;
    overflow: hidden;
    border-radius: 2px;
    background: var(--paper-soft);
    aspect-ratio: 16 / 9;
  }
  .ed-peek-lead img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ed-peek-credit {
    margin: -1rem 0 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .ed-peek-kicker {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--journal);
  }
  .ed-peek h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .ed-peek-stand {
    margin-top: 0.7rem;
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .ed-peek-byline {
    margin-top: 0.9rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .ed-peek-body {
    margin-top: 1.4rem;
    font-size: 0.98rem;
  }
  .ed-peek-body > * {
    margin-top: 0.9rem;
  }
  .ed-peek-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--line);
  }

  /* ---------- finding a photograph ---------- */
  .ed-modal {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 4vh 1rem;
    background: rgb(0 0 0 / 0.62);
    backdrop-filter: blur(3px);
  }
  .ed-modal-box {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: min(58rem, 100%);
    max-height: 92vh;
    padding: 1.25rem 1.35rem 1.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: var(--paper);
    box-shadow: 0 40px 90px -45px rgb(0 0 0 / 0.95);
  }
  .ed-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ed-photo-form {
    display: flex;
    gap: 0.5rem;
  }
  .ed-photo-form .ed-input {
    flex: 1;
    padding: 0.55rem 0.7rem;
    font-size: 0.9rem;
  }
  .ed-photo-form .ed-input:focus {
    border-color: var(--journal);
  }
  .ed-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    /* Buttons make poor grid items: left to size themselves they collapse their
       own caption to nothing. The row height is stated instead. */
    grid-auto-rows: 12.5rem;
    align-content: start;
    gap: 0.7rem;
    overflow-y: auto;
    padding-right: 0.2rem;
  }
  .ed-photo-grid[data-busy="true"] {
    opacity: 0.45;
    pointer-events: none;
  }
  .ed-photo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper-soft);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.12s ease;
  }
  .ed-photo:hover {
    border-color: var(--journal);
  }
  .ed-photo img {
    width: 100%;
    height: 7rem;
    flex: 0 0 auto;
    object-fit: cover;
    display: block;
    background: var(--paper-tint);
  }
  .ed-photo .t {
    padding: 0 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ed-photo .m {
    padding: 0 0.55rem 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.64rem;
    line-height: 1.35;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ed-cover-ways {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  /* ---------- the gate: every screen shown before the desk opens ---------- */
  .ed-gate {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 3rem 1.25rem;
    overflow: hidden;
  }
  .ed-gate::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(52rem 30rem at 10% 2%, color-mix(in srgb, var(--journal) 10%, transparent), transparent 62%),
      radial-gradient(44rem 26rem at 94% 98%, color-mix(in srgb, var(--wire) 9%, transparent), transparent 58%);
  }
  .ed-gate-inner {
    position: relative;
    width: 100%;
    max-width: 56rem;
    display: grid;
    gap: 2.75rem;
  }
  @media (min-width: 62rem) {
    .ed-gate-inner {
      grid-template-columns: minmax(0, 1fr) 21.5rem;
      gap: 4rem;
      align-items: center;
    }
  }

  .ed-gate-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ed-gate-mark img {
    width: 2.4rem;
    height: 2.4rem;
  }
  .ed-gate-mark span {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--ink);
  }
  .ed-gate-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 1.4rem 0 0;
  }
  .ed-gate-lede {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 34ch;
    margin-top: 0.65rem;
  }
  .ed-gate-pillars {
    list-style: none;
    margin: 1.9rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    max-width: 30rem;
  }
  .ed-gate-pillars li {
    display: grid;
    grid-template-columns: auto 5.4rem 1fr;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .ed-gate-pillars b {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ed-gate-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--muted);
    transform: translateY(-0.1rem);
  }
  .ed-gate-dot[data-p="journal"] {
    background: var(--journal);
  }
  .ed-gate-dot[data-p="wire"] {
    background: var(--wire);
  }
  .ed-gate-dot[data-p="risk"] {
    background: var(--ink-soft);
  }
  .ed-gate-meta {
    margin-top: 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ed-gate-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: color-mix(in srgb, var(--paper-soft) 85%, transparent);
    backdrop-filter: blur(10px);
    padding: 1.7rem 1.5rem 1.4rem;
    box-shadow: 0 30px 70px -40px rgb(0 0 0 / 0.85);
    animation: ed-gate-rise 0.4s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }
  .ed-gate-card::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto;
    height: 2px;
    background: linear-gradient(90deg, var(--wire), var(--journal));
  }
  @keyframes ed-gate-rise {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ed-gate-card {
      animation: none;
    }
  }

  .ed-gate-card h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    margin: 0.15rem 0 0.5rem;
  }
  .ed-gate-say {
    font-family: var(--font-sans);
    font-size: 0.77rem;
    color: var(--muted);
    margin: 0 0 1.15rem;
  }
  .ed-gate .ed-input {
    background: var(--paper-tint);
    padding: 0.6rem 0.7rem;
    font-size: 0.88rem;
    border-radius: 3px;
    transition:
      border-color 0.14s ease,
      box-shadow 0.14s ease;
  }
  .ed-gate .ed-input:focus {
    border-color: var(--journal);
    box-shadow: 0 0 0 3px var(--journal-wash);
  }
  .ed-gate-pw {
    position: relative;
  }
  .ed-gate-pw .ed-input {
    padding-right: 3.6rem;
  }
  .ed-gate-reveal {
    position: absolute;
    right: 0.3rem;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.45rem;
    cursor: pointer;
  }
  .ed-gate-reveal:hover {
    color: var(--ink);
  }
  .ed-gate-go {
    width: 100%;
    justify-content: center;
    margin-top: 1.3rem;
