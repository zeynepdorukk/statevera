---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, type CategorySlug } from "../site";
import { getAllArticles, getAllBriefings, getAllExplainers, getLatestStream, heroImageOf, formatDate, readingTime, root } from "../utils/collection";
import HeadlineItem from "../components/HeadlineItem.astro";

export async function getStaticPaths() {
  return Object.keys(categories).map((slug) => ({ params: { section: slug } }));
}

const { section } = Astro.params;
const meta = categories[section as CategorySlug];
if (!meta || (section !== "latest" && section !== "explainers")) {
  return Astro.redirect(root("/404"));
}

let items: Awaited<ReturnType<typeof getLatestStream>> = [];
let explainerItems: Awaited<ReturnType<typeof getAllExplainers>> = [];

if (section === "latest") {
  items = await getLatestStream(24);
} else {
  explainerItems = await getAllExplainers();
}

const displayItems = items.slice(0, 18);
---

<BaseLayout
  title={meta.name}
  description={meta.description}
  path={meta.url}
>
  <div class="mx-auto max-w-[1400px] px-4 pt-8 md:px-8 md:pt-10">
    <!-- Section header -->
    <header class="border-b-2 border-ink pb-5">
      <h1 class="t-headline-lg">{meta.name}</h1>
      <p class="mt-1 font-sans text-[0.72rem] font-semibold tracking-[0.18em] uppercase text-accent">
        {meta.tagline}
      </p>
      <p class="mt-3 max-w-2xl font-serif text-[1.05rem] leading-relaxed text-ink-soft">
        {meta.description}
      </p>
    </header>

    {section === "explainers" && (
      <div class="py-8">
        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {explainerItems.map((e) => {
            const href = root(`/explainers/${e.id.replace(/\.mdx?$/, "")}`);
            return (
              <article class="group border border-line bg-paper-soft p-5 transition-colors duration-200 hover:border-line-strong">
                <p class="kicker">Reference</p>
                <h2 class="t-headline-xs mt-2">
                  <a href={href} class="editorial-link">{e.data.title}</a>
                </h2>
                <p class="mt-2 line-clamp-2 font-sans text-[0.82rem] leading-relaxed text-muted">
                  {e.data.description}
                </p>
                <p class="meta mt-3">{readingTime(e)} min read</p>
              </article>
            );
          })}
        </div>
      </div>
    )}

    {section === "latest" && (
      <div class="mx-auto max-w-[880px] py-8">
        <div class="divide-y divide-line border-t border-line">
          {displayItems.map((item) =>
            item.kind === "article" ? (
              <HeadlineItem article={item.entry} />
            ) : (
              <div class="flex gap-3 py-3">
                <span class="mt-0.5 shrink-0 font-sans text-[0.72rem] font-semibold text-accent">
                  {formatDate(item.entry.data.timestamp)}
                </span>
                <div>
                  <p class="font-serif text-[0.95rem] leading-snug text-ink-soft">
                    {item.entry.body.trim()}
                  </p>
                  <p class="meta mt-1">
                    {item.entry.data.location} · {item.entry.data.category}
                  </p>
                </div>
              </div>
            )
          )}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
