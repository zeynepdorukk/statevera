---
import BaseLayout from "../layouts/BaseLayout.astro";
import { journalSections } from "../site";
import { getAllExplainers, root } from "../utils/collection";
import JournalCard from "../components/JournalCard.astro";

const meta = journalSections.explainers;
const explainers = await getAllExplainers();
---

<BaseLayout title={meta.name} description={meta.description} path="/explainers" tone="journal">
  <div class="shell pt-7 md:pt-9" data-tone="journal">
    <header class="border-b-2 border-ink pb-5">
      <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="flex items-center gap-2 font-sans text-[0.68rem] font-bold tracking-[0.12em] uppercase">
          <li><a href={root("/journal")} class="text-muted transition-colors hover:text-tone">The Journal</a></li>
          <li aria-hidden="true" class="text-line-strong">/</li>
          <li class="text-tone">{meta.name}</li>
        </ol>
      </nav>
      <h1 class="t-lead">{meta.name}</h1>
      <p class="mt-1.5 font-sans text-[0.72rem] font-bold tracking-[0.16em] uppercase text-tone">
        {meta.tagline}
      </p>
      <p class="mt-3 max-w-3xl font-serif text-[1.06rem] leading-relaxed text-ink-soft">
        {meta.description}
      </p>
      <p class="meta mt-3">{explainers.length} entries</p>
    </header>

    <section class="grid gap-x-8 gap-y-9 py-9 sm:grid-cols-2 lg:grid-cols-3">
      {explainers.map((entry, i) => (
        <JournalCard item={{ kind: "explainer", entry }} variant="feature" priority={i < 3} />
      ))}
    </section>
  </div>
</BaseLayout>
