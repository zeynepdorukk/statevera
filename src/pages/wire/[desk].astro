---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { desks, deskList, type DeskSlug } from "../../site";
import { byCategory, canLead, splitFeatures } from "../../data/wire";
import WireFreshness from "../../components/WireFreshness.astro";
import { getByCategory, root } from "../../utils/collection";
import WireCard from "../../components/WireCard.astro";
import JournalCard from "../../components/JournalCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import MarketTicker from "../../components/MarketTicker.astro";
import { deskText, getLanguage, localizePath } from "../../i18n";

export async function getStaticPaths() {
  return deskList.map((desk) => ({ params: { desk: desk.slug } }));
}

const deskSlug = Astro.params.desk as DeskSlug;
const desk = desks[deskSlug];
const language = getLanguage(Astro.currentLocale);
const localizedDesk = deskText(deskSlug, language);
const copy = language === "tr"
  ? {
      news: "Haberler",
      otherDesks: "Diğer masalar",
      all: "Tümü",
      empty: "Bu masada mevcut haber aralığında içerik bulunmuyor.",
      seeEverything: "Tümünü gör",
      more: `${localizedDesk.name} haberleri`,
      inJournal: "Journal'da",
      archive: "Arşiv",
    }
  : {
      news: "News",
      otherDesks: "Other desks",
      all: "All",
      empty: "Nothing on this desk in the current news window.",
      seeEverything: "See everything",
      more: `More ${localizedDesk.name}`,
      inJournal: "In Journal",
      archive: "Archive",
    };
const hrefFor = (path: string) => root(localizePath(path, language));

const items = byCategory(desk.name);
const leadIndex = Math.max(items.findIndex(canLead), 0);
const lead = items[leadIndex];
const rest = items.filter((_, index) => index !== leadIndex);
const railNews = rest.slice(0, 6);
const mainNews = rest.slice(6);
const deskStream = splitFeatures(mainNews, { max: 6, columns: 2 });
const journalOnDesk = await getByCategory(desk.name, 3, language);
const hasSidebar = railNews.length > 0 || journalOnDesk.length > 0;

const otherDesks = deskList.filter((d) => d.slug !== deskSlug);
---

<BaseLayout
  title={`${localizedDesk.name} — ${copy.news}`}
  description={localizedDesk.description}
  path={`/wire/${desk.slug}`}
  tone="wire"
  noindex
>
  <div class="shell pt-0" data-tone="wire">
    <h1 class="sr-only">{localizedDesk.name} — {localizedDesk.tagline}</h1>
    <div class="news-toolbar">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line py-3">
      <nav aria-label={copy.otherDesks} class="flex flex-wrap gap-x-1 gap-y-1">
        <a href={hrefFor("/wire")} class="desk-pill">{copy.all}</a>
        <span class="desk-pill is-on">{localizedDesk.name}</span>
        {otherDesks.map((other) => (
          <a href={hrefFor(`/wire/${other.slug}`)} class="desk-pill">{deskText(other.slug, language).name}</a>
        ))}
      </nav>
        <WireFreshness />
      </div>
      <MarketTicker />
    </div>

    {items.length === 0 ? (
      <p class="py-14 text-center font-serif text-[1.05rem] text-muted">
        {copy.empty}{" "}
        <a href={hrefFor("/wire")} class="link-tone">{copy.seeEverything} &rarr;</a>
      </p>
    ) : (
      <section
        class:list={[
          "grid gap-x-8 gap-y-10 py-8",
          hasSidebar && "lg:grid-cols-[minmax(0,7.2fr)_minmax(0,2.8fr)]",
        ]}
      >
        <div>
          {lead && <WireCard item={lead} variant="lead" priority headingLevel="h2" />}
          {mainNews.length > 0 && (
            <div class="mt-8 border-t border-line pt-7">
              {deskStream.features.length > 0 && (
                <div class="grid gap-x-7 gap-y-8 sm:grid-cols-2">
                  {deskStream.features.map((item) => (
                    <WireCard item={item} variant="feature" />
                  ))}
                </div>
              )}
              {deskStream.rest.length > 0 && (
                <div class:list={["grid gap-x-7 sm:grid-cols-2", deskStream.features.length > 0 && "mt-8 border-t border-line"]}>
                  {deskStream.rest.map((item) => (
                    <div class="border-b border-line py-4">
                      <WireCard item={item} variant="compact" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>

        {hasSidebar && (
          <aside class="lg:border-l lg:border-line lg:pl-8">
            {railNews.length > 0 && (
              <div class="mb-9" data-tone="wire">
                <SectionHead title={copy.more} tone="wire" href={`/wire/${desk.slug}`} moreLabel={copy.all} />
                <div class="rule-list">
                  {railNews.map((item) => (
                    <WireCard item={item} variant="compact" />
                  ))}
                </div>
              </div>
            )}

            {journalOnDesk.length > 0 && (
              <div data-tone="journal">
              <SectionHead title={copy.inJournal} tone="journal" href="/journal" moreLabel={copy.archive} />
              <div class="rule-list">
                {journalOnDesk.map((entry) => (
                  <JournalCard item={{ kind: "article", entry }} variant="text" />
                ))}
              </div>
              </div>
            )}
          </aside>
        )}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .desk-pill {
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.35rem 0.75rem;
    border: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .desk-pill:hover {
    color: var(--tone);
    border-color: var(--line);
  }
  .desk-pill.is-on {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--paper-soft);
  }
</style>
