---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { desks, deskList, type DeskSlug } from "../../site";
import { byCategory, canLead } from "../../data/wire";
import { getByCategory, root } from "../../utils/collection";
import WireCard from "../../components/WireCard.astro";
import JournalCard from "../../components/JournalCard.astro";
import SectionHead from "../../components/SectionHead.astro";

export async function getStaticPaths() {
  return deskList.map((desk) => ({ params: { desk: desk.slug } }));
}

const deskSlug = Astro.params.desk as DeskSlug;
const desk = desks[deskSlug];

const items = byCategory(desk.name);
const leadIndex = Math.max(items.findIndex(canLead), 0);
const lead = items[leadIndex];
const rest = items.filter((_, index) => index !== leadIndex);
const railNews = rest.slice(0, 6);
const mainNews = rest.slice(6);
const journalOnDesk = await getByCategory(desk.name, 3);
const hasSidebar = railNews.length > 0 || journalOnDesk.length > 0;

const otherDesks = deskList.filter((d) => d.slug !== deskSlug);
---

<BaseLayout
  title={`${desk.name} — News`}
  description={desk.description}
  path={`/wire/${desk.slug}`}
  tone="wire"
>
  <div class="shell pt-0" data-tone="wire">
    <nav aria-label="Other desks" class="flex flex-wrap gap-x-1 gap-y-1 border-b border-line py-3">
      <a href={root("/wire")} class="desk-pill">All</a>
      <span class="desk-pill is-on">{desk.name}</span>
      {otherDesks.map((other) => (
        <a href={root(`/wire/${other.slug}`)} class="desk-pill">{other.name}</a>
      ))}
    </nav>

    {items.length === 0 ? (
      <p class="py-14 text-center font-serif text-[1.05rem] text-muted">
        Nothing on this desk in the current news window.
        <a href={root("/wire")} class="link-tone">See everything &rarr;</a>
      </p>
    ) : (
      <section
        class:list={[
          "grid gap-x-8 gap-y-10 py-8",
          hasSidebar && "lg:grid-cols-[minmax(0,7.2fr)_minmax(0,2.8fr)]",
        ]}
      >
        <div>
          {lead && <WireCard item={lead} variant="lead" priority headingLevel="h2" />}
          {mainNews.length > 0 && (
            <div class="category-stream mt-8 border-t border-line pt-7">
              {mainNews.map((item, i) => (
                <WireCard item={item} variant={item.image && i < 9 ? "feature" : "compact"} showDek={i < 9} />
              ))}
            </div>
          )}
        </div>

        {hasSidebar && (
          <aside class="lg:border-l lg:border-line lg:pl-8">
            {railNews.length > 0 && (
              <div class="mb-9" data-tone="wire">
                <SectionHead title={`More ${desk.name}`} tone="wire" href={`/wire/${desk.slug}`} moreLabel="All" />
                <div class="rule-list">
                  {railNews.map((item) => (
                    <WireCard item={item} variant="compact" />
                  ))}
                </div>
              </div>
            )}

            {journalOnDesk.length > 0 && (
              <div data-tone="journal">
              <SectionHead title="In Journal" tone="journal" href="/journal" moreLabel="Archive" />
              <div class="rule-list">
                {journalOnDesk.map((entry) => (
                  <JournalCard item={{ kind: "article", entry }} variant="text" />
                ))}
              </div>
              </div>
            )}
          </aside>
        )}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .desk-pill {
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.35rem 0.75rem;
    border: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .desk-pill:hover {
    color: var(--tone);
    border-color: var(--line);
  }
  .desk-pill.is-on {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--paper-soft);
  }

  .category-stream {
    columns: 1;
    column-gap: 1.75rem;
  }

  :global(.category-stream > article) {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .category-stream {
      columns: 2;
    }
  }

  @media (min-width: 1280px) {
    .category-stream {
      columns: 3;
    }
  }
</style>
