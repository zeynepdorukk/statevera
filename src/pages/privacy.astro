---
// What the site keeps about readers, in plain words, EN and TR. Every line here
// describes code in this repository: when the code changes, change this page.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { getLanguage } from "../i18n";

const language = getLanguage(Astro.currentLocale);
const updated = "2026-10-17";
const email = site.socialLinks.email;

const copy = language === "tr"
  ? {
      title: "Gizlilik",
      description: "Statevera okuyucular hakkında neyi, neden ve ne kadar süreyle tutar; e-posta listesi, okunma sayıları ve haklarınız.",
      kicker: "Gizlilik bildirimi",
      heading: "Okuyucular hakkında ne tutuyoruz",
      intro: "Kısa cevap: çok az. Çerez, reklam ya da takip pikseli yok. Aşağıda tuttuğumuz her şey ve nedeni var.",
      updatedLabel: "Son güncelleme",
      sections: [
        ["Veri sorumlusu", `Statevera, ${site.authorName} tarafından yayımlanan bağımsız bir yayındır. Gizlilikle ilgili her soru ve talep için: ${email}.`],
        ["E-posta listesi", "Abone olduğunuzda e-posta adresinizi, dil tercihinizi, kayıt tarihini ve kaydolduğunuz sayfayı saklarız. Bunlar yalnızca yeni yazılar yayımlandığında size e-posta göndermek için kullanılır; satılmaz, paylaşılmaz. Kayıt, açık onayınıza dayanır: önce bir onay e-postası göndeririz ve bağlantıya tıklamazsanız adresiniz 7 gün içinde kendiliğinden silinir. Onaylanan kayıt listeden çıkana kadar tutulur. Her e-postanın altındaki bağlantıyla tek tıkla çıkabilir ya da bize yazabilirsiniz; adresiniz hemen silinir. Liste Cloudflare altyapısında (Workers KV) tutulur; e-postalar Resend (AB bölgesi) üzerinden gönderilir. E-postalarda izleme pikseli ya da tıklama takibi yoktur."],
        ["Okunma sayıları", "Bir Journal yazısını açtığınızda tarayıcınız rastgele bir kimlik oluşturup kendi deposunda (localStorage) saklar. Bu kimlik, yazının adresi ve sizi yönlendiren sitenin adıyla birlikte gönderilir; sunucuda kimlik yalnızca karma (hash) olarak tutulur, ülkeniz bağlantınızdan çıkarılır. Amaç, aynı okuyucuyu iki kez saymadan bir yazının kaç kişiye ulaştığını görmektir. Adınız, e-postanız ya da IP adresiniz bu kayıtla saklanmaz."],
        ["Paylaşım bağlantıları", "Paylaş düğmeleri bağlantıya kaynak etiketi (utm_source) ekler; böylece bir okumanın WhatsApp'tan mı LinkedIn'den mi geldiğini görebiliriz. Etiket, sayfa açıldığında adres çubuğundan silinir."],
        ["Hız ölçümü", "Ziyaretlerin yaklaşık beşte birinde sayfa, ne kadar hızlı yüklendiğini (Core Web Vitals) sayfa yolu ve cihaz türüyle (mobil ya da masaüstü) birlikte gönderir. Bu ölçümler kimlik içermez ve saklanmaz; yalnızca kısa süreli sunucu kayıtlarında görünür."],
        ["Başka sitelerin içerikleri", "Haber görselleri özgün yayıncılarından yüklenir. Canlı sayfasındaki YouTube yayını, siz oynatmaya basana kadar yüklenmez. GLORISK aracı GitHub Pages üzerinden gömülüdür. Bu siteler kendi gizlilik kurallarını uygular."],
        ["Barındırma", "Site GitHub Pages'te, küçük API'si Cloudflare'de çalışır. Her iki hizmet de güvenlik ve işletim için standart erişim kayıtları tutar."],
        ["Haklarınız", `KVKK ve GDPR kapsamında hakkınızdaki veriye erişme, düzeltilmesini ya da silinmesini isteme ve onayınızı geri çekme hakkınız vardır. ${email} adresine yazmanız yeterli.`],
      ],
    }
  : {
      title: "Privacy",
      description: "What Statevera keeps about readers, why, and for how long: the mailing list, read counts and your rights.",
      kicker: "Privacy notice",
      heading: "What we keep about readers",
      intro: "The short answer: very little. No cookies, no ads, no tracking pixels. Everything we do keep, and why, is below.",
      updatedLabel: "Last updated",
      sections: [
        ["Who is responsible", `Statevera is an independent publication by ${site.authorName}. For any privacy question or request: ${email}.`],
        ["The mailing list", "When you subscribe we keep your email address, your language, the date and the page you signed up on. They are used only to email you when new pieces are published, and are never sold or shared. Signing up rests on your explicit consent: we first send a confirmation email, and an address that is not confirmed deletes itself within 7 days. A confirmed address is kept until you leave. Leave with one click from the link at the bottom of every email, or write to us; the address is deleted straight away. The list is held on Cloudflare (Workers KV) and emails are sent through Resend (EU region). The emails carry no tracking pixels or click tracking."],
        ["Read counts", "When you open a Journal piece, your browser makes a random identifier and keeps it in its own storage (localStorage). It is sent with the piece's address and the name of the site that sent you; the server keeps the identifier only as a hash, and your country is read from the connection. The point is to see how many people a piece reached without counting anyone twice. Your name, email and IP address are not stored with it."],
        ["Share links", "The share buttons add a source tag (utm_source) to the link, so we can see whether a read came from WhatsApp or LinkedIn. The tag is removed from the address bar as the page opens."],
        ["Speed measurements", "On about one visit in five, the page reports how fast it loaded (Core Web Vitals) with its path and the device type (mobile or desktop). These carry no identifier and are not stored; they appear only in short-lived server logs."],
        ["Other sites' content", "News images load from their original publishers. The YouTube stream on the Live page does not load until you press play. The GLORISK tool is embedded from GitHub Pages. Those sites apply their own privacy rules."],
        ["Hosting", "The site runs on GitHub Pages and its small API on Cloudflare. Both keep standard access logs for security and operations."],
        ["Your rights", `Under the GDPR and Türkiye's KVKK you can ask to see, correct or delete what we hold about you, and withdraw your consent at any time. Write to ${email}.`],
      ],
    };

const dateLabel = new Intl.DateTimeFormat(language === "tr" ? "tr-TR" : "en-GB", { dateStyle: "long", timeZone: "UTC" }).format(new Date(updated));
---

<BaseLayout title={copy.title} description={copy.description} path="/privacy">
  <div class="shell max-w-[860px] pt-0" data-tone="journal">
    <header class="border-b-2 border-ink py-10 md:py-14">
      <p class="kicker-ink">{copy.kicker}</p>
      <h1 class="t-lead mt-1.5">{copy.heading}</h1>
      <p class="mt-3 max-w-2xl font-serif text-[1.08rem] leading-relaxed text-ink-soft">{copy.intro}</p>
      <p class="meta mt-4">{copy.updatedLabel}: <time datetime={updated}>{dateLabel}</time></p>
    </header>

    <div class="max-w-[720px] divide-y divide-line">
      {copy.sections.map(([heading, body]) => (
        <section class="py-7">
          <h2 class="t-headline-sm">{heading}</h2>
          <p class="mt-2 font-serif text-[1.02rem] leading-relaxed text-ink-soft">{body}</p>
        </section>
      ))}
    </div>
    <p class="py-8 font-sans text-[0.85rem] text-muted">
      <a href={`mailto:${email}`} class="link-tone underline underline-offset-2">{email}</a>
    </p>
  </div>
</BaseLayout>
