---
import { readdirSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { root } from "../utils/collection";
import { PRIMARY_SOURCE_TYPES } from "../primary-sources/types";
import { SOURCE_ADAPTERS } from "../primary-sources/adapters";
import { getLanguage } from "../i18n";

const language = getLanguage(Astro.currentLocale);
const copy = language === "tr"
  ? {
      title: "Birincil Kaynaklar",
      description: "İkinci el başlıklar yerine hükümetlerin ve uluslararası kurumların resmî belgelerinde arama yapın.",
      kicker: "Statevera Araştırma · Doğrulama masası",
      heading: "Resmî kayıtlarda ara",
      note: "Haberin arkasındaki belgeyi bulun: açıklamalar, mevzuat, antlaşmalar ve resmî veriler, yayımlayan kuruma doğrudan bağlı.",
      queryLabel: "Anahtar kelime veya konu",
      placeholder: "Örnek: yaptırımlar, Ukrayna, enerji güvenliği…",
      submit: "Resmî kaynaklarda ara",
      filterLabel: "Belge türüne göre filtrele",
      all: "Tümü",
      types: {
        Documents: "Belgeler",
        Statements: "Açıklamalar",
        Legislation: "Mevzuat",
        Treaties: "Antlaşmalar",
        Sanctions: "Yaptırımlar",
        Speeches: "Konuşmalar",
        "Official Data": "Resmî Veriler",
      },
      map: "Kaynak haritası",
      institutions: "İlk sürümdeki kurumlar",
      adapters: "Bağdaştırıcılar birbirinden bağımsızdır; böylece arama arayüzü değiştirilmeden yeni resmî kaynaklar eklenebilir.",
      runtime: {
        dateMissing: "Tarih belirtilmemiş",
        officialWebsite: "Resmî kurum sitesi",
        defaultSnippet: "Resmî kayıt kaynak kurumda mevcuttur.",
        officialRecord: "Resmî kayıt",
        openAtSource: "Resmî kaynakta aç:",
        openDocument: "Resmî belgeyi aç",
        linkUnavailable: "Resmî bağlantı kullanılamıyor",
        primarySource: "Birincil kaynak",
        officialSource: "Resmî kaynak",
        issuedBy: "Yukarıdaki kurum tarafından yayımlandı",
        document: "Belge",
        recordId: "Kayıt No",
        empty: "Bu aramayla eşleşen resmî kayıt bulunamadı. Daha geniş bir anahtar kelime veya başka bir belge türü deneyin.",
        minQuery: "Resmî kayıtlarda arama yapmak için en az iki karakter girin.",
        endpointMissing: "Resmî kaynak arama uç noktası yapılandırılmamış.",
        checking: "Resmî kaynaklar kontrol ediliyor…",
        checkingAcross: "kurumda resmî kaynaklar kontrol ediliyor",
        unavailable: "Kaynak araması şu anda kullanılamıyor. Lütfen kısa süre sonra yeniden deneyin.",
        recordsShown: "kayıt gösteriliyor",
        totalMatches: "toplam eşleşme",
        institutionsAnswered: "kurum yanıt verdi",
      },
    }
  : {
      title: "Primary Sources",
      description: "Search official documents from governments and international institutions — not second-hand headlines.",
      kicker: "Statevera Research · Verification desk",
      heading: "Search official records",
      note: "Find the document behind the headline — statements, legislation, treaties and official data, linked to the institution that issued it.",
      queryLabel: "Keyword or topic",
      placeholder: "Try: sanctions, Ukraine, energy security…",
      submit: "Search official sources",
      filterLabel: "Filter by document type",
      all: "All",
      types: Object.fromEntries(PRIMARY_SOURCE_TYPES.map((type) => [type, type])),
      map: "The source map",
      institutions: "Institutions in this first release",
      adapters: "Adapters are independent, so new official sources can be added without changing the search interface.",
      runtime: {
        dateMissing: "Date not listed",
        officialWebsite: "Official institution website",
        defaultSnippet: "Official record available at the source institution.",
        officialRecord: "Official record",
        openAtSource: "Open at the official source:",
        openDocument: "Open official document",
        linkUnavailable: "Official link unavailable",
        primarySource: "Primary source",
        officialSource: "Official source",
        issuedBy: "Issued by the institution above",
        document: "Document",
        recordId: "Record ID",
        empty: "No official records matched this search. Try a broader keyword or another document type.",
        minQuery: "Enter at least two characters to search official records.",
        endpointMissing: "The official-source endpoint is not configured.",
        checking: "Checking official sources…",
        checkingAcross: "institutions are being checked",
        unavailable: "The source search is unavailable. Try again shortly.",
        recordsShown: "records shown",
        totalMatches: "total matches",
        institutionsAnswered: "institutions answered",
      },
    };

const endpoint = import.meta.env.DEV
  ? root("/api/primary-sources")
  : site.deskUrl && `${site.deskUrl}/api/primary-sources`;

// The adapters are the list. Naming the institutions twice is how a source map
// starts lying about what the desk actually queries.
const logoFiles = readdirSync(resolve(process.cwd(), "public/images/sources"));
const marks = SOURCE_ADAPTERS.map((adapter) => {
  const file = logoFiles.find((name) => name.replace(/\.[^.]+$/, "") === adapter.id);
  return {
    id: adapter.id,
    name: adapter.institution,
    // An adapter names itself for the log; a tile has room for the institution.
    short: adapter.institution.split(" / ")[0],
    organization: adapter.organization,
    logo: file ? root(`/images/sources/${file}`) : "",
  };
});
---


<BaseLayout
  title={copy.title}
  description={copy.description}
  path="/sources"
  hideTicker
>
  <div class="shell primary-sources-page" data-primary-sources data-endpoint={endpoint} data-language={language} data-source-copy={JSON.stringify(copy.runtime)} data-source-types={JSON.stringify(copy.types)}>
    <section class="primary-sources-tool" aria-labelledby="search-heading">
      <div class="primary-sources-search-head">
        <div>
          <p class="kicker-ink">{copy.kicker}</p>
          <h1 id="search-heading" class="t-headline mt-1">{copy.heading}</h1>
        </div>
        <p class="primary-sources-note">{copy.note}</p>
      </div>

      <form class="primary-source-form" data-primary-source-form>
        <label class="sr-only" for="primary-source-query">{copy.queryLabel}</label>
        <input
          id="primary-source-query"
          name="q"
          type="search"
          minlength="2"
          maxlength="160"
          autocomplete="off"
          placeholder={copy.placeholder}
          data-primary-source-input
        />
        <button type="submit" class="primary-source-submit" data-primary-source-submit>{copy.submit}</button>
      </form>

      <div class="primary-source-filters" role="group" aria-label={copy.filterLabel}>
        <button type="button" class="source-filter is-active" data-source-filter="All" aria-pressed="true">{copy.all}</button>
        {PRIMARY_SOURCE_TYPES.map((type) => (
          <button type="button" class="source-filter" data-source-filter={type} aria-pressed="false">{copy.types[type]}</button>
        ))}
      </div>

      <div class="source-poll" data-source-poll hidden>
        {marks.map((mark, index) => (
          <span class="source-poll-mark" data-poll-id={mark.id} data-state="waiting" style={`--i:${index}`}>
            <img src={mark.logo} alt="" loading="lazy" decoding="async" width="24" height="24" />
            <span class="source-poll-name">{mark.short}</span>
          </span>
        ))}
      </div>

      <p class="primary-source-status" data-primary-source-status aria-live="polite"></p>
      <div class="primary-source-results" data-primary-source-results aria-live="polite"></div>
    </section>

    <section class="primary-source-directory border-t-2 border-ink" aria-labelledby="directory-heading">
      <div class="primary-source-directory-head">
        <div>
          <p class="kicker-ink">{copy.map}</p>
          <h2 id="directory-heading" class="t-headline mt-1">{copy.institutions}</h2>
        </div>
        <p class="primary-sources-note">{copy.adapters}</p>
      </div>
      <ul class="source-map">
        {marks.map((mark) => (
          <li class="source-map-item" title={mark.name}>
            <span class="source-map-mark">
              <img src={mark.logo} alt="" loading="lazy" decoding="async" width="52" height="52" />
            </span>
            <span class="source-map-name">{mark.short}</span>
            <span class="sr-only">{mark.name} — {mark.organization}</span>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>

<script src="../scripts/primary-sources.ts"></script>

<style>
  .primary-sources-page {
    padding-bottom: 0;
  }

  .primary-sources-tool {
    padding: 1.8rem 0 2rem;
  }

  .primary-sources-search-head,
  .primary-source-directory-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .primary-sources-note {
    max-width: 24rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.73rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .primary-source-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    max-width: 58rem;
  }

  .primary-source-form input {
    min-width: 0;
    border: 1px solid var(--line-strong);
    border-bottom: 2px solid var(--ink);
    padding: 0.9rem 0.95rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    outline: none;
  }

  .primary-source-form input:focus {
    border-color: var(--wire);
  }

  .primary-source-submit {
    border: 1px solid var(--ink);
    background: var(--ink);
    padding: 0.9rem 1.1rem;
    color: var(--paper);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 150ms ease, color 150ms ease;
  }

  .primary-source-submit:hover,
  .primary-source-submit:focus-visible {
    background: var(--wire);
    border-color: var(--wire);
    outline: none;
  }

  .primary-source-submit:disabled {
    cursor: wait;
    opacity: 0.9;
  }

  .primary-source-submit[data-state="loading"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: var(--wire);
    border-color: var(--wire);
  }

  .primary-source-submit[data-state="loading"]::before {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
    border-top-color: var(--paper);
    border-radius: 999px;
    content: "";
    animation: primary-source-spin 800ms linear infinite;
  }

  .primary-source-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .source-filter {
    border: 1px solid var(--line);
    background: transparent;
    padding: 0.42rem 0.62rem;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-filter:hover,
  .source-filter:focus-visible,
  .source-filter.is-active {
    border-color: var(--ink);
    color: var(--ink);
    outline: none;
  }

  .source-filter.is-active {
    background: var(--paper-tint);
  }

  .primary-source-status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 1.4rem;
    margin: 1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--muted);
  }

  /* Nothing has been asked yet, so there is nothing to report and no rule to draw. */
  .primary-source-status:empty {
    display: none;
  }

  /* The typed line starts empty, so it must not blink out of existence first. */
  .primary-source-status[data-state="loading"]:empty {
    display: flex;
  }

  /* A caret, because the line is being written rather than shown. */
  .primary-source-status[data-state="loading"]::after {
    width: 0.42rem;
    height: 0.95em;
    flex: 0 0 auto;
    margin-left: -0.35rem;
    background: currentColor;
    content: "";
    animation: source-caret 900ms steps(2, jump-none) infinite;
  }

  @keyframes source-caret {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .primary-source-status[data-state="loading"] {
    color: var(--ink-soft);
  }

  .primary-source-status[data-state="error"] {
    color: var(--wire);
  }

  /* The wait is the search reaching twelve institutions, so it shows them. */
  .source-poll {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    max-width: 100%;
    margin-top: 1.15rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line);
    background: var(--paper-soft);
  }

  .source-poll[hidden] {
    display: none;
  }

  .source-poll-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    background: #f2f0e9;
  }

  .source-poll-mark img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.3;
    transition: opacity 200ms ease, filter 200ms ease;
  }

  .source-poll-mark[data-state="waiting"] img {
    animation: source-poll-pulse 1.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 90ms);
  }

  .source-poll-mark[data-state="ok"] {
    border-color: var(--line-strong);
  }

  .source-poll-mark[data-state="ok"] img {
    filter: none;
    opacity: 1;
  }

  .source-poll-mark[data-state="silent"] img {
    opacity: 0.18;
  }

  /* The count sits on the mark, so twelve institutions stay one glance wide. */
  .source-poll-mark[data-count]::after {
    position: absolute;
    right: -0.3rem;
    bottom: -0.4rem;
    padding: 0 0.22rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink);
    content: attr(data-count);
  }

  .source-poll-name {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease;
  }

  .source-poll-mark:hover .source-poll-name {
    opacity: 1;
  }

  @keyframes source-poll-pulse {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.85;
      filter: grayscale(0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-source-submit[data-state="loading"]::before,
    .primary-source-status[data-state="loading"]::after,
    .source-poll-mark[data-state="waiting"] img {
      animation: none;
    }
  }

  :global(.primary-source-results) {
    margin-top: 1.35rem;
    border-top: 1px solid var(--line-strong);
  }

  :global(.primary-source-results:empty) {
    margin-top: 0;
    border-top: 0;
  }

  :global(.primary-source-result) {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 2.2rem;
    align-items: start;
    padding: 1.45rem 0 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.primary-source-result-source) {
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--muted);
  }

  :global(.primary-source-result-source strong),
  :global(.primary-source-result-source > span:not(.primary-source-result-eyebrow):not(.primary-source-result-index)) {
    display: block;
  }

  :global(.primary-source-result-source strong) {
    margin-top: 0.35rem;
    color: var(--ink);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  :global(.primary-source-result-eyebrow) {
    display: block;
    color: var(--wire-deep);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  :global(.primary-source-result-index) {
    display: block;
    margin-top: 1.4rem;
    color: var(--line-strong);
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1;
  }

  :global(.primary-source-result-body) {
    min-width: 0;
  }

  :global(.primary-source-result-title) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.18rem, 1.8vw, 1.52rem);
    line-height: 1.2;
    color: var(--ink);
  }

  :global(.primary-source-result-title a) {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  :global(.primary-source-result-title a:hover),
  :global(.primary-source-result-title a:focus-visible) {
    color: var(--wire-deep);
    text-decoration: underline;
    outline: none;
  }

  :global(.primary-source-result-snippet) {
    max-width: 52rem;
    margin: 0.55rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.94rem;
    line-height: 1.52;
    color: var(--ink-soft);
  }

  :global(.primary-source-result-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    line-height: 1.45;
    color: var(--muted);
  }

  :global(.primary-source-result-type) {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.primary-source-result-id) {
    overflow-wrap: anywhere;
  }

  :global(.primary-source-result-action) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-hair);
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  :global(.primary-source-result-action span) {
    color: var(--wire-deep);
    font-size: 0.9rem;
    line-height: 1;
  }

  :global(.primary-source-result-action:hover) {
    color: var(--wire);
  }

  :global(.primary-source-result-action.is-unavailable) {
    color: var(--muted);
    cursor: not-allowed;
  }

  :global(.primary-source-empty) {
    border-top: 1px solid var(--line);
    padding: 2rem 0;
    font-family: var(--font-serif);
    color: var(--muted);
  }

  /* The last section carries the space before the footer; the page adds none. */
  .primary-source-directory {
    padding: 2.4rem 0 2rem;
  }

  /* Twelve marks drawn by twelve different design offices only look like a set
     if they are held to one size and one colour until you point at them. */
  .source-map {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .source-map-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    min-height: 8.2rem;
    padding: 1.35rem 0.65rem 1.1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
    transition: background-color 160ms ease;
  }

  .source-map-item:hover {
    background: var(--paper-soft);
  }

  .source-map-mark {
    display: grid;
    place-items: center;
    width: 4.1rem;
    height: 4.1rem;
    padding: 0.62rem;
    /* Half these marks are dark on transparent and half are light on white, so
       on a dark page they either vanish or glare. One plate settles both. */
    background: #f2f0e9;
    border: 1px solid var(--line);
  }

  .source-map-mark img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.82;
    transition: filter 200ms ease, opacity 200ms ease, transform 200ms ease;
  }

  .source-map-item:hover .source-map-mark img {
    filter: none;
    opacity: 1;
    transform: scale(1.06);
  }

  .source-map-name {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .primary-sources-search-head,
    .primary-source-directory-head {
      display: block;
    }

    .primary-sources-note {
      margin-top: 0.7rem;
    }

    .primary-source-form {
      grid-template-columns: 1fr;
    }

    :global(.primary-source-result) {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    :global(.primary-source-result-index) {
      margin-top: 0.9rem;
    }

    :global(.primary-source-result-action) {
      align-self: start;
    }

    .source-map {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .source-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
