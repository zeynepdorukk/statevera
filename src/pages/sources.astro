---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";
import { root } from "../utils/collection";
import { PRIMARY_SOURCE_TYPES } from "../primary-sources/types";

const endpoint = import.meta.env.DEV
  ? root("/api/primary-sources")
  : `${site.deskUrl}/api/primary-sources`;

const institutions = [
  ["United Nations", "UN Official Document System"],
  ["EUR-Lex", "EU law and official documents"],
  ["European Council / Consilium", "Council conclusions and statements"],
  ["EEAS", "EU diplomatic statements and publications"],
  ["NATO", "Official texts and transcripts"],
  ["U.S. GovInfo", "U.S. government publications"],
  ["Federal Register", "Rules, notices and presidential documents"],
  ["Congress.gov", "Bills and congressional action"],
  ["GOV.UK", "UK government publications and data"],
  ["Türkiye Ministry of Foreign Affairs", "Foreign ministry statements"],
  ["TBMM", "Parliamentary publications"],
  ["OSCE", "Decisions, statements and documents"],
] as const;
---

<BaseLayout
  title="Primary Sources"
  description="Search official documents from governments and international institutions — not second-hand headlines."
  path="/sources"
  hideTicker
>
  <div class="shell primary-sources-page" data-primary-sources data-endpoint={endpoint}>
    <section class="primary-sources-intro border-b-2 border-ink" aria-labelledby="primary-sources-title">
      <div class="primary-sources-compact-intro">
        <div>
          <p class="kicker-ink">Statevera Research · Verification desk</p>
          <h1 id="primary-sources-title" class="t-headline mt-1">Search official records</h1>
        </div>
        <p class="primary-sources-compact-copy">
          Find the document behind the headline — statements, legislation, treaties and official data, linked to the institution that issued it.
        </p>
      </div>
    </section>

    <section class="primary-sources-tool" aria-labelledby="search-heading">
      <div class="primary-sources-search-head">
        <div>
          <p class="kicker">Search the archive</p>
          <h2 id="search-heading" class="t-headline mt-1">Search by keyword</h2>
        </div>
        <p class="primary-sources-note">Search terms are sent to the Statevera server, never to a browser-side API key.</p>
      </div>

      <form class="primary-source-form" data-primary-source-form>
        <label class="sr-only" for="primary-source-query">Keyword or topic</label>
        <input
          id="primary-source-query"
          name="q"
          type="search"
          minlength="2"
          maxlength="160"
          autocomplete="off"
          placeholder="Try: sanctions, Ukraine, energy security…"
          data-primary-source-input
        />
        <button type="submit" class="primary-source-submit" data-primary-source-submit>Search official sources</button>
      </form>

      <div class="primary-source-filters" role="group" aria-label="Filter by document type">
        <button type="button" class="source-filter is-active" data-source-filter="All" aria-pressed="true">All</button>
        {PRIMARY_SOURCE_TYPES.map((type) => (
          <button type="button" class="source-filter" data-source-filter={type} aria-pressed="false">{type}</button>
        ))}
      </div>

      <p class="primary-source-status" data-primary-source-status aria-live="polite">
        Enter a keyword to search official records across 12 institutions.
      </p>
      <div class="primary-source-results" data-primary-source-results aria-live="polite"></div>
    </section>

    <section class="primary-source-directory border-t-2 border-ink" aria-labelledby="directory-heading">
      <div class="primary-source-directory-head">
        <div>
          <p class="kicker-ink">The source map</p>
          <h2 id="directory-heading" class="t-headline mt-1">Institutions in this first release</h2>
        </div>
        <p class="primary-sources-note">Adapters are independent, so new official sources can be added without changing the search interface.</p>
      </div>
      <ul class="primary-source-directory-list">
        {institutions.map(([name, detail]) => (
          <li>
            <span class="primary-source-directory-name">{name}</span>
            <span>{detail}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="primary-source-principle" aria-label="Primary source principle">
      <p class="kicker-ink">A source-first workflow</p>
      <p class="primary-source-principle-copy">News tells you what happened. The Journal asks what it means. Primary Sources let you read the record as it was issued.</p>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/primary-sources.ts"></script>

<style>
  .primary-sources-page {
    padding-bottom: 5rem;
  }

  .primary-sources-intro {
    padding: 1.2rem 0 1.35rem;
  }

  .primary-sources-compact-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    align-items: end;
    gap: 2rem;
  }

  .primary-sources-compact-copy {
    max-width: 28rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .primary-sources-tool {
    padding: 1.8rem 0 3.6rem;
  }

  .primary-sources-search-head,
  .primary-source-directory-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  .primary-sources-note {
    max-width: 24rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.73rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .primary-source-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    max-width: 58rem;
  }

  .primary-source-form input {
    min-width: 0;
    border: 1px solid var(--line-strong);
    border-bottom: 2px solid var(--ink);
    padding: 0.9rem 0.95rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    outline: none;
  }

  .primary-source-form input:focus {
    border-color: var(--wire);
  }

  .primary-source-submit {
    border: 1px solid var(--ink);
    background: var(--ink);
    padding: 0.9rem 1.1rem;
    color: var(--paper);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 150ms ease, color 150ms ease;
  }

  .primary-source-submit:hover,
  .primary-source-submit:focus-visible {
    background: var(--wire);
    border-color: var(--wire);
    outline: none;
  }

  .primary-source-submit:disabled {
    cursor: wait;
    opacity: 0.9;
  }

  .primary-source-submit[data-state="loading"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: var(--wire);
    border-color: var(--wire);
  }

  .primary-source-submit[data-state="loading"]::before {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--paper) 45%, transparent);
    border-top-color: var(--paper);
    border-radius: 999px;
    content: "";
    animation: primary-source-spin 800ms linear infinite;
  }

  .primary-source-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .source-filter {
    border: 1px solid var(--line);
    background: transparent;
    padding: 0.42rem 0.62rem;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-filter:hover,
  .source-filter:focus-visible,
  .source-filter.is-active {
    border-color: var(--ink);
    color: var(--ink);
    outline: none;
  }

  .source-filter.is-active {
    background: var(--paper-tint);
  }

  .primary-source-status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 1.4rem;
    margin: 1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .primary-source-status[data-state="loading"] {
    color: var(--ink-soft);
  }

  .primary-source-status[data-state="loading"]::before {
    width: 0.78rem;
    height: 0.78rem;
    flex: 0 0 auto;
    border: 1px solid var(--line-strong);
    border-top-color: var(--wire);
    border-radius: 999px;
    content: "";
    animation: primary-source-spin 800ms linear infinite;
  }

  .primary-source-status[data-state="loading"]::after {
    width: 3.2rem;
    height: 2px;
    flex: 0 0 auto;
    background: linear-gradient(90deg, transparent, var(--wire), transparent);
    content: "";
    animation: primary-source-scan 1.4s ease-in-out infinite;
  }

  .primary-source-status[data-state="error"] {
    color: var(--wire);
  }

  @keyframes primary-source-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes primary-source-scan {
    0%,
    100% {
      opacity: 0.25;
      transform: scaleX(0.55);
    }
    50% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-source-submit[data-state="loading"]::before,
    .primary-source-status[data-state="loading"]::before,
    .primary-source-status[data-state="loading"]::after {
      animation: none;
    }
  }

  :global(.primary-source-results) {
    margin-top: 1.35rem;
    border-top: 1px solid var(--line-strong);
  }

  :global(.primary-source-result) {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 2.2rem;
    align-items: start;
    padding: 1.45rem 0 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.primary-source-result-source) {
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.45;
    color: var(--muted);
  }

  :global(.primary-source-result-source strong),
  :global(.primary-source-result-source > span:not(.primary-source-result-eyebrow):not(.primary-source-result-index)) {
    display: block;
  }

  :global(.primary-source-result-source strong) {
    margin-top: 0.35rem;
    color: var(--ink);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  :global(.primary-source-result-eyebrow) {
    display: block;
    color: var(--wire-deep);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  :global(.primary-source-result-index) {
    display: block;
    margin-top: 1.4rem;
    color: var(--line-strong);
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1;
  }

  :global(.primary-source-result-body) {
    min-width: 0;
  }

  :global(.primary-source-result-title) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.18rem, 1.8vw, 1.52rem);
    line-height: 1.2;
    color: var(--ink);
  }

  :global(.primary-source-result-title a) {
    color: inherit;
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  :global(.primary-source-result-title a:hover),
  :global(.primary-source-result-title a:focus-visible) {
    color: var(--wire-deep);
    text-decoration: underline;
    outline: none;
  }

  :global(.primary-source-result-snippet) {
    max-width: 52rem;
    margin: 0.55rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.94rem;
    line-height: 1.52;
    color: var(--ink-soft);
  }

  :global(.primary-source-result-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.66rem;
    line-height: 1.45;
    color: var(--muted);
  }

  :global(.primary-source-result-type) {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.primary-source-result-id) {
    overflow-wrap: anywhere;
  }

  :global(.primary-source-result-action) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-hair);
    font-family: var(--font-sans);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  :global(.primary-source-result-action span) {
    color: var(--wire-deep);
    font-size: 0.9rem;
    line-height: 1;
  }

  :global(.primary-source-result-action:hover) {
    color: var(--wire);
  }

  :global(.primary-source-result-action.is-unavailable) {
    color: var(--muted);
    cursor: not-allowed;
  }

  :global(.primary-source-empty) {
    border-top: 1px solid var(--line);
    padding: 2rem 0;
    font-family: var(--font-serif);
    color: var(--muted);
  }

  .primary-source-directory {
    padding: 2.4rem 0 3rem;
  }

  .primary-source-directory-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .primary-source-directory-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-height: 5.2rem;
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .primary-source-directory-name {
    font-weight: 700;
    color: var(--ink);
  }

  .primary-source-principle {
    max-width: 48rem;
    border-left: 3px solid var(--risk);
    padding: 0.2rem 0 0.2rem 1rem;
  }

  .primary-source-principle-copy {
    margin: 0.45rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .primary-sources-compact-intro {
      display: block;
    }

    .primary-sources-compact-copy {
      margin-top: 0.65rem;
    }

    .primary-sources-search-head,
    .primary-source-directory-head {
      display: block;
    }

    .primary-sources-note {
      margin-top: 0.7rem;
    }

    .primary-source-form {
      grid-template-columns: 1fr;
    }

    :global(.primary-source-result) {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    :global(.primary-source-result-index) {
      margin-top: 0.9rem;
    }

    :global(.primary-source-result-action) {
      align-self: start;
    }

    .primary-source-directory-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .primary-source-directory-list {
      grid-template-columns: 1fr;
    }
  }
</style>
