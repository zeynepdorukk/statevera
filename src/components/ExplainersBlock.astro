---
import { getAllExplainers, formatDate, readingTime } from "../utils/collection";
import { heroImageOf } from "../utils/collection";
import SectionHeader from "./SectionHeader.astro";

const explainers = await getAllExplainers();
const shown = explainers.slice(0, 4);
---

<section aria-label="Explainers" class="border-t border-line-strong bg-paper-soft py-6">
  <div class="mx-auto max-w-[1400px] px-4 md:px-8">
    <SectionHeader number="10" title="Explainers" link="/explainers" linkLabel="All explainers" />
    <p class="-mt-2 mb-5 max-w-xl font-serif text-[0.98rem] leading-relaxed text-muted">
      The concepts, institutions and chokepoints that run the international system — explained
      plainly and correctly.
    </p>

    <div class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {shown.map((e) => {
        const href = `/explainers/${e.id.replace(/\.mdx?$/, "")}`;
        const rt = readingTime(e);
        return (
          <article class="group flex flex-col bg-paper p-5 transition-colors duration-200 hover:bg-paper-tint">
            <p class="kicker">Explainers</p>
            <h3 class="t-headline-xs mt-2 flex-1">
              <a href={href} class="editorial-link">
                {e.data.title}
              </a>
            </h3>
            <p class="mt-2 line-clamp-2 font-sans text-[0.8rem] leading-relaxed text-muted">
              {e.data.description}
            </p>
            <p class="meta mt-3 border-t border-line pt-3">
              {rt} min read · {formatDate(e.data.date, { month: "short", year: "numeric" })}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
