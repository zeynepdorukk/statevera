---
import marketData from "../data/markets.json";

const quotes = marketData.quotes ?? [];
const track = [...quotes, ...quotes];

// Prices with no time on them read as live even when the refresh job has stopped,
// so the strip always says when it was taken and admits when that was a while ago.
const takenAt = new Date(marketData.updatedAt);
const ageHours = (Date.now() - takenAt.getTime()) / 3600000;
const stale = !Number.isFinite(ageHours) || ageHours > 24;
const stamp = Number.isFinite(takenAt.getTime())
  ? new Intl.DateTimeFormat("en-GB", {
      day: "numeric",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "UTC",
    }).format(takenAt) + " UTC"
  : "";

const formatPrice = (quote) =>
  new Intl.NumberFormat("en-US", {
    minimumFractionDigits: quote.decimals,
    maximumFractionDigits: quote.decimals,
  }).format(quote.price);

const formatChange = (quote) => {
  const sign = quote.change >= 0 ? "+" : "";
  return `${sign}${quote.percent.toFixed(2)}%`;
};
---

{quotes.length > 0 && (
  <section class="market-ticker" aria-label="Market indices">
    <p class:list={["market-stamp", stale && "is-stale"]}>
      {stale ? "Last close" : "Close"}
      {stamp && <span class="market-stamp-time">{stamp}</span>}
    </p>
    <div class="market-viewport">
      <div class="market-track">
        {track.map((quote, index) => (
          <span class="market-quote" aria-hidden={index >= quotes.length ? "true" : undefined}>
            <span class:list={["market-arrow", quote.change >= 0 ? "is-up" : "is-down"]} aria-hidden="true"></span>
            <span class="market-label">{quote.label}</span>
            <span class="market-price">{formatPrice(quote)}</span>
            <span class:list={["market-change", quote.change >= 0 ? "is-up" : "is-down"]}>
              {formatChange(quote)}
            </span>
          </span>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  :global(.news-toolbar) {
    display: block;
    border-bottom: 1px solid var(--line);
  }

  :global(.news-toolbar > nav) {
    border-bottom: 0;
  }

  .market-ticker {
    width: 100%;
    min-width: 0;
    display: flex;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: var(--paper-tint);
  }

  .market-viewport {
    flex: 1;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }

  .market-stamp {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.85rem;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .market-stamp.is-stale {
    color: var(--wire);
  }

  .market-stamp-time {
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  @media (max-width: 40rem) {
    .market-stamp-time {
      display: none;
    }
  }

  .market-track {
    display: flex;
    width: max-content;
    height: 100%;
    animation: market-ticker 42s linear infinite;
  }

  .market-quote {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2.9rem;
    padding: 0 0.85rem;
    border-right: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .market-label {
    color: var(--ink-soft);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .market-price {
    color: var(--ink);
  }

  .market-change.is-up {
    color: #5f9b5c;
  }

  .market-change.is-down {
    color: var(--wire);
  }

  .market-arrow {
    width: 0;
    height: 0;
    border-right: 0.32rem solid transparent;
    border-left: 0.32rem solid transparent;
  }

  .market-arrow.is-up {
    border-bottom: 0.48rem solid #5f9b5c;
  }

  .market-arrow.is-down {
    border-top: 0.48rem solid var(--wire);
  }

  @keyframes market-ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1023px) {
    .market-ticker {
      min-height: 2.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .market-track {
      animation: none;
    }
  }
</style>
