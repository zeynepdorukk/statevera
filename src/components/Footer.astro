---
import { site, deskList, regions } from "../site";
import { root } from "../utils/collection";
import { wirePublishers } from "../data/wire";
import Masthead from "./Masthead.astro";

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t-2 border-ink bg-paper-tint no-print">
  <div class="shell py-10">
    <div class="grid gap-9 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,2.6fr)]">
      <!-- Identity -->
      <div>
        <Masthead compact />
        <p class="mt-3 max-w-sm font-serif text-[0.97rem] leading-relaxed text-ink-soft">
          {site.publicationTagline}
        </p>
        <p class="meta mt-3 max-w-sm">
          Edited and written by <span class="meta-strong">{site.authorName}</span>.{" "}
          {site.publicationType}, founded {site.founded}.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
          <a href={site.socialLinks.x} target="_blank" rel="noopener" class="kicker-ink hover:text-tone">X</a>
          <a href={site.socialLinks.linkedin} target="_blank" rel="noopener" class="kicker-ink hover:text-tone">LinkedIn</a>
          <a href={root(site.socialLinks.rss)} class="kicker-ink hover:text-tone">RSS</a>
          <a href={`mailto:${site.socialLinks.email}`} class="kicker-ink hover:text-tone">Email</a>
        </div>
      </div>

      <!-- Directory -->
      <div class="grid gap-8 sm:grid-cols-3">
        <div data-tone="wire">
          <p class="kicker mb-2.5">News</p>
          <ul class="space-y-1.5">
            {deskList.map((desk) => (
              <li>
                <a href={root(`/wire/${desk.slug}`)} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">
                  {desk.name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div data-tone="journal">
          <p class="kicker mb-2.5">Journal</p>
          <ul class="space-y-1.5">
            <li><a href={root("/journal")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">Analysis &amp; essays</a></li>
            <li><a href={root("/journal/theory")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">Theory</a></li>
            <li><a href={root("/explainers")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">Explainers</a></li>
            <li><a href={root("/risk")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">GLORISK</a></li>
            <li><a href={root("/about")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">About</a></li>
          </ul>
        </div>

        <div>
          <p class="kicker-ink mb-2.5">Regions</p>
          <ul class="space-y-1.5">
            {Object.entries(regions).map(([slug, region]) => (
              <li>
                <a href={root(`/regions/${slug}`)} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">
                  {region.short}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Sourcing statement -->
    <div class="mt-9 border-t border-line pt-5">
      <p class="kicker-ink mb-2">Sourcing</p>
      <p class="max-w-4xl font-sans text-[0.76rem] leading-relaxed text-muted">
        News aggregates public RSS feeds from{" "}
        {wirePublishers.map((p, i) => (
          <>{i > 0 ? ", " : ""}<span class="text-ink-soft">{p}</span></>
        ))}. Statevera reproduces headlines, short summaries and attribution only;
        every item links to the original publisher, who retains all rights. Journal
        and GLORISK is maintained by {site.authorName}.
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="meta">&copy; {year} {site.publicationNameDisplay}. All rights reserved.</p>
    </div>
  </div>
</footer>
