---
import { site, deskList, regions, type RegionSlug } from "../site";
import { root } from "../utils/collection";
import { wirePublishers } from "../data/wire";
import { deskText, getLanguage, localizePath, regionText, siteText } from "../i18n";
import Masthead from "./Masthead.astro";

const year = new Date().getFullYear();
const language = getLanguage(Astro.currentLocale);
const copy = siteText[language];
const hrefFor = (path: string) => root(localizePath(path, language));
---

<footer class="mt-16 border-t-2 border-ink bg-paper-tint no-print">
  <div class="shell py-10">
    <div class="grid gap-9 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,2.6fr)]">
      <!-- Identity -->
      <div>
        <Masthead compact />
        <p class="mt-3 max-w-sm font-serif text-[0.97rem] leading-relaxed text-ink-soft">
          {copy.publicationTagline}
        </p>
        <p class="meta mt-3 max-w-sm">
          {copy.footer.editedBy} <span class="meta-strong">{site.authorName}</span>.{" "}
          {copy.publicationType}, {copy.footer.founded} {site.founded}.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
          {site.socialLinks.x && (
            <a href={site.socialLinks.x} target="_blank" rel="noopener" class="kicker-ink hover:text-tone">X</a>
          )}
          {site.socialLinks.linkedin && (
            <a href={site.socialLinks.linkedin} target="_blank" rel="noopener" class="kicker-ink hover:text-tone">LinkedIn</a>
          )}
          <a href={hrefFor(site.socialLinks.rss)} class="kicker-ink hover:text-tone">RSS</a>
          {site.socialLinks.email && (
            <a href={`mailto:${site.socialLinks.email}`} class="kicker-ink hover:text-tone">{copy.footer.email}</a>
          )}
        </div>
      </div>

      <!-- Directory -->
      <div class="grid gap-8 sm:grid-cols-3">
        <div data-tone="wire">
          <p class="kicker mb-2.5">{copy.footer.news}</p>
          <ul class="space-y-1.5">
            {deskList.map((desk) => (
              <li>
                <a href={hrefFor(`/wire/${desk.slug}`)} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">
                  {deskText(desk.slug, language).name}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div data-tone="journal">
          <p class="kicker mb-2.5">{copy.footer.journal}</p>
          <ul class="space-y-1.5">
            <li><a href={hrefFor("/journal")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">{copy.footer.analysis}</a></li>
            <li><a href={hrefFor("/journal/theory")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">{copy.footer.theory}</a></li>
            <li><a href={hrefFor("/risk")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">GLORISK</a></li>
            <li><a href={hrefFor("/sources")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">{copy.footer.primarySources}</a></li>
            <li><a href={hrefFor("/about")} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">{copy.footer.about}</a></li>
          </ul>
        </div>

        <div>
          <p class="kicker-ink mb-2.5">{copy.footer.regions}</p>
          <ul class="space-y-1.5">
            {Object.entries(regions).map(([slug, region]) => (
              <li>
                <a href={hrefFor(`/regions/${slug}`)} class="font-sans text-[0.82rem] text-ink-soft hover:text-tone">
                  {regionText(slug as RegionSlug, language).short}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Sourcing statement -->
    <div class="mt-9 border-t border-line pt-5">
      <p class="kicker-ink mb-2">{copy.footer.sourcing}</p>
      <p class="max-w-4xl font-sans text-[0.76rem] leading-relaxed text-muted">
        {copy.footer.sourceLead}{" "}
        {wirePublishers.map((p, i) => (
          <>{i > 0 ? ", " : ""}<span class="text-ink-soft">{p}</span></>
        ))}. {copy.footer.sourceTail} {site.authorName}.
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="meta">&copy; {year} {site.publicationNameDisplay}. {copy.footer.rights}</p>
    </div>
  </div>
</footer>
