---
import { site } from "../site";
---

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site search"
  data-search-overlay
>
  <div class="absolute inset-0 bg-ink/40 backdrop-blur-[2px]" data-search-backdrop></div>
  <div class="relative mx-auto mt-[8vh] w-[min(640px,calc(100%-2rem))] border border-line-strong bg-paper shadow-2xl">
    <div class="flex items-center gap-3 border-b border-line px-4">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search articles, topics, countries, regions…"
        autocomplete="off"
        aria-label="Search the site"
        class="w-full border-none bg-transparent py-4 font-sans text-[0.95rem] text-ink outline-none placeholder:text-muted"
      />
      <kbd class="shrink-0 rounded-sm border border-line px-1.5 py-0.5 font-sans text-[0.6rem] font-medium text-muted">esc</kbd>
    </div>
    <div
      id="search-results"
      class="max-h-[52vh] overflow-y-auto"
      aria-live="polite"
      data-search-results
    ></div>
    <div class="border-t border-line px-4 py-2.5">
      <p class="meta">
        Press <kbd class="rounded-sm border border-line px-1 py-px font-sans text-[0.6rem]">Enter</kbd> for the top result ·
        <kbd class="rounded-sm border border-line px-1 py-px font-sans text-[0.6rem]">↑ ↓</kbd> to navigate
      </p>
    </div>
  </div>
</div>

<script>
  type SearchItem = {
    title: string;
    url: string;
    category: string;
    region: string;
    country: string[];
    tags: string[];
    description: string;
    date: string;
    kind: string;
  };

  const overlay = document.querySelector<HTMLElement>("[data-search-overlay]")!;
  const input = document.querySelector<HTMLInputElement>("#search-input")!;
  const resultsEl = document.querySelector<HTMLElement>("[data-search-results]")!;
  const backdrop = document.querySelector<HTMLElement>("[data-search-backdrop]")!;
  let index: SearchItem[] = [];
  let loaded = false;
  let activeIndex = -1;

  const highlight = (text: string, q: string) => {
    if (!q) return text;
    const i = text.toLowerCase().indexOf(q.toLowerCase());
    if (i === -1) return text;
    return (
      text.slice(0, i) +
      "<mark>" +
      text.slice(i, i + q.length) +
      "</mark>" +
      text.slice(i + q.length)
    );
  };

  const escape = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  const render = (q: string) => {
    const query = q.trim().toLowerCase();
    const all: SearchItem[] = [];
    if (!query) {
      resultsEl.innerHTML =
        '<p class="px-4 py-6 meta">Start typing to search titles, topics, countries and regions.</p>';
      return;
    }
    for (const item of index) {
      const hay =
        (item.title + " " + item.description + " " + item.category + " " + item.region + " " +
          item.country.join(" ") + " " + item.tags.join(" ")).toLowerCase();
      if (hay.includes(query)) all.push(item);
    }
    const items = all.slice(0, 12);
    activeIndex = -1;
    if (items.length === 0) {
      resultsEl.innerHTML =
        '<p class="px-4 py-6 meta">No results for "' + escape(query) + '".</p>';
      return;
    }
    resultsEl.innerHTML = items
      .map(
        (it, i) =>
          '<a href="' + it.url + '" data-result-index="' + i + '" class="search-result block border-b border-line px-4 py-3 transition-colors duration-150 hover:bg-paper-soft focus:bg-paper-soft">' +
          '<span class="flex items-baseline justify-between gap-3">' +
          '<span class="font-serif text-[1.02rem] font-semibold text-ink">' + highlight(escape(it.title), query) + "</span>" +
          '<span class="kicker shrink-0">' + it.kind + "</span>" +
          "</span>" +
          '<span class="mt-0.5 block truncate font-sans text-[0.78rem] text-muted">' +
          highlight(escape(it.description), query) +
          "</span>" +
          '<span class="mt-1 block font-sans text-[0.68rem] font-semibold tracking-[0.1em] uppercase text-muted">' +
          it.category +
          " · " +
          it.region +
          (it.country.length ? " · " + it.country.join(", ") : "") +
          "</span>" +
          "</a>"
      )
      .join("");
    resultsEl.querySelectorAll<HTMLElement>(".search-result").forEach((el, i) => {
      el.addEventListener("mouseenter", () => setActive(i));
      el.addEventListener("click", () => close());
    });
  };

  const setActive = (i: number) => {
    activeIndex = i;
    const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
    items.forEach((el, j) => {
      el.classList.toggle("bg-paper-soft", j === i);
      if (j === i) el.focus({ preventScroll: true });
    });
  };

  const open = () => {
    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (!loaded) {
      fetch("/search-index.json")
        .then((r) => r.json())
        .then((data) => {
          index = data;
          loaded = true;
          render(input.value);
        })
        .catch(() => {});
    }
    setTimeout(() => input.focus(), 20);
  };

  const close = () => {
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
    input.value = "";
    render("");
  };

  document.querySelectorAll<HTMLElement>("[data-open-search]").forEach((b) =>
    b.addEventListener("click", open)
  );
  backdrop.addEventListener("click", close);
  input.addEventListener("input", () => render(input.value));

  input.addEventListener("keydown", (e) => {
    const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
    if (e.key === "Escape") {
      close();
    } else if (e.key === "Enter") {
      if (activeIndex >= 0 && items[activeIndex]) {
        window.location.href = items[activeIndex].getAttribute("href")!;
      } else if (items[0]) {
        window.location.href = items[0].getAttribute("href")!;
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(Math.min(activeIndex + 1, items.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(Math.max(activeIndex - 1, 0));
    }
  });

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    const typing =
      target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable;
    if (e.key === "/" && !typing && !overlay.classList.contains("hidden") === false) {
      e.preventDefault();
      open();
    }
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) close();
  });
</script>
