---
import { getLanguage, searchText } from "../i18n";

const language = getLanguage(Astro.currentLocale);
const copy = searchText[language];
---

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden no-print"
  role="dialog"
  aria-modal="true"
  aria-label={copy.dialog}
  data-tone="risk"
  data-search-overlay
  data-language={language}
  data-search-copy={JSON.stringify(copy)}
>
  <div class="absolute inset-0 bg-ink/50 backdrop-blur-[3px]" data-search-backdrop></div>
  <div class="relative mx-auto mt-[5vh] flex max-h-[90vh] w-[min(960px,calc(100%-1.5rem))] flex-col border border-line-strong bg-paper shadow-2xl">
    <div class="search-row flex items-center gap-3.5 border-b border-line px-5">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder={copy.placeholder}
        autocomplete="off"
        aria-label={copy.inputLabel}
        aria-controls="search-results"
        class="w-full border-none bg-transparent py-5 font-sans text-[1.08rem] text-ink placeholder:text-muted"
      />
      <kbd class="shrink-0 border border-line px-1.5 py-0.5 font-sans text-[0.62rem] font-medium text-muted">esc</kbd>
    </div>

    <div class="flex gap-1 border-b border-line px-4 py-2.5" role="group" aria-label={copy.filterResults}>
      <button type="button" data-filter="all" class="filter-pill is-on">{copy.all}</button>
      <button type="button" data-filter="wire" class="filter-pill">{copy.news}</button>
      <button type="button" data-filter="journal" class="filter-pill">{copy.journal}</button>
    </div>

    <div id="search-results" class="min-h-[18rem] flex-1 overflow-y-auto" aria-live="polite" data-search-results></div>

    <div class="border-t border-line px-5 py-3">
      <p class="meta">
        <kbd class="border border-line px-1 py-px font-sans text-[0.6rem]">&uarr;</kbd>
        <kbd class="border border-line px-1 py-px font-sans text-[0.6rem]">&darr;</kbd> {copy.navigate}
        &middot; <kbd class="border border-line px-1 py-px font-sans text-[0.6rem]">Enter</kbd> {copy.open}
        &middot; {copy.press} <kbd class="border border-line px-1 py-px font-sans text-[0.6rem]">/</kbd> {copy.anywhere}
      </p>
    </div>
  </div>
</div>

<style>
  /* The field fills the row, so an outline ring would draw a box around the
     whole dialog head. Move the focus indicator onto the row's rule instead. */
  #search-input:focus,
  #search-input:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .search-row {
    border-bottom-color: var(--line);
    transition: border-color 0.15s ease;
  }
  .search-row:focus-within {
    border-bottom-color: var(--ink);
  }
  #search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .filter-pill {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.35rem 0.8rem;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .filter-pill:hover {
    color: var(--ink);
  }
  .filter-pill.is-on {
    color: var(--ink);
    border-color: var(--line-strong);
    background: var(--paper-soft);
  }
</style>

<script>
  type SearchItem = {
    title: string;
    url: string;
    kind: string;
    pillar: "wire" | "journal";
    category: string;
    region: string;
    description: string;
    source: string;
    date: string;
    language?: "en" | "tr";
    external: boolean;
  };

  type SearchCopy = {
    prompt: string;
    noResults: string;
    unavailable: string;
    kinds: Record<string, string>;
    categories: Record<string, string>;
    regions: Record<string, string>;
  };

  const overlay = document.querySelector<HTMLElement>("[data-search-overlay]")!;
  const input = document.querySelector<HTMLInputElement>("#search-input")!;
  const resultsEl = document.querySelector<HTMLElement>("[data-search-results]")!;
  const backdrop = document.querySelector<HTMLElement>("[data-search-backdrop]")!;
  const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const language = overlay.dataset.language === "tr" ? "tr" : "en";
  const copy = JSON.parse(overlay.dataset.searchCopy ?? "{}") as SearchCopy;
  const localized = (values: Record<string, string>, value: string) => values[value] ?? value;

  let index: SearchItem[] = [];
  let loaded = false;
  let activeIndex = -1;
  let pillar: "all" | "wire" | "journal" = "all";

  const escapeHtml = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  const highlight = (text: string, query: string) => {
    const safe = escapeHtml(text);
    if (!query) return safe;
    const i = safe.toLowerCase().indexOf(escapeHtml(query).toLowerCase());
    if (i === -1) return safe;
    const len = escapeHtml(query).length;
    return safe.slice(0, i) + "<mark>" + safe.slice(i, i + len) + "</mark>" + safe.slice(i + len);
  };

  const score = (item: SearchItem, query: string) => {
    const title = item.title.toLowerCase();
    if (title.startsWith(query)) return 6;
    if (title.includes(query)) return 4;
    if (`${item.category} ${item.region} ${item.source}`.toLowerCase().includes(query)) return 2;
    if (item.description.toLowerCase().includes(query)) return 1;
    return 0;
  };

  const render = (raw: string) => {
    const query = raw.trim().toLowerCase();
    if (!query) {
      resultsEl.innerHTML =
        `<p class="px-5 py-10 meta">${escapeHtml(copy.prompt)}</p>`;
      return;
    }

    const matches = index
      .filter((item) => item.pillar !== "journal" || (item.language ?? "en") === language)
      .filter((item) => pillar === "all" || item.pillar === pillar)
      .map((item) => ({ item, s: score(item, query) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s || Date.parse(b.item.date) - Date.parse(a.item.date))
      .slice(0, 20);

    activeIndex = -1;

    if (matches.length === 0) {
      resultsEl.innerHTML = `<p class="px-5 py-10 meta">${escapeHtml(copy.noResults)} &ldquo;${escapeHtml(raw.trim())}&rdquo;.</p>`;
      return;
    }

    resultsEl.innerHTML = matches
      .map(
        ({ item }, i) => `
        <a href="${escapeHtml(item.url)}"${item.external ? ' target="_blank" rel="noopener noreferrer nofollow"' : ""}
           data-result-index="${i}" data-tone="${item.pillar}"
           class="search-result block border-b border-line px-5 py-3.5 transition-colors duration-150 hover:bg-paper-soft focus:bg-paper-soft focus:outline-none">
          <span class="flex items-baseline justify-between gap-4">
            <span class="font-serif text-[1.1rem] font-semibold leading-snug text-ink">${highlight(item.title, query)}</span>
            <span class="kicker shrink-0">${escapeHtml(localized(copy.kinds, item.kind))}</span>
          </span>
          ${item.description ? `<span class="mt-1 block truncate font-sans text-[0.82rem] text-muted">${highlight(item.description, query)}</span>` : ""}
          <span class="mt-1.5 block font-sans text-[0.68rem] font-semibold tracking-[0.1em] uppercase text-muted">
            ${escapeHtml(item.source)} &middot; ${escapeHtml(localized(copy.categories, item.category))} &middot; ${escapeHtml(localized(copy.regions, item.region))}
          </span>
        </a>`
      )
      .join("");

    resultsEl.querySelectorAll<HTMLElement>(".search-result").forEach((el, i) => {
      el.addEventListener("mouseenter", () => setActive(i, false));
      el.addEventListener("click", () => close());
    });
  };

  const setActive = (i: number, focus = true) => {
    activeIndex = i;
    const items = resultsEl.querySelectorAll<HTMLElement>(".search-result");
    items.forEach((el, j) => {
      el.classList.toggle("bg-paper-soft", j === i);
      if (j === i && focus) el.focus({ preventScroll: false });
    });
  };

  const open = () => {
    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (!loaded) {
      fetch(import.meta.env.BASE_URL.replace(/\/$/, "") + "/search-index.json")
        .then((r) => r.json())
        .then((data: SearchItem[]) => {
          index = data;
          loaded = true;
          render(input.value);
        })
        .catch(() => {
          resultsEl.innerHTML = `<p class="px-5 py-10 meta">${escapeHtml(copy.unavailable)}</p>`;
        });
    }
    setTimeout(() => input.focus(), 20);
  };

  const close = () => {
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
    input.value = "";
    render("");
  };

  document.querySelectorAll<HTMLElement>("[data-open-search]").forEach((b) =>
    b.addEventListener("click", open)
  );
  backdrop.addEventListener("click", close);
  input.addEventListener("input", () => render(input.value));

  filters.forEach((button) =>
    button.addEventListener("click", () => {
      pillar = button.dataset.filter as typeof pillar;
      filters.forEach((b) => b.classList.toggle("is-on", b === button));
      render(input.value);
      input.focus();
    })
  );

  const move = (delta: number) => {
    const count = resultsEl.querySelectorAll(".search-result").length;
    if (!count) return;
    setActive(Math.min(Math.max(activeIndex + delta, 0), count - 1));
  };

  input.addEventListener("keydown", (e) => {
    const items = resultsEl.querySelectorAll<HTMLAnchorElement>(".search-result");
    if (e.key === "Escape") close();
    else if (e.key === "Enter") {
      const target = items[activeIndex >= 0 ? activeIndex : 0];
      if (target) target.click();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      move(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      move(-1);
    }
  });

  resultsEl.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      move(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (activeIndex <= 0) input.focus();
      else move(-1);
    } else if (e.key === "Escape") {
      close();
    }
  });

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    const typing =
      target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable;
    const hidden = overlay.classList.contains("hidden");
    if (e.key === "/" && !typing && hidden) {
      e.preventDefault();
      open();
    }
    if (e.key === "Escape" && !hidden) close();
  });
</script>
