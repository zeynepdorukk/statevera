---
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "inline-flex cursor-pointer items-center gap-1.5 border-none bg-transparent p-1.5 font-sans text-[0.66rem] font-bold tracking-[0.12em] uppercase text-muted transition-colors duration-150 hover:text-ink",
    className,
  ]}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <svg data-icon-moon width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg data-icon-sun width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <span data-theme-label class="hidden sm:inline">Dark</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const html = document.documentElement;
  const label = button?.querySelector<HTMLElement>("[data-theme-label]");
  const moon = button?.querySelector<HTMLElement>("[data-icon-moon]");
  const sun = button?.querySelector<HTMLElement>("[data-icon-sun]");

  const sync = () => {
    const dark = html.classList.contains("dark");
    if (label) label.textContent = dark ? "Light" : "Dark";
    moon?.classList.toggle("hidden", dark);
    sun?.classList.toggle("hidden", !dark);
    button?.setAttribute("aria-pressed", String(dark));
  };

  button?.addEventListener("click", () => {
    const dark = html.classList.toggle("dark");
    try {
      localStorage.setItem("statevera-theme", dark ? "dark" : "light");
    } catch {
      /* private mode */
    }
    sync();
  });

  sync();
</script>
