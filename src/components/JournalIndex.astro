---
import SubscribeForm from "./SubscribeForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  journalCopy,
  journalLanguage,
  type JournalLanguage,
} from "../journal-i18n";
import { getFeaturedArticle, getJournalStream } from "../utils/collection";
import JournalCard from "./JournalCard.astro";
import SectionHead from "./SectionHead.astro";
import MostRead from "./article/MostRead.astro";
import { site } from "../site";
import { absoluteUrl, articleHref, root } from "../utils/collection";
import { localizePath } from "../i18n";

interface Props {
  language: JournalLanguage;
}

const { language } = Astro.props;
const copy = journalCopy[language];
const path = journalLanguage[language].journalPath;
const featured = await getFeaturedArticle(language);
const stream = await getJournalStream(undefined, language);
const rest = stream.filter((item) => item.entry.id !== featured?.id);
// The archive lists every piece once. The rail used to repeat the newest pieces
// as text, so with a small catalogue the page showed each title twice.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${copy.title} — ${site.publicationName}`,
    description: copy.description,
    url: absoluteUrl(root(path).replace(/\/?$/, "/")),
    inLanguage: journalLanguage[language].html,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: stream.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: absoluteUrl(articleHref(item.entry).replace(/\/?$/, "/")),
        name: item.entry.data.title,
      })),
    },
  },
];
const alternates = [
  { language: "en" as const, path: journalLanguage.en.journalPath },
  { language: "tr" as const, path: journalLanguage.tr.journalPath },
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  path={path}
  tone="journal"
  language={language}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="shell pt-0" data-tone="journal">
    <h1 class="sr-only">{copy.title} — {copy.tagline}</h1>
    {stream.length === 0 ? (
      <div class="mx-auto max-w-xl py-20 text-center">
        <p class="kicker-ink">{copy.emptyKicker}</p>
        <p class="t-headline mt-2">{copy.tagline}</p>
        <p class="mt-3 font-serif text-[1.02rem] leading-relaxed text-ink-soft">
          {copy.emptyDescription}
        </p>
        <p class="mt-5 font-serif text-[0.98rem] leading-relaxed text-muted">
          {copy.emptyAuthor}
        </p>
      </div>
    ) : (
      <>
        <section
          class="grid gap-x-9 gap-y-9 py-9 lg:grid-cols-[minmax(0,6fr)_minmax(0,4fr)]"
          aria-label={copy.featured}
        >
          {featured && (
            <JournalCard
              item={{ kind: "article", entry: featured }}
              variant="lead"
              priority
              headingLevel="h2"
            />
          )}
          <aside class="lg:border-l lg:border-line lg:pl-8" aria-label={copy.title}>
            <SectionHead title={copy.title} tone="journal" />
            <p class="font-serif text-[1.08rem] leading-relaxed text-ink">{copy.description}</p>
            <p class="mt-3 font-sans text-[0.8rem] leading-relaxed text-muted">
              <a href={root(localizePath("/about", language))} class="link-tone">{site.authorName}</a>
              <span aria-hidden="true"> · </span>{site.authorRole}
            </p>
            <div class="mt-8">
              <MostRead language={language} limit={5} />
            </div>
            <div class="mt-8 border-t border-line pt-5">
              <SubscribeForm variant="inline" id="journal-subscribe" />
              <p class="mt-5 font-sans text-[0.8rem] leading-relaxed text-muted">{copy.followText}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <a href={root(localizePath("/rss.xml", language))} class="btn btn-tone">{copy.rss}</a>
                {site.socialLinks.linkedin && (
                  <a href={site.socialLinks.linkedin} target="_blank" rel="noopener noreferrer me" class="btn btn-ghost">LinkedIn</a>
                )}
              </div>
            </div>
          </aside>
        </section>

        {rest.length > 0 && (
        <section class="border-t-2 border-ink pt-7" aria-label={copy.archive}>
          <SectionHead title={copy.archive} tone="journal" />
          <div class="grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((item) => (
              <JournalCard item={{ kind: "article", entry: item.entry }} variant="feature" />
            ))}
          </div>
        </section>
        )}
      </>
    )}
  </div>
</BaseLayout>