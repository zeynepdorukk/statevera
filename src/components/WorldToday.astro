---
import { getBriefingsByRegion, getByRegion, formatTime, formatDate, type Briefing, type Article } from "../utils/collection";
import { regions } from "../site";
import SectionHeader from "./SectionHeader.astro";

interface RegionItem {
  place: string;
  text: string;
  time: Date;
  kind: "briefing" | "article";
  href?: string;
}

async function itemsFor(regionName: string): Promise<RegionItem[]> {
  const [briefings, articles] = await Promise.all([
    getBriefingsByRegion(regionName, 3),
    getByRegion(regionName, 2),
  ]);
  const items: RegionItem[] = [
    ...briefings.map((b) => ({
      place: b.data.location,
      text: b.body.trim(),
      time: b.data.timestamp,
      kind: "briefing" as const,
    })),
    ...articles.map((a) => ({
      place: a.data.country[0] ?? a.data.region,
      text: a.data.title,
      time: a.data.date,
      kind: "article" as const,
      href: `/articles/${a.id.replace(/\.mdx?$/, "")}`,
    })),
  ];
  return items.sort((a, b) => b.time.getTime() - a.time.getTime()).slice(0, 4);
}

const regionKeys = ["europe", "middle-east", "americas", "asia-pacific", "africa"] as const;
const all = await Promise.all(regionKeys.map((k) => itemsFor(regions[k].name)));

// Map hotspot coordinates (percentages over the world-map image)
const hotspots: Record<string, { x: number; y: number }> = {
  europe: { x: 51, y: 29 },
  "middle-east": { x: 58.5, y: 41 },
  americas: { x: 25, y: 42 },
  "asia-pacific": { x: 78, y: 40 },
  africa: { x: 54, y: 55 },
};
---

<section aria-label="The world today" class="border-t border-line-strong pt-6">
  <SectionHeader number="03" title="The World Today" />

  <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <!-- Map -->
    <div class="order-2 lg:order-1">
      <div class="relative border border-line bg-paper-tint p-2">
        <img
          src="/images/articles/world-map-1600.png"
          alt="Stylised map of the world with regions highlighted"
          width="1600"
          height="810"
          loading="lazy"
          class="w-full object-contain opacity-90"
        />
        {regionKeys.map((k) => (
          <a
            href={regions[k].url}
            aria-label={regions[k].name}
            class="group absolute -translate-x-1/2 -translate-y-1/2"
            style={`left:${hotspots[k].x}%; top:${hotspots[k].y}%;`}
          >
            <span
              class="block h-2.5 w-2.5 rounded-full border-2 border-paper bg-accent shadow-[0_0_0_3px_rgba(157,28,32,0.25)] transition-transform duration-200 group-hover:scale-150"
              aria-hidden="true"
            ></span>
            <span class="pointer-events-none absolute left-1/2 top-full z-10 mt-1 hidden -translate-x-1/2 whitespace-nowrap border border-line bg-paper px-2 py-0.5 font-sans text-[0.68rem] font-semibold tracking-[0.1em] uppercase text-ink shadow-lg group-hover:block">
              {regions[k].name}
            </span>
          </a>
        ))}
        <p class="sr-only">Hover a marker to explore a region.</p>
      </div>
      <p class="meta mt-2">
        Map: {regions["americas"].short} · hotspots link to region desks. Map graphic:
        FelixCountryBalls163, CC BY-SA 4.0.
      </p>
    </div>

    <!-- Region columns -->
    <div class="order-1 grid gap-x-8 sm:grid-cols-2 lg:order-2 lg:grid-cols-3">
      {regionKeys.map((k, i) => (
        <div class:list={["pt-1", i < 3 ? "lg:border-r lg:border-line lg:pr-8" : "lg:pl-0", i % 2 === 1 ? "sm:border-l sm:border-line sm:pl-8 lg:border-l-0" : ""]}>
          <div class="mb-1 flex items-baseline justify-between">
            <h3 class="font-sans text-[0.8rem] font-bold tracking-[0.16em] uppercase text-ink">
              {regions[k].name}
            </h3>
            <a
              href={regions[k].url}
              class="font-sans text-[0.68rem] font-semibold tracking-[0.1em] text-muted uppercase transition-colors duration-200 hover:text-accent"
            >
              Desk →
            </a>
          </div>
          <ul class="border-t border-line">
            {all[i].map((item) => (
              <li class="border-b border-line py-2.5">
                <p class="flex items-baseline gap-2">
                  <span class="shrink-0 font-sans text-[0.66rem] font-bold tracking-[0.08em] uppercase text-accent">
                    {item.place}
                  </span>
                  <time class="meta shrink-0" datetime={item.time.toISOString()}>
                    {formatTime(item.time)}
                  </time>
                </p>
                {item.kind === "article" && item.href ? (
                  <a href={item.href} class="editorial-link mt-0.5 block font-serif text-[0.9rem] leading-snug text-ink">
                    {item.text}
                  </a>
                ) : (
                  <p class="mt-0.5 font-serif text-[0.9rem] leading-snug text-ink-soft">{item.text}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
