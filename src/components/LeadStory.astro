---
import { getFeaturedArticle, heroImageOf, formatDate, readingTime, root } from "../utils/collection";
import { creditFor } from "../data/imageCredits";

const lead = await getFeaturedArticle();
if (!lead) return null;
const href = root(`/articles/${lead.id.replace(/\.mdx?$/, "")}`);
const rt = readingTime(lead);
const credit = creditFor(lead.data.heroImage);
---

<article class="group">
  <a href={href} class="hero-overlay relative block overflow-hidden border border-line/60 bg-paper-soft">
    <img
      src={heroImageOf(lead.data.heroImage)}
      alt={lead.data.heroImageAlt}
      width="1600"
      height="1000"
      fetchpriority="high"
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.015] sm:aspect-[16/9] lg:aspect-[3/2]"
    />
    <div class="absolute inset-x-0 bottom-0 z-10 p-4 text-white sm:p-6 lg:p-8">
      <p class="mb-2 font-sans text-[0.68rem] font-bold tracking-[0.18em] uppercase text-[#e8b4b5]">
        {lead.data.category} · {lead.data.region}
      </p>
      <h1 class="t-headline-lg text-white">
        <span class="bg-none">{lead.data.title}</span>
      </h1>
      <p class="mt-2.5 hidden max-w-2xl font-serif text-[1.02rem] leading-relaxed text-white/85 sm:block">
        {lead.data.description}
      </p>
      <p class="mt-3 font-sans text-[0.75rem] text-white/70">
        By <span class="font-semibold text-white/90">{lead.data.author}</span> ·{" "}
        {formatDate(lead.data.date)} · {rt} min read
      </p>
    </div>
  </a>
  {credit && (
    <p class="mt-1.5 font-sans text-[0.68rem] leading-relaxed text-muted">
      {credit.label}. {credit.credit}, {credit.license}.
    </p>
  )}
</article>
