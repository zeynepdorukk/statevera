---
import { site, type PillarId } from "../site";
import { root } from "../utils/collection";
import { getLanguage, localizePath, siteText } from "../i18n";

interface Props {
  compact?: boolean;
  tone?: PillarId;
  class?: string;
}

const { compact = false, tone, class: className = "" } = Astro.props;
const language = getLanguage(Astro.currentLocale);
---

<a
  href={root(localizePath("/", language))}
  data-tone={tone}
  class:list={["inline-flex items-center gap-[0.5em] no-underline", className]}
  aria-label={siteText[language].home}
  style={`font-size: ${compact ? "1.1rem" : "clamp(1.6rem, 4vw, 2.35rem)"}`}
>
  <span class="relative shrink-0" style="width: 1.25em; height: 1.25em">
    <img
      src={root("/images/branding/logo-mark-light.svg")}
      alt=""
      width="44"
      height="44"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    />
  </span>
  <span
    class="font-serif font-bold leading-none text-ink"
    style="letter-spacing: 0.05em; font-size: 1em"
  >
    {site.publicationName}
  </span>
</a>
