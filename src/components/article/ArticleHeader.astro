---
import { site, regionSlugOf, deskSlugOf } from "../../site";
import type { Article } from "../../utils/collection";
import { formatDate, heroImageOf, readingTime, root } from "../../utils/collection";
import { creditFor } from "../../data/imageCredits";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;
const credit = creditFor(data.heroImage);
const minutes = readingTime(article);
const deskSlug = deskSlugOf(data.category);
const regionSlug = regionSlugOf(data.region);
---

<header class="shell max-w-[900px] pt-8 md:pt-12" data-tone="journal">
  <nav aria-label="Breadcrumb" class="mb-5">
    <ol class="flex flex-wrap items-center gap-2 font-sans text-[0.68rem] font-bold tracking-[0.12em] uppercase">
      <li><a href={root("/journal")} class="text-muted transition-colors hover:text-tone">Journal</a></li>
      <li aria-hidden="true" class="text-line-strong">/</li>
      <li>
        {deskSlug ? (
          <a href={root(`/wire/${deskSlug}`)} class="text-tone">{data.category}</a>
        ) : (
          <span class="text-tone">{data.category}</span>
        )}
      </li>
    </ol>
  </nav>

  {data.draft && (
    <p class="mb-4 inline-flex items-center gap-2 border border-line-strong bg-paper-soft px-2.5 py-1 font-sans text-[0.64rem] font-bold tracking-[0.14em] uppercase text-muted">
      Draft — not published
    </p>
  )}

  <h1 class="t-display">{data.title}</h1>

  <p class="mt-4 max-w-[46rem] font-serif text-[1.24rem] leading-relaxed text-ink-soft">
    {data.description}
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-line py-3.5">
    <div class="flex items-center gap-2.5">
      <img
        src={root(site.authorPhoto)}
        alt=""
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
        class="h-8 w-8 rounded-full border border-line object-cover"
      />
      <p class="font-sans text-[0.8rem] font-semibold text-ink">By {data.author}</p>
    </div>
    <time class="meta" datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
    {data.updated && (
      <span class="meta">Updated {formatDate(data.updated)}</span>
    )}
    <span class="meta">{minutes} min read</span>
    <a href={root(`/regions/${regionSlug}`)} class="kicker ml-auto">{data.region}</a>
  </div>

  <figure class="mt-7">
    <img
      src={heroImageOf(data.heroImage)}
      alt={data.heroImageAlt}
      width="1600"
      height="1000"
      fetchpriority="high"
      decoding="async"
      class="img-frame border border-line/70"
      style={data.imageFocus ? `object-position: ${data.imageFocus}` : undefined}
    />
    {credit && (
      <figcaption class="mt-1.5 border-b border-line pb-2.5 font-sans text-[0.73rem] text-muted">
        {credit.label}. {credit.credit}, {credit.license}.
      </figcaption>
    )}
    {!credit && data.imageCredit && (
      <figcaption class="mt-1.5 border-b border-line pb-2.5 font-sans text-[0.73rem] text-muted">
        {data.imageCredit}
      </figcaption>
    )}
  </figure>
</header>
