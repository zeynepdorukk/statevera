---
import { site, regionSlugOf, deskSlugOf } from "../../site";
import type { Article } from "../../utils/collection";
import { formatDate, readingTime, root } from "../../utils/collection";
import { responsiveImage } from "../../utils/images";
import {
  journalCategoryLabel,
  journalCopy,
  journalLanguage,
  journalRegionLabel,
} from "../../journal-i18n";
import { localizePath } from "../../i18n";
import { creditFor } from "../../data/imageCredits";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { data } = article;
const copy = journalCopy[data.language];
const categoryLabel = journalCategoryLabel(data.category, data.language);
const regionLabel = journalRegionLabel(data.region, data.language);
const explicitCredit = data.imageCredit?.trim() ?? "";
const credit = explicitCredit ? null : creditFor(data.heroImage);
const imageCaption = data.imageCaption?.trim() ?? "";
const imageSource = data.imageSource?.trim() ?? "";
const imageDate = data.imageDate?.trim() ?? "";
const imageLicense = data.imageLicense?.trim() ?? "";
const sourceUrl = /^https?:\/\//i.test(imageSource) ? imageSource : "";
// A raw address is unreadable in a caption; the publisher's host says the same thing.
const sourceLabel = (() => {
  if (!sourceUrl) return imageSource;
  try {
    return new URL(sourceUrl).hostname.replace(/^www\./, "");
  } catch {
    return imageSource;
  }
})();
const photoDate = (() => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(imageDate)) return imageDate;
  const parsed = new Date(`${imageDate}T12:00:00Z`);
  return Number.isNaN(parsed.getTime()) ? imageDate : formatDate(parsed, {}, data.language);
})();
// Caption first, then one quiet line of attribution: who, where, when, terms.
const creditParts = [
  credit ? `${credit.label}. ${credit.credit}, ${credit.license}` : explicitCredit ? `${copy.photo}: ${explicitCredit}` : "",
  photoDate,
  imageLicense,
].filter(Boolean);
const minutes = readingTime(article);
const deskSlug = deskSlugOf(data.category);
const regionSlug = regionSlugOf(data.region);
const hrefFor = (path: string) => root(localizePath(path, data.language));
const picture = await responsiveImage(data.heroImage);
---

<header class="shell max-w-[900px] pt-8 md:pt-12" data-tone="journal">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <nav aria-label={copy.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-2 font-sans text-[0.68rem] font-bold tracking-[0.12em] uppercase">
        <li>
          <a href={root(journalLanguage[data.language].journalPath)} class="text-muted transition-colors hover:text-tone">
            {copy.journal}
          </a>
        </li>
        <li aria-hidden="true" class="text-line-strong">/</li>
        <li>
          {deskSlug ? (
            <a href={hrefFor(`/wire/${deskSlug}`)} class="text-tone">{categoryLabel}</a>
          ) : (
            <span class="text-tone">{categoryLabel}</span>
          )}
        </li>
      </ol>
    </nav>

  </div>

  {data.draft && (
    <p class="mb-4 inline-flex items-center gap-2 border border-line-strong bg-paper-soft px-2.5 py-1 font-sans text-[0.64rem] font-bold tracking-[0.14em] uppercase text-muted">
      {copy.draftNotice}
    </p>
  )}

  <h1 class="t-display">{data.title}</h1>

  <p class="mt-4 max-w-[46rem] font-serif text-[1.24rem] leading-relaxed text-ink-soft">
    {data.description}
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-line py-3.5">
    <div class="flex items-center gap-2.5">
      {site.authorPhoto && (
        <img
          src={root(site.authorPhoto)}
          alt=""
          width="72"
          height="72"
          loading="lazy"
          decoding="async"
          class="h-8 w-8 rounded-full border border-line object-cover"
        />
      )}
      <p class="font-sans text-[0.8rem] font-semibold text-ink">{copy.by(data.author)}</p>
    </div>
    <time class="meta" datetime={data.date.toISOString()}>{formatDate(data.date, {}, data.language)}</time>
    {data.updated && (
      <span class="meta">{copy.updated(formatDate(data.updated, {}, data.language))}</span>
    )}
    <span class="meta">{copy.minutesLong(minutes)}</span>
    <a href={hrefFor(`/regions/${regionSlug}`)} class="kicker ml-auto">{regionLabel}</a>
  </div>

  <figure class="mt-7">
    <img
      src={picture.src}
      srcset={picture.srcset}
      sizes="(min-width: 1440px) 1376px, calc(100vw - 2rem)"
      alt={data.heroImageAlt}
      width={picture.width ?? 1600}
      height={picture.height ?? 1000}
      fetchpriority="high"
      decoding="async"
      class="img-frame border border-line/70"
      style={data.imageFocus ? `object-position: ${data.imageFocus}` : undefined}
    />
    {(credit || explicitCredit || imageCaption || imageSource || imageDate || imageLicense) && (
      <figcaption class="mt-2 border-b border-line pb-3 font-sans text-[0.75rem] leading-relaxed text-muted">
        {imageCaption && <span class="block text-ink-soft">{imageCaption}</span>}
        {(creditParts.length > 0 || imageSource) && (
          <span class:list={["block text-[0.7rem]", imageCaption && "mt-1"]}>
            {creditParts.map((part, index) => (
              <>{index > 0 && <span aria-hidden="true"> · </span>}<span>{part}</span></>
            ))}
            {imageSource && (
              <>
                {creditParts.length > 0 && <span aria-hidden="true"> · </span>}
                {sourceUrl ? (
                  <a href={sourceUrl} target="_blank" rel="noopener noreferrer nofollow" class="underline decoration-line-strong underline-offset-2 hover:text-ink">
                    {copy.source}: {sourceLabel}<span class="sr-only"> ({sourceUrl})</span>
                  </a>
                ) : (
                  <span>{copy.source}: {sourceLabel}</span>
                )}
              </>
            )}
          </span>
        )}
      </figcaption>
    )}
  </figure>
</header>
