---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, regionSlugOf } from "../../site";
import {
  absoluteUrl,
  articleHref,
  getArticleTranslations,
  heroImageOf,
  root,
  slugOf,
  type Article,
} from "../../utils/collection";
import {
  journalCopy,
  journalLanguage,
  journalRegionLabel,
} from "../../journal-i18n";
import { localizePath } from "../../i18n";
import { byRegion } from "../../data/wire";
import ArticleHeader from "./ArticleHeader.astro";
import { responsiveImage } from "../../utils/images";
import ArticleSources from "./ArticleSources.astro";
import ArticleShare from "./ArticleShare.astro";
import RelatedStories from "./RelatedStories.astro";
import ArticleViewTracker from "./ArticleViewTracker.astro";
import ArticleContents from "./ArticleContents.astro";
import ReadingProgress from "./ReadingProgress.astro";
import MostRead from "./MostRead.astro";
import { contentsOf } from "../../utils/contents";
import WireCard from "../WireCard.astro";
import SectionHead from "../SectionHead.astro";
import KeyTakeaways from "../mdx/KeyTakeaways.astro";
import WhyItMatters from "../mdx/WhyItMatters.astro";
import TheBigPicture from "../mdx/TheBigPicture.astro";
import AnalysisSection from "../mdx/AnalysisSection.astro";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { data } = article;
const language = data.language;
const copy = journalCopy[language];
const languageMeta = journalLanguage[language];
const href = articleHref(article);
const canonical = absoluteUrl(href.replace(/\/?$/, "/"));
const regionSlug = regionSlugOf(data.region);
const regionLabel = journalRegionLabel(data.region, language);
const journalPath = journalLanguage[language].journalPath;
const wireContext = byRegion(data.region, 5);
const translations = await getArticleTranslations(article);
const alternates = translations.map((translation) => ({
  language: translation.data.language,
  path: articleHref(translation),
}));
const hrefFor = (path: string) => root(localizePath(path, language));
const contents = contentsOf(headings);
const picture = await responsiveImage(data.heroImage);
const preview = picture.og ?? { src: picture.src, width: picture.width, height: picture.height };

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": data.type === "opinion" ? "OpinionNewsArticle" : "AnalysisNewsArticle",
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: {
      "@type": "Person",
      "@id": `${absoluteUrl("/about/")}#author`,
      name: data.author,
      url: absoluteUrl("/about/"),
      ...(data.author === site.authorName
        ? {
            jobTitle: site.authorRole,
            sameAs: [site.socialLinks.linkedin].filter(Boolean),
          }
        : {}),
    },
    publisher: {
      "@type": "NewsMediaOrganization",
      "@id": `${site.siteUrl}/#organization`,
      name: site.publicationName,
      url: `${site.siteUrl}/`,
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl("/images/branding/logo-512-v2.png"),
      },
    },
    image: [
      ...(picture.og ? [absoluteUrl(picture.og.src)] : []),
      absoluteUrl(heroImageOf(data.heroImage)),
    ],
    articleSection: data.category,
    keywords: [...data.tags, data.region, ...data.country].join(", "),
    inLanguage: languageMeta.html,
    wordCount: (article.body ?? "").trim().split(/\s+/).filter(Boolean).length,
    isAccessibleForFree: true,
    mainEntityOfPage: canonical,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: copy.home, item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: copy.journal, item: absoluteUrl(root(journalPath)) },
      { "@type": "ListItem", position: 3, name: data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  tone="journal"
  image={preview.src}
  imageAlt={data.heroImageAlt}
  imageWidth={preview.width}
  imageHeight={preview.height}
  path={href}
  noindex={data.draft}
  jsonLd={jsonLd}
  language={language}
  alternates={alternates}
  article={{
    publishedTime: data.date.toISOString(),
    modifiedTime: data.updated?.toISOString(),
    authors: [data.author],
    tags: data.tags,
    section: data.category,
  }}
>
  <ReadingProgress />
  <ArticleHeader article={article} />

  <div class="shell flex max-w-[1400px] gap-10" data-tone="journal">
    <div class="hidden shrink-0 pt-10 xl:block xl:w-12 no-print">
      <div class="sticky top-32">
        <ArticleShare title={data.title} url={canonical} language={language} />
      </div>
    </div>

    <article class="min-w-0 flex-1 py-8 md:py-10">
      <div class="mx-auto max-w-[720px]">
        <div class="lg:hidden no-print">
          <ArticleContents entries={contents} label={copy.contents} layout="inline" />
        </div>
        <div class="article-body">
          <Content components={{ KeyTakeaways, WhyItMatters, TheBigPicture, AnalysisSection }} />
        </div>

        <ArticleSources sources={data.sources} label={copy.sources} language={language} />

        {data.tags.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="kicker-ink">{copy.filedUnder}</span>
            {data.tags.map((tag) => (
              <span class="border border-line px-2 py-0.5 font-sans text-[0.72rem] text-ink-soft">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="mt-6 xl:hidden no-print">
          <ArticleShare title={data.title} url={canonical} layout="row" language={language} />
        </div>

        <p class="mt-8 border-t border-line pt-4 font-sans text-[0.74rem] leading-relaxed text-muted">
          {copy.by(data.author)} &middot; {site.publicationNameDisplay}.{" "}
          <a href={hrefFor(`/regions/${regionSlug}`)} class="link-tone">{regionLabel}</a>{" "}
          {copy.deskSuffix}
          {data.country.length > 0 && ` ${copy.focus(data.country)}`}
        </p>

        <section class="article-follow no-print mt-8 border border-line bg-paper-soft px-5 py-5 sm:flex sm:items-center sm:justify-between sm:gap-6" aria-labelledby="follow-title">
          <div>
            <p id="follow-title" class="font-serif text-[1.1rem] font-semibold text-ink">{copy.followTitle}</p>
            <p class="mt-1 font-sans text-[0.8rem] leading-relaxed text-muted">{copy.followText}</p>
          </div>
          <div class="mt-4 flex shrink-0 gap-2 sm:mt-0">
            <a href={root(localizePath("/rss.xml", language))} class="btn btn-tone">{copy.rss}</a>
            {site.socialLinks.linkedin && (
              <a href={site.socialLinks.linkedin} target="_blank" rel="noopener noreferrer me" class="btn btn-ghost">LinkedIn</a>
            )}
          </div>
        </section>
      </div>
    </article>

    <aside class="hidden w-72 shrink-0 pt-10 lg:block no-print" aria-label={copy.relatedReporting}>
      <div class="border-l border-line pl-8" data-tone="wire">
        <SectionHead
          title={copy.regionWire(regionLabel)}
          tone="wire"
          href={`/regions/${regionSlug}`}
          moreLabel={copy.region}
        />
        {wireContext.length > 0 ? (
          <div class="rule-list">
            {wireContext.map((item) => (
              <WireCard item={item} variant="text" />
            ))}
          </div>
        ) : (
          <p class="meta">{copy.noReporting}</p>
        )}
        <p class="mt-5 border-t border-line pt-3">
          <a href={hrefFor("/wire")} class="kicker-ink hover:text-tone">{copy.seeAllNews}</a>
        </p>
        <div class="mt-9">
          <MostRead language={language} exclude={article} />
        </div>
      </div>
      {/* The contents list follows the reader once the context above has scrolled away. */}
      {contents.length > 0 && (
        <div class="sticky top-32 mt-9 max-h-[calc(100vh-10rem)] overflow-y-auto border-l border-line pl-8" data-tone="journal">
          <ArticleContents entries={contents} label={copy.contents} />
        </div>
      )}
    </aside>
  </div>

  <div class="shell pb-4">
    <RelatedStories article={article} count={3} />
  </div>

  {!data.draft && site.deskUrl && (
    <ArticleViewTracker slug={slugOf(article)} endpoint={`${site.deskUrl}/api/views`} />
  )}
</BaseLayout>