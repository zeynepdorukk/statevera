---
import { journalCopy, type JournalLanguage } from "../../journal-i18n";

interface Props {
  title: string;
  url: string;
  layout?: "rail" | "row";
  language?: JournalLanguage;
}

const { title, url, layout = "rail", language = "en" } = Astro.props;
const copy = journalCopy[language];
const encodedTitle = encodeURIComponent(title);
// Messaging apps send no referrer, so a share from them would read as "direct"
// in the desk's read counts. Each outbound link carries its own source; the
// view tracker reads it, and the address bar is cleaned on arrival.
const tagged = (source: string) => {
  const next = new URL(url);
  next.searchParams.set("utm_source", source);
  next.searchParams.set("utm_medium", "share");
  return encodeURIComponent(next.toString());
};

const links = [
  {
    label: copy.shareX,
    short: "X",
    href: `https://x.com/intent/tweet?text=${encodedTitle}&url=${tagged("x")}`,
    path: "M18.9 2H22l-7 8 8.2 12H16l-5-7.3L5.2 22H2l7.5-8.6L1.6 2h7.3l4.6 6.7L18.9 2Zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20Z",
  },
  {
    label: copy.shareLinkedIn,
    short: "in",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${tagged("linkedin")}`,
    path: "M6.9 8.5v11H3.4v-11h3.5ZM5.2 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm4.3 5.5h3.3v1.5a3.7 3.7 0 0 1 3.3-1.8c2.4 0 4.2 1.6 4.2 4.9v6.4h-3.5v-5.8c0-1.5-.6-2.4-1.9-2.4-1.1 0-1.7.7-2 1.4v6.8H9.5v-11Z",
  },
  {
    label: copy.shareWhatsApp,
    short: "WA",
    href: `https://wa.me/?text=${encodedTitle}%20${tagged("whatsapp")}`,
    path: "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z",
  },
  {
    label: copy.shareTelegram,
    short: "TG",
    href: `https://t.me/share/url?url=${tagged("telegram")}&text=${encodedTitle}`,
    path: "M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.3 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13.1 1.4 11.6c-1-.3-1-1 .2-1.5l18.9-7.3c.9-.3 1.6.2 1.4 1.5Z",
  },
  {
    label: copy.shareEmail,
    short: "@",
    href: `mailto:?subject=${encodedTitle}&body=${tagged("email")}`,
    path: "M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1.6 2L12 12.3 19.4 7H4.6Z",
  },
];
---

<div
  class:list={[
    "flex items-center gap-2",
    layout === "rail" ? "flex-col" : "flex-row flex-wrap",
  ]}
>
  <p class:list={["kicker-ink", layout === "rail" ? "mb-1 [writing-mode:vertical-rl] rotate-180" : "mr-1"]}>
    {copy.share}
  </p>
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.label}
      title={link.label}
      class="inline-flex h-9 w-9 items-center justify-center border border-line text-ink-soft transition-colors duration-150 hover:border-tone hover:text-tone"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={link.path}></path>
      </svg>
    </a>
  ))}
  <button
    type="button"
    data-native-share
    data-url={url}
    data-title={title}
    hidden
    aria-label={copy.shareNative}
    title={copy.shareNative}
    class="inline-flex h-9 w-9 cursor-pointer items-center justify-center border border-line bg-transparent text-ink-soft transition-colors duration-150 hover:border-tone hover:text-tone"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path>
      <path d="m16 6-4-4-4 4"></path>
      <path d="M12 2v13"></path>
    </svg>
  </button>
  <button
    type="button"
    data-copy-link
    data-url={url}
    data-copy-prompt={copy.copyPrompt}
    aria-label={copy.copyLink}
    title={copy.copyLink}
    class="inline-flex h-9 w-9 cursor-pointer items-center justify-center border border-line bg-transparent text-ink-soft transition-colors duration-150 hover:border-tone hover:text-tone"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <path d="M10 13a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7"></path>
      <path d="M14 11a5 5 0 0 0-7.1 0l-3 3a5 5 0 0 0 7.1 7.1l1.7-1.7"></path>
    </svg>
  </button>
  <span data-copy-status role="status" class="meta hidden">{copy.copied}</span>
</div>

<script>
  // The phone's own share sheet, where there is one (most mobile browsers).
  if (typeof navigator.share === "function") {
    document.querySelectorAll<HTMLButtonElement>("[data-native-share]").forEach((button) => {
      button.hidden = false;
      button.addEventListener("click", () => {
        const url = new URL(button.dataset.url ?? window.location.href);
        url.searchParams.set("utm_source", "share-sheet");
        url.searchParams.set("utm_medium", "share");
        navigator.share({ title: button.dataset.title, url: url.toString() }).catch(() => {
          // Dismissing the sheet is not an error worth showing.
        });
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((button) => {
    button.addEventListener("click", async () => {
      const url = button.dataset.url ?? window.location.href;
      const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(url);
        if (status) {
          status.classList.remove("hidden");
          setTimeout(() => status.classList.add("hidden"), 1800);
        }
      } catch {
        window.prompt(button.dataset.copyPrompt ?? "Copy this link", url);
      }
    });
  });
</script>
