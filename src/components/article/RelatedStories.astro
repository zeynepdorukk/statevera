---
import type { Article } from "../../utils/collection";
import { getRelated } from "../../utils/collection";
import JournalCard from "../JournalCard.astro";
import SectionHead from "../SectionHead.astro";

interface Props {
  article: Article;
  count?: number;
}

const { article, count = 3 } = Astro.props;
const related = await getRelated(article, count);
---

{related.length > 0 && (
  <section class="mt-12 pb-4" aria-label="More from the journal" data-tone="journal">
    <SectionHead title="More from the Journal" tone="journal" href="/journal" moreLabel="All analysis" />
    <div class="grid gap-x-7 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((entry) => (
        <JournalCard item={{ kind: "article", entry }} variant="feature" />
      ))}
    </div>
  </section>
)}
