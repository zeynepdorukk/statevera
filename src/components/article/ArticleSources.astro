---
import { journalCopy, type JournalLanguage } from "../../journal-i18n";

interface Props {
  sources: { name: string; url: string }[];
  label?: string;
  language?: JournalLanguage;
}

const { sources, language = "en" } = Astro.props;
const copy = journalCopy[language];
const label = Astro.props.label ?? copy.sources;
---

{sources.length > 0 && (
  <aside class="mt-10 border-t-2 border-ink pt-5" aria-label={label}>
    <p class="kicker-ink mb-3">{label}</p>
    <ul class="columns-1 gap-8 sm:columns-2">
      {sources.map((source) => (
        <li class="mb-2 break-inside-avoid">
          <a
            href={source.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link-tone font-sans text-[0.86rem]"
          >
            {source.name}<span class="outbound" aria-hidden="true"></span>
          </a>
          <span class="sr-only">({copy.opensExternal})</span>
        </li>
      ))}
    </ul>
  </aside>
)}
