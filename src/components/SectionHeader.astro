---
import { site } from "../site";
import { root } from "../utils/collection";

interface Props {
  number?: string;
  title: string;
  link?: string;
  linkLabel?: string;
}

const { number, title, link, linkLabel = "View all" } = Astro.props;
---

<div class="section-head">
  {number && <span class="no">{number}</span>}
  <h2 class="title">{title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {link && (
    <a
      href={root(link)}
      class="shrink-0 font-sans text-[0.72rem] font-semibold tracking-[0.1em] text-accent uppercase transition-colors duration-200 hover:text-ink"
    >
      {linkLabel} →
    </a>
  )}
</div>
