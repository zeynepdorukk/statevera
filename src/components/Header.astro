---
import { nav, site } from "../site";
import { root } from "../utils/collection";
import Masthead from "./Masthead.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const today = new Intl.DateTimeFormat("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());

const isActive = (url: string) =>
  url === "/" ? currentPath === "/" : currentPath.startsWith(url);
---

<header class="header-shell" id="site-header">
  <!-- Top meta row -->
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-4 pt-2 pb-1 md:px-8">
    <p class="meta hidden lg:block" aria-hidden="true">{today}</p>
    <p class="meta hidden md:block lg:hidden" aria-hidden="true">{site.authorRole} of {site.publicationNameDisplay}</p>

    <div class="flex flex-1 items-center gap-3 md:flex-none md:gap-5" data-search-trigger-group>
      <button
        type="button"
        data-open-search
        class="inline-flex cursor-pointer items-center gap-2 border-none bg-transparent p-1 font-sans text-[0.72rem] font-semibold tracking-[0.08em] text-ink-soft uppercase transition-colors duration-200 hover:text-accent"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden rounded-sm border border-line px-1 py-px font-sans text-[0.6rem] font-medium text-muted sm:inline">/</kbd>
      </button>
      <a
        href={root("/about")}
        class="hidden p-1 font-sans text-[0.72rem] font-semibold tracking-[0.08em] text-ink-soft uppercase transition-colors duration-200 hover:text-accent sm:inline-block"
      >
        About
      </a>
      <a
        href={root("/briefings")}
        class="hidden p-1 font-sans text-[0.72rem] font-semibold tracking-[0.08em] text-ink-soft uppercase transition-colors duration-200 hover:text-accent md:inline-block"
      >
        Briefings
      </a>
    </div>
  </div>

  <!-- Masthead -->
  <div class="mx-auto max-w-[1400px] px-4 pt-1 pb-3 md:px-8 md:pt-2" data-masthead>
    <Masthead />
  </div>

  <!-- Navigation -->
  <nav aria-label="Primary" class="border-y border-line">
    <div class="mx-auto flex max-w-[1400px] items-center justify-between px-4 md:px-8">
      <ul class="no-scrollbar flex items-center gap-0 overflow-x-auto">
        {nav.primary.map((item) => (
          <li>
            <a
              href={root(item.url)}
              aria-current={isActive(item.url) ? "page" : undefined}
              class:list={[
                "relative block whitespace-nowrap px-3 py-2.5 font-sans text-[0.74rem] font-semibold tracking-[0.06em] uppercase transition-colors duration-200 first:pl-0 last:pr-0 hover:text-accent",
                isActive(item.url)
                  ? "text-ink after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:bg-accent first:after:inset-x-0"
                  : "text-ink-soft",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-1 border-l border-line pl-3">
        <ThemeToggle />
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex cursor-pointer items-center gap-2 border-none bg-transparent p-2 font-sans text-[0.74rem] font-semibold tracking-[0.06em] text-ink uppercase lg:hidden"
        >
          <svg data-icon-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg data-icon-close width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
          <span data-menu-label>Menu</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-b border-line bg-paper-soft lg:hidden" data-mobile-menu>
    <ul class="mx-auto max-w-[1400px] px-4 py-3 md:px-8">
      {nav.primary.map((item) => (
        <li>
          <a
            href={root(item.url)}
            class:list={[
              "flex items-center justify-between border-b border-line py-3 font-serif text-xl font-medium text-ink last:border-0",
              isActive(item.url) ? "text-accent" : "",
            ]}
          >
            {item.label}
            <span class="font-sans text-[0.65rem] tracking-[0.2em] text-muted uppercase">→</span>
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a href={root("/about")} class="meta">About the publication</a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Sticky compact header
  const header = document.getElementById("site-header");
  const masthead = header?.querySelector("[data-masthead]");
  const shell = header?.querySelector(".header-shell");
  let compacted = false;

  const onScroll = () => {
    const shouldCompact = window.scrollY > 60;
    if (shouldCompact === compacted) return;
    compacted = shouldCompact;
    header?.classList.toggle("is-compact", compacted);
    if (masthead) {
      (masthead as HTMLElement).style.paddingBlock = compacted ? "0.35rem" : "0.5rem";
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile menu
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    document.querySelector("[data-menu-label]")!.textContent = open ? "Close" : "Menu";
    document.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    document.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
  });
</script>

<style>
  .header-shell {
    transition: box-shadow 0.2s ease;
  }
  .header-shell.is-compact {
    box-shadow: 0 1px 0 var(--line), 0 8px 24px -20px rgba(0, 0, 0, 0.35);
  }
  .header-shell.is-compact [data-masthead] .tagline-hide {
    display: none;
  }
</style>
