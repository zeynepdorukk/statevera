---
import { nav, site } from "../site";
import { root, formatDate } from "../utils/collection";
import Masthead from "./Masthead.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const today = formatDate(new Date(), { weekday: "long" });

const isActive = (url: string) =>
  url === "/" ? currentPath === "/" : currentPath.startsWith(url);
---

<header id="site-header" class="sticky top-0 z-40 border-b border-line bg-paper/97 backdrop-blur-sm no-print">
  <!-- Row 1: date · masthead · utilities -->
  <div class="shell">
    <div class="flex items-center justify-between gap-4 border-b border-line/70 py-2.5">
      <p class="hidden w-48 shrink-0 font-sans text-[0.68rem] tracking-[0.04em] text-muted lg:block">
        {today}
      </p>

      <Masthead class="masthead-full" />
      <Masthead compact class="masthead-compact" />

      <div class="flex w-48 shrink-0 items-center justify-end gap-1">
        <button
          type="button"
          data-open-search
          class="inline-flex cursor-pointer items-center gap-1.5 border-none bg-transparent p-1.5 font-sans text-[0.66rem] font-bold tracking-[0.12em] uppercase text-muted transition-colors duration-150 hover:text-ink"
          aria-label="Search Statevera"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="hidden sm:inline">Search</span>
        </button>
        <ThemeToggle />
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex cursor-pointer items-center border-none bg-transparent p-1.5 text-ink md:hidden"
          aria-label="Open menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Row 2: pillar navigation -->
  <nav class="hidden md:block" aria-label="Sections">
    <div class="shell">
      <ul class="flex items-stretch justify-center">
        {nav.primary.map((item) => (
          <li class="group relative" data-tone={item.tone}>
            <a
              href={root(item.url)}
              aria-current={isActive(item.url) ? "page" : undefined}
              class:list={[
                "relative flex items-center gap-1 px-4 py-2.5 font-sans text-[0.73rem] font-bold tracking-[0.13em] whitespace-nowrap uppercase transition-colors duration-150",
                isActive(item.url)
                  ? "text-ink after:absolute after:inset-x-3 after:bottom-0 after:h-[3px] after:bg-tone"
                  : "text-ink-soft hover:text-tone",
              ]}
            >
              {item.tone && (
                <span
                  class="inline-block h-1.5 w-1.5 shrink-0 bg-tone"
                  aria-hidden="true"
                ></span>
              )}
              {item.label}
              {item.subs && (
                <svg class="ml-0.5 opacity-45" width="8" height="5" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m1 1 4 4 4-4"></path>
                </svg>
              )}
            </a>
            {item.subs && (
              <div class="invisible absolute left-1/2 top-full z-50 w-max min-w-[200px] -translate-x-1/2 border border-line border-t-[3px] border-t-tone bg-paper opacity-0 shadow-[0_18px_44px_-18px_rgba(0,0,0,0.4)] transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="py-1.5">
                  {item.subs.map((sub) => (
                    <li>
                      <a
                        href={root(sub.url)}
                        class:list={[
                          "block px-4 py-2 font-sans text-[0.72rem] font-semibold tracking-[0.07em] uppercase transition-colors duration-150 hover:bg-paper-soft hover:text-tone",
                          currentPath === sub.url ? "text-tone" : "text-ink-soft",
                        ]}
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Mobile menu -->
  <nav id="mobile-menu" hidden class="border-t border-line md:hidden" aria-label="Sections">
    <ul class="shell divide-y divide-line py-1">
      {nav.primary.map((item) => (
        <li class="py-1" data-tone={item.tone}>
          <a
            href={root(item.url)}
            class="flex items-center gap-2 py-2 font-sans text-[0.78rem] font-bold tracking-[0.12em] uppercase text-ink"
          >
            {item.tone && <span class="inline-block h-1.5 w-1.5 bg-tone" aria-hidden="true"></span>}
            {item.label}
          </a>
          {item.subs && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1 pb-2 pl-3.5">
              {item.subs.map((sub) => (
                <li>
                  <a href={root(sub.url)} class="font-sans text-[0.75rem] text-ink-soft hover:text-tone">
                    {sub.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="py-2">
        <a href={site.socialLinks.rss} class="font-sans text-[0.75rem] text-muted">RSS feed</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  :global(.masthead-compact) {
    display: none;
  }
  #site-header.is-compact :global(.masthead-full) {
    display: none;
  }
  #site-header.is-compact :global(.masthead-compact) {
    display: inline-flex;
  }
</style>

<script>
  // Shrink the masthead once the reader has committed to scrolling.
  //
  // The two thresholds are not decoration. Compacting removes ~19px from a
  // header that is still in flow, so the browser's scroll anchoring pulls the
  // page back by that much — with a single threshold it lands on the other side
  // of the line and the header flickers. The gap must stay well above 19px.
  const header = document.getElementById("site-header");
  const COMPACT_ABOVE = 160;
  const RESTORE_BELOW = 60;
  let compacted = false;
  const onScroll = () => {
    const y = window.scrollY;
    const shouldCompact = compacted ? y > RESTORE_BELOW : y > COMPACT_ABOVE;
    if (shouldCompact === compacted) return;
    compacted = shouldCompact;
    header?.classList.toggle("is-compact", compacted);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>
