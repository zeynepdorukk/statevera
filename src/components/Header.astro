---
import { nav, site } from "../site";
import { root } from "../utils/collection";
import {
  getLanguage,
  localeAlternates,
  localizePath,
  navLabel,
  siteText,
  type SiteLanguage,
} from "../i18n";
import { journalLanguage } from "../journal-i18n";
import Masthead from "./Masthead.astro";

interface Props {
  currentPath?: string;
  language?: SiteLanguage;
  alternates?: { language: SiteLanguage; path: string }[];
}

const {
  currentPath = "/",
  language = getLanguage(Astro.currentLocale),
  alternates = localeAlternates(currentPath),
} = Astro.props;
const copy = siteText[language];
const hrefFor = (url: string) => root(url === "/editor" ? url : localizePath(url, language));
const labelFor = (url: string, fallback: string, isFirstSub = false) =>
  isFirstSub && url === "/wire" ? copy.nav.allReporting : navLabel(url, language) || fallback;

const isActive = (url: string) => {
  const target = url === "/editor" ? url : localizePath(url, language);
  return target === "/" || target === "/tr" ? currentPath === target : currentPath.startsWith(target);
};
const isExternal = (url: string) => url.startsWith("http");
const isEditorLogin = (url: string) => url === "/editor";
// The desk is for the editor, not for readers: it lives as a quiet utility beside
// search rather than as the loudest button in the section row.
const readerNav = nav.primary.filter((item) => !isEditorLogin(item.url));
---

<header id="site-header" class="sticky top-0 z-40 border-b border-line bg-paper/97 backdrop-blur-sm no-print">
  <!-- Row 1: masthead · utilities -->
  <div class="shell">
    <div class="flex items-center justify-between gap-4 border-b border-line/70 py-2.5">
      <!-- Balances the utilities column so the masthead stays centred. -->
      <div class="hidden w-48 shrink-0 lg:block" aria-hidden="true"></div>

      <Masthead />

      <div class="flex w-48 shrink-0 items-center justify-end gap-1">
        <nav class="mr-1 inline-flex border border-line p-0.5" aria-label={copy.languageNav}>
          {alternates.map((alternate) => (
            <a
              href={root(alternate.path)}
              hreflang={journalLanguage[alternate.language].html}
              lang={journalLanguage[alternate.language].html}
              aria-current={alternate.language === language ? "page" : undefined}
              class:list={[
                "px-2 py-1 font-sans text-[0.62rem] font-bold uppercase transition-colors",
                alternate.language === language ? "bg-ink text-paper" : "text-muted hover:text-ink",
              ]}
            >
              {journalLanguage[alternate.language].shortLabel}
            </a>
          ))}
        </nav>
        <button
          type="button"
          data-open-search
          class="inline-flex cursor-pointer items-center gap-1.5 border-none bg-transparent p-1.5 font-sans text-[0.66rem] font-bold tracking-[0.12em] uppercase text-muted transition-colors duration-150 hover:text-ink"
          aria-label={copy.searchStatevera}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="hidden sm:inline">{copy.search}</span>
        </button>
        <a
          href={hrefFor("/editor")}
          class="hidden items-center p-1.5 text-muted transition-colors duration-150 hover:text-ink md:inline-flex"
          aria-label={copy.nav.editor}
          title={copy.nav.editor}
          rel="nofollow"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="11" width="16" height="10" rx="1.5"></rect>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
          </svg>
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex cursor-pointer items-center border-none bg-transparent p-1.5 text-ink md:hidden"
          aria-label={copy.openMenu}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Row 2: pillar navigation -->
  <nav class="site-nav-scroll hidden md:block" aria-label={copy.sections}>
    <div class="shell">
      <ul class="flex flex-wrap items-stretch justify-center">
        {readerNav.map((item) => (
          <li class="group relative">
            <a
              href={hrefFor(item.url)}
              target={isExternal(item.url) ? "_blank" : undefined}
              rel={isExternal(item.url) ? "noopener noreferrer" : undefined}
              aria-current={isActive(item.url) ? "page" : undefined}
              class:list={[
                "relative flex items-center gap-1 py-2.5 font-sans text-[0.73rem] font-bold tracking-[0.13em] whitespace-nowrap uppercase transition-colors duration-150",
                isEditorLogin(item.url)
                  ? "rounded-none border border-[#C74A4D] bg-[#C74A4D] px-5 text-white shadow-[0_4px_14px_rgba(199,74,77,0.28)] hover:border-[#db5d60] hover:bg-[#db5d60] hover:text-white"
                  : "px-4",
                !isEditorLogin(item.url) && isActive(item.url)
                  ? "text-ink after:absolute after:inset-x-3 after:bottom-0 after:h-[3px] after:bg-ink"
                  : !isEditorLogin(item.url)
                    ? "text-ink-soft hover:text-ink"
                    : "",
              ]}
            >
              {labelFor(item.url, item.label)}
              {item.subs && (
                <svg class="ml-0.5 opacity-45" width="8" height="5" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m1 1 4 4 4-4"></path>
                </svg>
              )}
            </a>
            {item.subs && (
              <div class="invisible absolute left-1/2 top-full z-50 w-max min-w-[200px] -translate-x-1/2 border border-line border-t-[3px] border-t-ink bg-paper opacity-0 shadow-[0_18px_44px_-18px_rgba(0,0,0,0.4)] transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="py-1.5">
                  {item.subs.map((sub, index) => (
                    <li>
                      <a
                        href={hrefFor(sub.url)}
                        class:list={[
                          "block px-4 py-2 font-sans text-[0.72rem] font-semibold tracking-[0.07em] uppercase transition-colors duration-150 hover:bg-paper-soft hover:text-ink",
                          currentPath === localizePath(sub.url, language) ? "text-ink" : "text-ink-soft",
                        ]}
                      >
                        {labelFor(sub.url, sub.label, index === 0)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Mobile menu -->
  <nav id="mobile-menu" hidden class="border-t border-line md:hidden" aria-label={copy.sections}>
    <ul class="shell divide-y divide-line py-1">
      {nav.primary.map((item) => (
        <li class="py-1">
          <a
            href={hrefFor(item.url)}
            target={isExternal(item.url) ? "_blank" : undefined}
            rel={isExternal(item.url) ? "noopener noreferrer" : undefined}
            aria-current={isActive(item.url) ? "page" : undefined}
            class:list={[
              "flex items-center gap-2 py-2 font-sans text-[0.78rem] font-bold tracking-[0.12em] uppercase transition-colors duration-150",
              isEditorLogin(item.url)
                ? "text-muted hover:text-ink"
                : isActive(item.url) ? "text-ink" : "text-ink-soft hover:text-ink",
            ]}
          >
            {labelFor(item.url, item.label)}
          </a>
          {item.subs && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1 pb-2 pl-3.5">
              {item.subs.map((sub, index) => (
                <li>
                  <a href={hrefFor(sub.url)} class="font-sans text-[0.75rem] text-ink-soft hover:text-tone">
                    {labelFor(sub.url, sub.label, index === 0)}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="py-2">
        <a href={hrefFor(site.socialLinks.rss)} class="font-sans text-[0.75rem] text-muted">{copy.rssFeed}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean, returnFocus = false) => {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
    // A long menu over a scrolled page: keep the page still while it is open.
    document.documentElement.classList.toggle("menu-open", open);
    if (!open && returnFocus) toggle.focus();
  };
  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  // Escape closes the menu and hands focus back to the button that opened it;
  // following a link inside it, or growing past the mobile breakpoint, closes it too.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") setOpen(false, true);
  });
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });
  matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
