---
import { site } from "../site";
import { getEditorsPick, formatDate } from "../utils/collection";

const editorsPick = await getEditorsPick();
---

<section aria-label="From the editor" class="border border-line bg-paper-soft p-5 sm:p-6">
  <div class="flex flex-col gap-5 sm:flex-row sm:gap-7">
    <div class="shrink-0">
      <img
        src={site.authorPhoto}
        alt={`Portrait of ${site.authorName}`}
        width="400"
        height="400"
        loading="lazy"
        class="h-20 w-20 rounded-full border border-line object-cover"
      />
    </div>
    <div>
      <p class="kicker">From the Editor</p>
      <p class="mt-2 max-w-2xl font-serif text-[1.02rem] leading-relaxed text-ink-soft">
        {site.authorBio}
      </p>
      {editorsPick && (
        <p class="mt-3 max-w-2xl font-serif text-[0.95rem] leading-relaxed text-ink">
          <span class="kicker-ink">Editor's pick — </span>
          <a
            href={`/articles/${editorsPick.id.replace(/\.mdx?$/, "")}`}
            class="editorial-link font-semibold"
          >
            {editorsPick.data.title}
          </a>
        </p>
      )}
      <p class="meta mt-3">
        — {site.authorName}, Editor · {formatDate(new Date())}
      </p>
    </div>
  </div>
</section>
