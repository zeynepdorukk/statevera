---
import type { Article } from "../utils/collection";
import { formatTime, formatDate, readingTime, root } from "../utils/collection";

interface Props {
  article: Article;
  showTime?: boolean;
  showImage?: boolean;
}

const { article, showTime = false } = Astro.props;
const href = root(`/articles/${article.id.replace(/\.mdx?$/, "")}`);
const rt = readingTime(article);
---

<article class="group py-3 first:pt-0">
  <div class="flex items-baseline justify-between gap-3">
    <p class="kicker">{article.data.category}</p>
    <time
      class="meta shrink-0"
      datetime={article.data.date.toISOString()}
    >
      {showTime ? formatTime(article.data.date) : formatDate(article.data.date, { day: "numeric", month: "short" })}
    </time>
  </div>
  <h3 class="mt-1 text-[0.99rem] font-medium leading-snug">
    <a href={href} class="editorial-link text-ink">
      {article.data.title}
    </a>
  </h3>
  <p class="meta mt-1">{rt} min read</p>
</article>
