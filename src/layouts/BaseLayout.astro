---
import "../styles/global.css";
import { site, type PillarId } from "../site";
import { root } from "../utils/collection";
import Header from "../components/Header.astro";
import WireTicker from "../components/WireTicker.astro";
import Footer from "../components/Footer.astro";
import SearchOverlay from "../components/SearchOverlay.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  tone?: PillarId;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
    section?: string;
  };
  noindex?: boolean;
  hideTicker?: boolean;
  path?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.publicationDescription,
  image = site.defaultOgImage,
  type = "website",
  tone,
  article,
  noindex = false,
  hideTicker = false,
  path = "/",
  jsonLd = [],
} = Astro.props;

const url = new URL(root(path), site.siteUrl);
const absoluteImage = new URL(root(image), site.siteUrl).toString();
const fullTitle = path === "/" ? site.publicationName : `${title} — ${site.publicationName}`;

const webJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.publicationName,
  alternateName: site.publicationNameDisplay,
  description: site.publicationDescription,
  url: site.siteUrl,
  inLanguage: site.language,
  publisher: {
    "@type": "Organization",
    name: site.publicationName,
    foundingDate: site.founded,
    logo: {
      "@type": "ImageObject",
      url: new URL(root("/images/branding/logo-512.png"), site.siteUrl).toString(),
    },
  },
};
---

<!doctype html>
<html lang={site.language} class="dark-scrollbar" data-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url.toString()} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preconnect" href="https://i.guim.co.uk" crossorigin />
    <link rel="preconnect" href="https://ichef.bbci.co.uk" crossorigin />

    <link rel="icon" type="image/svg+xml" href={root("/images/branding/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={root("/images/branding/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="64x64" href={root("/images/branding/favicon-64.png")} />
    <link rel="icon" href={root("/images/branding/favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={root("/images/branding/apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={`${site.publicationName} RSS`} href={root("/rss.xml")} />
    <link rel="sitemap" href={root("/sitemap-index.xml")} />

    <meta property="og:site_name" content={site.publicationName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:url" content={url.toString()} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.authors?.map((a) => <meta property="article:author" content={a} />)}
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        {article.section && <meta property="article:section" content={article.section} />}
      </>
    )}

    <script
      is:inline
      set:html={JSON.stringify([webJsonLd, ...jsonLd])}
      type="application/ld+json"
    ></script>
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideTicker && <WireTicker />}
    <Header currentPath={path} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
  </body>
</html>
