---
import "../styles/global.css";
import { site, type PillarId } from "../site";
import { absoluteUrl, root } from "../utils/collection";
import {
  journalCopy,
  journalLanguage,
  type JournalLanguage,
} from "../journal-i18n";
import Header from "../components/Header.astro";
import WireTicker from "../components/WireTicker.astro";
import Footer from "../components/Footer.astro";
import SearchOverlay from "../components/SearchOverlay.astro";

// Preloaded so the browser fetches these in parallel with the document
// instead of waiting to discover them inside global.css. Without this, a
// cold cache (a hard refresh) shows the fallback font first and visibly
// resizes text once Newsreader/Inter swap in — these are the weights that
// render above the fold.
import newsreader400 from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import newsreader700 from "@fontsource/newsreader/files/newsreader-latin-700-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter600 from "@fontsource/inter/files/inter-latin-600-normal.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  tone?: PillarId;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
    section?: string;
  };
  noindex?: boolean;
  hideTicker?: boolean;
  hideFooter?: boolean;
  path?: string;
  jsonLd?: Record<string, unknown>[];
  language?: JournalLanguage;
  alternates?: { language: JournalLanguage; path: string }[];
}

const {
  title,
  description = site.publicationDescription,
  image = site.defaultOgImage,
  type = "website",
  tone,
  article,
  noindex = false,
  hideTicker = false,
  hideFooter = false,
  path = "/",
  jsonLd = [],
  language = "en",
  alternates = [],
} = Astro.props;

// The sitemap emits directory URLs with a trailing slash, so the canonical has to
// agree with it or the two send Google different addresses for the same page.
const url = absoluteUrl(path.replace(/\/?$/, "/"));
const absoluteImage = absoluteUrl(image);
const isDefaultImage = image === site.defaultOgImage;
const fullTitle = path === "/" ? site.publicationName : `${title} — ${site.publicationName}`;
const languageMeta = journalLanguage[language];
const copy = journalCopy[language];
const localizedUrl = (localizedPath: string) => absoluteUrl(localizedPath.replace(/\/?$/, "/"));

const webJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.publicationName,
  alternateName: site.publicationNameDisplay,
  description: site.publicationDescription,
  url: site.siteUrl,
  inLanguage: languageMeta.html,
  publisher: {
    "@type": "Organization",
    name: site.publicationName,
    foundingDate: site.founded,
    logo: {
      "@type": "ImageObject",
      url: absoluteUrl("/images/branding/logo-512-v2.png"),
    },
  },
};
---

<!doctype html>
<html lang={languageMeta.html} class="dark-scrollbar" data-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={newsreader400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreader700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter700} crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url.toString()} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={journalLanguage[alternate.language].html}
        href={localizedUrl(alternate.path)}
      />
    ))}
    {alternates.some((alternate) => alternate.language === "en") && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={localizedUrl(alternates.find((alternate) => alternate.language === "en")!.path)}
      />
    )}
    {/* Without max-image-preview a news result gets a thumbnail instead of a full-width picture. */}
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />

    <link rel="preconnect" href="https://i.guim.co.uk" crossorigin />
    <link rel="preconnect" href="https://ichef.bbci.co.uk" crossorigin />

    <link rel="icon" type="image/svg+xml" sizes="any" href={root("/images/branding/favicon-v2.svg")} />
    <link rel="icon" type="image/png" sizes="16x16" href={root("/images/branding/favicon-v2-16.png")} />
    <link rel="icon" type="image/png" sizes="32x32" href={root("/images/branding/favicon-v2-32.png")} />
    <link rel="icon" type="image/png" sizes="48x48" href={root("/images/branding/favicon-v2-48.png")} />
    <link rel="icon" type="image/png" sizes="64x64" href={root("/images/branding/favicon-v2-64.png")} />
    <link rel="icon" href={root("/images/branding/favicon-v2.ico")} sizes="16x16 32x32 48x48 64x64" />
    <link rel="apple-touch-icon" sizes="180x180" href={root("/images/branding/apple-touch-icon-v2.png")} />
    <link rel="alternate" type="application/rss+xml" title={`${site.publicationName} RSS`} href={root("/rss.xml")} />
    <link rel="sitemap" href={root("/sitemap-index.xml")} />

    <meta property="og:site_name" content={site.publicationName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type === "article" ? "article" : "website"} />
    <meta property="og:url" content={url.toString()} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:alt" content={`${site.publicationName} logo`} />
    {isDefaultImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content={languageMeta.og} />
    {alternates
      .filter((alternate) => alternate.language !== language)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={journalLanguage[alternate.language].og} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={`${site.publicationName} logo`} />

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.authors?.map((a) => <meta property="article:author" content={a} />)}
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        {article.section && <meta property="article:section" content={article.section} />}
      </>
    )}

    <script
      is:inline
      set:html={JSON.stringify([webJsonLd, ...jsonLd])}
      type="application/ld+json"
    ></script>
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-link">{copy.skipToContent}</a>
    {!hideTicker && <WireTicker />}
    <Header currentPath={path} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <SearchOverlay />
  </body>
</html>
