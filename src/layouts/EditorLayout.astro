---
import "../styles/global.css";
import { site } from "../site";
import { root } from "../utils/collection";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang={site.language} class="dark-scrollbar" data-tone="journal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.publicationName}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={root("/images/branding/favicon.svg")} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("statevera-theme");
          if (stored === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper">
    <slot />
  </body>
</html>
