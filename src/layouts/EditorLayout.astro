---
import "../styles/global.css";
import { site } from "../site";
import { root } from "../utils/collection";

// See BaseLayout.astro: preloaded so a cold cache doesn't flash the fallback
// font and resize text once Newsreader/Inter swap in.
import newsreader400 from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import newsreader700 from "@fontsource/newsreader/files/newsreader-latin-700-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter600 from "@fontsource/inter/files/inter-latin-600-normal.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";

interface Props {
  title: string;
}

const { title } = Astro.props;

// The desk keeps the writer's GitHub token (and optional OpenAI key) in this
// browser's storage, so this page gets the strictest policy the site can carry:
// no inline or third-party script at all, and network access only to the
// services the desk actually calls. A stray <script> pasted into a draft, or
// any injected markup, cannot run here or send the keys anywhere by fetch.
// Production only: the dev server injects its own inline client.
const connect = [
  "'self'",
  site.siteUrl,
  site.deskUrl,
  "https://api.github.com",
  "https://api.openai.com",
  "https://en.wikipedia.org",
  "https://commons.wikimedia.org",
  "https://upload.wikimedia.org",
].filter(Boolean);
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self'",
  `connect-src ${[...new Set(connect)].join(" ")}`,
  "frame-src 'none'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join("; ");
---

<!doctype html>
<html lang={site.language} class="dark-scrollbar" data-tone="journal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" as="font" type="font/woff2" href={newsreader400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreader700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter700} crossorigin />
    <title>{title} — {site.publicationName}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={root("/images/branding/favicon-v2.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={root("/images/branding/favicon-v2-32.png")} />
    <link rel="icon" type="image/png" sizes="64x64" href={root("/images/branding/favicon-v2-64.png")} />
    <link rel="icon" href={root("/images/branding/favicon-v2.ico")} sizes="16x16 32x32 48x48 64x64" />
  </head>
  <body class="min-h-screen bg-paper">
    <slot />
  </body>
</html>
